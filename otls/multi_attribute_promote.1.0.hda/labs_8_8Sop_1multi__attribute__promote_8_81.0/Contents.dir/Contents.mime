--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/attribpromote1.spareparmdef"
Content-Type: text/plain

    parm {
        name    "inname"
        baseparm
        label   "Original Name"
        export  all
    }
    parm {
        name    "inclass"
        baseparm
        label   "Original Class"
        export  all
    }
    parm {
        name    "outclass"
        baseparm
        label   "New Class"
        export  all
    }
    parm {
        name    "usepieceattrib"
        baseparm
        label   "Use Piece Attribute"
        nolabel
        joinnext
        export  none
    }
    parm {
        name    "pieceattrib"
        baseparm
        label   "Piece Attribute"
        export  none
    }
    parm {
        name    "method"
        baseparm
        label   "Promotion Method"
        export  all
    }
    parm {
        name    "useoutname"
        baseparm
        label   "Change New Name"
        export  none
    }
    parm {
        name    "outname"
        baseparm
        label   "New Name"
        export  none
    }
    parm {
        name    "deletein"
        baseparm
        label   "Delete Original"
        export  none
    }
    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/attribpromote1.chn"
Content-Type: text/plain

{
    channel inname {
      lefttype = extend
      righttype = extend
      defaultString = \"\"
      flags = 0
      segment { length = 0 expr = "chs(\"../inname\" + detail(-1, \"ivalue\", 0))" }
    }
    channel inclass {
      lefttype = extend
      righttype = extend
      default = 2
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = "ch(\"../inclass\" + detail(-1, \"ivalue\", 0))" }
    }
    channel outclass {
      lefttype = extend
      righttype = extend
      default = 2
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = "ch(\"../outclass\" + detail(-1, \"ivalue\", 0))" }
    }
    channel usepieceattrib {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = "ch(\"../usepieceattrib\" + detail(-1, \"ivalue\", 0))" }
    }
    channel pieceattrib {
      lefttype = extend
      righttype = extend
      defaultString = \"name\"
      flags = 0
      segment { length = 0 expr = "chs(\"../pieceattrib\" + detail(-1, \"ivalue\", 0))" }
    }
    channel method {
      lefttype = extend
      righttype = extend
      default = 2
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = "ch(\"../method\" + detail(-1, \"ivalue\", 0))" }
    }
    channel useoutname {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = "ch(\"../useoutname\" + detail(-1, \"ivalue\", 0))" }
    }
    channel outname {
      lefttype = extend
      righttype = extend
      defaultString = \"\"
      flags = 0
      segment { length = 0 expr = "chs(\"../outname\" + detail(-1, \"ivalue\", 0))" }
    }
    channel deletein {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = "ch(\"../deletein\" + detail(-1, \"ivalue\", 0))" }
    }
  }

