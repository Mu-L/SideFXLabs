# Dialog script for labs::thicken::1.1 automatically generated

{
    name	labs::thicken::1.1
    script	gamedev::sop_thicken
    label	"Labs Thicken"

    help {
	""
    }
    bindhandle depth peak "Peak_Translator" dist "ownerop('polyextrude_back') owneropgroup('group')"

    inputlabel	1	"Mesh To Add Thickness To"
    inputlabel	2	"Sub-Network Input #2"
    inputlabel	3	"Sub-Network Input #3"
    inputlabel	4	"Sub-Network Input #4"

    parm {
        name    "group"
        label   "Group"
        type    string
        default { "" }
        menutoggle {
            [ "opmenu -l -a split_group group" ]
        }
        range   { 0 1 }
        parmtag { "autoscope" "0000000000000000" }
        parmtag { "script_action" "import soputils\nkwargs['geometrytype'] = kwargs['node'].parmTuple('grouptype')\nkwargs['inputindex'] = 0\nsoputils.selectGroupParm(kwargs)" }
        parmtag { "script_action_help" "Select geometry from an available viewport." }
        parmtag { "script_action_icon" "BUTTONS_reselect" }
    }
    parm {
        name    "grouptype"
        label   "Group Type"
        type    ordinal
        default { "guess" }
        menu {
            "guess"         "Guess from Group"
            "breakpoints"   "Breakpoints"
            "edges"         "Edges"
            "points"        "Points"
            "prims"         "Primitives"
        }
        range   { 0 1 }
        parmtag { "autoscope" "0000000000000000" }
    }
    parm {
        name    "negate"
        label   "Invert Selection"
        type    toggle
        default { "off" }
        range   { 0 1 }
        parmtag { "autoscope" "0000000000000000" }
    }
    groupsimple {
        name    "fd_thicken"
        label   "Thicken"

        parm {
            name    "extrusionmode"
            label   "Extrusion Mode"
            type    ordinal
            default { "pointnormal" }
            menu {
                "primnormal"    "Primitive/Edge Normal"
                "pointnormal"   "Point Normal"
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "depth"
            label   "Depth"
            type    float
            default { "0.1" }
            range   { 0 1 }
            export  all
        }
        parm {
            name    "both_directions"
            label   "Both Directions"
            type    toggle
            default { "0" }
        }
        parm {
            name    "dissolve_middle_edge"
            label   "Dissolve Middle Edge"
            type    toggle
            default { "1" }
            disablewhen "{ both_directions == 0 }"
            hidewhen "{ both_directions == 0 }"
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "reduce_back"
            label   "Reduce Back Side"
            type    toggle
            default { "0" }
        }
        parm {
            name    "reduction_percentage"
            label   "Percent To Keep"
            type    float
            default { "50" }
            disablewhen "{ reduce_back == 0 }"
            hidewhen "{ reduce_back == 0 }"
            range   { 0! 100! }
        }
    }

    groupcollapsible {
        name    "fd_normals"
        label   "Normals"

        parm {
            name    "type"
            label   "Add Normals to"
            type    ordinal
            default { "typevertex" }
            menu {
                "typepoint"     "Points"
                "typevertex"    "Vertices"
                "typeprim"      "Primitives"
                "typedetail"    "Detail"
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "cuspangle"
            label   "Cusp Angle"
            type    float
            default { "60" }
            range   { 0! 180! }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
    }

    groupcollapsible {
        name    "fd_outputgroups"
        label   "Output Groups"

        parm {
            name    "outputbackgrp"
            label   "outputbackgrp"
            type    toggle
            nolabel
            joinnext
            default { "off" }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "backgrp"
            label   "Back Group"
            type    string
            default { "thickenBack" }
            disablewhen "{ outputbackgrp == 0 }"
            menureplace {
                [ "opmenu -l -a polyextrude4 frontgrp" ]
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "outputfrontgrp"
            label   "outputfrontgrp"
            type    toggle
            nolabel
            joinnext
            default { "off" }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "frontgrp"
            label   "Front Group"
            type    string
            default { "thickenFront" }
            disablewhen "{ outputfrontgrp == 0 }"
            menureplace {
                [ "opmenu -l -a polyextrude5 frontgrp" ]
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "outputsidegrp"
            label   "outputsidegrp"
            type    toggle
            nolabel
            joinnext
            default { "off" }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sidegrp"
            label   "Side Group"
            type    string
            default { "thickenSide" }
            disablewhen "{ outputsidegrp == 0 }"
            menureplace {
                [ "opmenu -l -a polyextrude4 sidegrp" ]
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "outputbackseamgrp"
            label   "outputbackseamgrp"
            type    toggle
            nolabel
            joinnext
            default { "off" }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "backseamgrp"
            label   "Back Seam Group"
            type    string
            default { "thickenBackSeam" }
            disablewhen "{ outputbackseamgrp == 0 }"
            menureplace {
                [ "opmenu -l -a polyextrude4 frontseamgrp" ]
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "outputfrontseamgrp"
            label   "outputfrontseamgrp"
            type    toggle
            nolabel
            joinnext
            default { "off" }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "frontseamgrp"
            label   "Front Seam Group"
            type    string
            default { "thickenFrontSeam" }
            disablewhen "{ outputfrontseamgrp == 0 }"
            menureplace {
                [ "opmenu -l -a polyextrude5 frontseamgrp" ]
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "outputmiddleseamgrp"
            label   "outputmiddleseamgrp"
            type    toggle
            nolabel
            joinnext
            default { "off" }
            disablewhen "{ both_directions == 0 } { dissolve_middle_edge == 1 }"
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "middleseamgrp"
            label   "Middle Seam Group"
            type    string
            default { "thickenMiddleSeam" }
            disablewhen "{ outputmiddleseamgrp == 0 } { both_directions == 0 } { dissolve_middle_edge == 1 }"
            menureplace {
                [ "opmenu -l -a polyextrude4 backseamgrp" ]
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
    }

}
