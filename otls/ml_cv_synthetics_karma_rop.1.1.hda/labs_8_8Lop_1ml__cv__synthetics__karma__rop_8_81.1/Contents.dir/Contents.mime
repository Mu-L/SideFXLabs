            name    "rendering9"
            label   "Limits"
            invisibletab
            grouptag { "sidefx::switcher" "rendering8" }

        }

        parm {
            name    "setlayerrendersettings"
            baseparm
            label   "Set as Default Render Settings Prim"
            export  none
        }
        group {
            name    "rendering8_2"
            label   "Sampling"
            grouptag { "sidefx::switcher" "rendering8_1" }

            parm {
                name    "convergence_mode"
                baseparm
                label   "Convergence Mode"
                export  none
            }
            groupcollapsible {
                name    "__variance2"
                label   "Primary Samples"
                parmtag { "group_default" "1" }
                grouptag { "group_type" "collapsible" }
                grouptag { "sidefx::switcher" "__variance" }

                parm {
                    name    "oracle"
                    baseparm
                    label   "Pixel Oracle"
                    export  none
                }
                parm {
                    name    "oracle_minsamples"
                    baseparm
                    label   "Minimum Samples"
                    export  none
                }
                parm {
                    name    "oracle_plane"
                    baseparm
                    label   "Plane"
                    export  none
                }
                parm {
                    name    "oracle_variance"
                    baseparm
                    label   "Variance Threshold"
                    export  none
                }
                parm {
                    name    "oracle_ociomode"
                    baseparm
                    label   "OCIO Transform"
                    export  none
                }
                parm {
                    name    "oracle_ociodisplay"
                    baseparm
                    label   "Display"
                    joinnext
                    export  none
                }
                parm {
                    name    "oracle_ocioview"
                    baseparm
                    label   "View"
                    export  none
                }
                parm {
                    name    "oracle_ociocolorspace"
                    baseparm
                    label   "Color Space"
                    export  none
                }
            }

            groupcollapsible {
                name    "folder35"
                label   "Secondary Samples"
                hidewhen "{ engine == xpu }"
                parmtag { "group_default" "1" }
                grouptag { "group_type" "collapsible" }
                grouptag { "sidefx::switcher" "folder14" }

                parm {
                    name    "varianceaa_thresh"
                    baseparm
                    label   "Noise Level"
                    export  none
                }
                parm {
                    name    "guiding_enable"
                    baseparm
                    label   "Enable Indirect Guiding"
                    export  none
                }
                parm {
                    name    "guiding_samples"
                    baseparm
                    label   "Indirect Training Samples"
                    invisible
                    export  none
                }
            }

        }

        group {
            name    "rendering8_2_1"
            label   "Checkpointing"
            hidewhentab "{ engine == xpu } { force_headlight == 1 }"
            grouptag { "sidefx::switcher" "rendering8_1" }

            parm {
                name    "outputcheckpoint"
                baseparm
                label   "Output Checkpoint Files"
                export  none
            }
            parm {
                name    "productName"
                baseparm
                label   "Checkpoint File"
                export  none
            }
            parm {
                name    "savefrequency"
                baseparm
                label   "Save Frequency"
                export  none
            }
            parm {
                name    "resume"
                baseparm
                label   "Resume From Checkpoint"
                export  none
            }
        }

        group {
            name    "rendering8_2_2"
            label   "Buckets and Caching"
            hidewhentab "{ engine == xpu }"
            grouptag { "sidefx::switcher" "rendering8_1" }

            parm {
