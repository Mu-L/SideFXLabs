                baseparm
                label   "Cache Memory Ratio"
                export  none
            }
            parm {
                name    "cachesize"
                baseparm
                label   "Cache Size (MB)"
                export  none
            }
        }

        group {
            name    "rendering8_2_3"
            label   "Driver"
            grouptag { "sidefx::switcher" "rendering8_1" }

            parm {
                name    "abortmissingtexture"
