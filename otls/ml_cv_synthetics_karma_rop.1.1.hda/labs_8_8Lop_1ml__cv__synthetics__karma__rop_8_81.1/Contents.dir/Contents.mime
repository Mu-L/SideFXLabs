Content-Disposition: attachment; filename="hdaroot/backgroundplate1/materiallibrary/background/mtlxstandard_surface.chn"
Content-Type: text/plain

{
    channel metalness {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../../../metallic\") }
    }
    channel specular {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../../../reflect\") }
    }
    channel specular_roughness {
      lefttype = extend
      righttype = extend
      default = 0.20000000000000001
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../../../rough\") }
    }
    channel specular_IOR {
      lefttype = extend
      righttype = extend
      default = 1.5
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../../../ior\") }
    }
  }

