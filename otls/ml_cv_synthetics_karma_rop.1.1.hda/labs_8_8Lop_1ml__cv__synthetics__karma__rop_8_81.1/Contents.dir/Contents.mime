position 0.0538491 -5.12099
connectornextid 3
flags =  lock off model off template off footprint off xray off bypass off display off render off highlight off unload off savedata off compress on colordefault on exposed on debug off
outputsNamed3
{
0 "output1"
}
inputsNamed3
{
1 	rendergeometrysettings4 1 1 "input1"
2 	sw_Z 1 1 "input2"
}
inputs
{
0 	rendergeometrysettings4 0 1
1 	sw_Z 0 1
}
stat
{
  create -1
  modify -1
  author Synthetics_01@Synthetics-01
  access 0777
}
color UT_Color RGB 0.8 0.8 0.8 
delscript ""
exprlanguage hscript
end

