                "clamp"     "Streak"
                "decal"     "Decal"
                "mirror"    "Mirror"
            }
            parmtag { "cook_dependent" "1" }
            parmtag { "spare_category" "OpenGL" }
        }
        parm {
            name    "ogl_tex_uvtranslate#"
