--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/matnet1/grid_mat.spareparmdef"
Content-Type: text/plain

    parm {
        name    "specmodel"
        baseparm
        label   "OpenGL Specular Model"
        invisible
        export  none
    }
    parm {
        name    "coatspecmodel"
        baseparm
        label   "OpenGL Coat Specular Model"
        invisible
        export  none
    }
    parm {
        name    "specular_tint"
        baseparm
        label   "OpenGL Specular Tint"
        invisible
        export  none
    }
    multiparm {
        name    "ogl_numtex"
        label    "Diffuse Texture Layers"
        parmtag { "spare_category" "OpenGL" }

        parm {
            name    "ogl_tex#"
            label   "Texture #"
            type    image
            default { "" }
            help    "None"
            parmtag { "cook_dependent" "1" }
            parmtag { "filechooser_mode" "read" }
            parmtag { "spare_category" "OpenGL" }
        }
        parm {
            name    "ogl_texuvset#"
            label   "UV Set"
            type    string
            default { "" }
            help    "None"
            menureplace {
                "uv"    "uv"
                "uv2"   "uv2"
                "uv3"   "uv3"
                "uv4"   "uv4"
                "uv5"   "uv5"
                "uv6"   "uv6"
                "uv7"   "uv7"
                "uv8"   "uv8"
            }
            parmtag { "cook_dependent" "1" }
            parmtag { "spare_category" "OpenGL" }
        }
        parm {
            name    "ogl_tex_min_filter#"
            label   "Minification Filter"
            type    string
            default { "GL_LINEAR_MIPMAP_LINEAR" }
            help    "None"
            menu {
                "GL_NEAREST"                "No filtering (very poor)"
                "GL_LINEAR"                 "Bilinear (poor)"
                "GL_NEAREST_MIPMAP_NEAREST" "No filtering, Nearest Mipmap (poor)"
                "GL_LINEAR_MIPMAP_NEAREST"  "Bilinear, Nearest Mipmap (okay)"
                "GL_NEAREST_MIPMAP_LINEAR"  "No filtering, Blend Mipmaps (good)"
                "GL_LINEAR_MIPMAP_LINEAR"   "Trilinear (best)"
            }
            parmtag { "cook_dependent" "1" }
            parmtag { "spare_category" "OpenGL" }
        }
        parm {
            name    "ogl_tex_mag_filter#"
            label   "Magnification Filter"
            type    string
