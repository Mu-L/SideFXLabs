            menu {
                "GL_NEAREST"    "No filtering"
                "GL_LINEAR"     "Bilinear"
            }
            parmtag { "cook_dependent" "1" }
            parmtag { "spare_category" "OpenGL" }
        }
        parm {
            name    "ogl_tex_wrap#"
            label   "Texture Wrap"
            type    string
            default { "repeat" }
            help    "None"
            menu {
                "repeat"    "Repeat"
                "clamp"     "Streak"
                "decal"     "Decal"
                "mirror"    "Mirror"
            }
            parmtag { "cook_dependent" "1" }
            parmtag { "spare_category" "OpenGL" }
        }
        parm {
            name    "ogl_tex_vwrap#"
