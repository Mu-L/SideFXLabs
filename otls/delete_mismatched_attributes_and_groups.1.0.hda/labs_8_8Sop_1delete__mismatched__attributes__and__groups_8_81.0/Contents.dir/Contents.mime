--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/generate_removal_patterns_as_detail_string_attributes.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"detail"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"// Generate detail arrays to later remove attributes/groups from input 0 that:
//   - are not in the keep list
//   - do not exist on input 1


// Returns 1 if the specified attribute/group exists on input 1.
//
// The intrinsic argument should be one of:
//     pointattributes
//     vertexattributes
//     primitiveattributes
//     detailattributes
//     pointgroups
//     vertexgroups
//     primitivegroups
//     edgegroups
function int exists_on_input1(string intrinsic; string name)
{
    string items[] = detailintrinsic(1, intrinsic);
    return find(items, name) >= 0;
}


// Builds a space-separated list containing every attribute/group
// that exists on input 0 but does not exist on input 1.
function string build_missing_pattern(string intrinsic)
{
    string items0[] = detailintrinsic(0, intrinsic);
    string missing[];

    foreach (string name; items0)
    {
        if (!exists_on_input1(intrinsic, name))
            append(missing, name);
    }

    return join(missing, \" \");
}


// Removes any items in the keep list from the generated removal list.
//
// Example:
//     pattern: \"foo bar Cd\"
//     keepstr: \"Cd N\"
//     result:  \"foo bar\"
function string remove_keep_items(string pattern; int enabled; string keepstr)
{
    if (!enabled || keepstr == \"\")
        return pattern;

    string items[] = split(pattern);
    string keep[] = split(keepstr);
    string result[];

    foreach (string item; items)
    {
        if (find(keep, item) < 0)
            append(result, item);
    }

    return join(result, \" \");
}


// -----------------------------------------------------------------------------
// Attributes
// -----------------------------------------------------------------------------

if(chi(\"enabledelattributes\"))
{
    // Build removal lists for attributes that exist on input 0
    // but not on input 1.
    string ptattrs   = build_missing_pattern(\"pointattributes\");
    string vtxattrs  = build_missing_pattern(\"vertexattributes\");
    string primattrs = build_missing_pattern(\"primitiveattributes\");
    string dtlattrs  = build_missing_pattern(\"detailattributes\");
    
    // Remove user-defined keep attributes from the removal lists.
    ptattrs   = remove_keep_items(ptattrs,   chi(\"doptkeep\"),   chs(\"ptkeep\"));
    vtxattrs  = remove_keep_items(vtxattrs,  chi(\"dovtxkeep\"),  chs(\"vtxkeep\"));
    primattrs = remove_keep_items(primattrs, chi(\"doprimkeep\"), chs(\"primkeep\"));
    dtlattrs  = remove_keep_items(dtlattrs,  chi(\"dodtlkeep\"),  chs(\"dtlkeep\"));
    
    // Store final attribute removal lists as detail string attributes.
    setdetailattrib(0, \"_rma_removepointattributes\",     ptattrs,   \"set\");
    setdetailattrib(0, \"_rma_removevertexattributes\",    vtxattrs,  \"set\");
    setdetailattrib(0, \"_rma_removeprimitiveattributes\", primattrs, \"set\");
    setdetailattrib(0, \"_rma_removedetailattributes\",    dtlattrs,  \"set\");
}

// -----------------------------------------------------------------------------
// Groups
// -----------------------------------------------------------------------------
if(chi(\"enabledelgroups\"))
{
    // Build removal lists for groups that exist on input 0
    // but not on input 1.
    string ptgroups   = build_missing_pattern(\"pointgroups\");
    string vtxgroups  = build_missing_pattern(\"vertexgroups\");
    string primgroups = build_missing_pattern(\"primitivegroups\");
    string edgegroups = build_missing_pattern(\"edgegroups\");
    
    // Remove user-defined keep groups from the removal lists.
    ptgroups   = remove_keep_items(ptgroups,   chi(\"dokeepptgroups\"),   chs(\"keepptgroups\"));
    vtxgroups  = remove_keep_items(vtxgroups,  chi(\"dokeepvtxgroups\"),  chs(\"keepvtxgroups\"));
    primgroups = remove_keep_items(primgroups, chi(\"dokeepprimgroups\"), chs(\"keepprimgroups\"));
    edgegroups = remove_keep_items(edgegroups, chi(\"dokeepedgegroups\"), chs(\"keepedgegroups\"));
    
    // Store final group removal lists as detail string attributes.
    setdetailattrib(0, \"_rma_removepointgroups\",     ptgroups,   \"set\");
    setdetailattrib(0, \"_rma_removevertexgroups\",    vtxgroups,  \"set\");
    setdetailattrib(0, \"_rma_removeprimitivegroups\", primgroups, \"set\");
    setdetailattrib(0, \"_rma_removeedgegroups\",      edgegroups, \"set\");
}"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
enabledelattributes	[ 8	locks=0 ]	(	[ enabledelattributes	1 ] 	)
enabledelgroups	[ 8	locks=0 ]	(	[ enabledelgroups	1 ] 	)
fd_attrtokeep	[ 0	locks=0 ]	(	1	)
doptkeep	[ 0	locks=0 ]	(	[ doptkeep	1 ] 	)
ptkeep	[ 0	locks=0 ]	(	`chs(\"../ptkeep\")`	)
dovtxkeep	[ 8	locks=0 ]	(	[ dovtxkeep	1 ] 	)
vtxkeep	[ 0	locks=0 ]	(	`chs(\"../vtxkeep\")`	)
doprimkeep	[ 8	locks=0 ]	(	[ doprimkeep	1 ] 	)
primkeep	[ 8	locks=0 ]	(	`chs(\"../primkeep\")`	)
dodtlkeep	[ 8	locks=0 ]	(	[ dodtlkeep	1 ] 	)
dtlkeep	[ 0	locks=0 ]	(	`chs(\"../dtlkeep\")`	)
fd_groups_to_keep	[ 0	locks=0 ]	(	0	)
dokeepptgroups	[ 8	locks=0 ]	(	[ dokeepptgroups	1 ] 	)
keepptgroups	[ 0	locks=0 ]	(	`chs(\"../keepptgroups\")`	)
dokeepvtxgroups	[ 8	locks=0 ]	(	[ dokeepvtxgroups	1 ] 	)
keepvtxgroups	[ 0	locks=0 ]	(	`chs(\"../keepvtxgroups\")`	)
dokeepprimgroups	[ 8	locks=0 ]	(	[ dokeepprimgroups	1 ] 	)
keepprimgroups	[ 0	locks=0 ]	(	`chs(\"../keepprimgroups\")`	)
dokeepedgegroups	[ 8	locks=0 ]	(	[ dokeepedgegroups	1 ] 	)
keepedgegroups	[ 0	locks=0 ]	(	`chs(\"../keepedgegroups\")`	)
}

