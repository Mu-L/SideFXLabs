--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/generate_removal_patterns_as_detail_string_attributes.spareparmdef"
Content-Type: text/plain

    group {
        name    "folder1"
        label   "Code"
        grouptag { "sidefx::switcher" "folder0" }

        parm {
            name    "group"
            baseparm
            label   "Group"
            export  none
            bindselector uvselect "Modify Attribs"
                "Select the geometry to affect and press Enter to complete."
                0 1 0xffffffff 0 grouptype 0
        }
        parm {
            name    "grouptype"
            baseparm
            label   "Group Type"
            export  none
        }
        parm {
            name    "class"
            baseparm
            label   "Run Over"
            export  none
        }
        parm {
            name    "vex_numcount"
            baseparm
            label   "Number Count"
            export  none
        }
        parm {
            name    "vex_threadjobsize"
            baseparm
            label   "Thread Job Size"
            export  none
        }
        parm {
            name    "enabledelattributes"
            label   "Delete Mismatched Attributes"
            type    toggle
            default { "1" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "enabledelgroups"
            label   "Delete Mismatched Groups"
            type    toggle
            default { "1" }
            parmtag { "script_callback_language" "python" }
        }
        groupsimple {
            name    "fd_attrtokeep"
            label   "Attributes to Keep"

            parm {
                name    "doptkeep"
                label   "Point Attributes"
                type    toggle
                nolabel
                joinnext
                default { "1" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "ptkeep"
                label   "Point Attributes"
                type    string
                default { "" }
                disablewhen "{ doptkeep == 0 }"
                menutoggle {
                    [ "node = kwargs[\"node\"]" ]
                    [ "if not node:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "geo = node.inputGeometry(0)" ]
                    [ "if not geo:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "menu = []" ]
                    [ "for attrib in geo.pointAttribs():" ]
                    [ "    name = attrib.name()" ]
                    [ "    menu += [name, name]" ]
                    [ "" ]
                    [ "return menu" ]
                    language python
                }
                range   { 0 1 }
                parmtag { "autoscope" "0000000000000000" }
            }
            parm {
                name    "dovtxkeep"
                label   "Vertex Attributes"
                type    toggle
                nolabel
                joinnext
                default { "1" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "vtxkeep"
                label   "Vertex Attributes"
                type    string
                default { "" }
                disablewhen "{ dovtxkeep == 0 }"
                menutoggle {
                    [ "node = kwargs[\"node\"]" ]
                    [ "if not node:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "geo = node.inputGeometry(0)" ]
                    [ "if not geo:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "menu = []" ]
                    [ "for attrib in geo.vertexAttribs():" ]
                    [ "    name = attrib.name()" ]
                    [ "    menu += [name, name]" ]
                    [ "" ]
                    [ "return menu" ]
                    language python
                }
                range   { 0 1 }
                parmtag { "autoscope" "0000000000000000" }
            }
            parm {
                name    "doprimkeep"
                label   "Primitive Attributes"
                type    toggle
                nolabel
                joinnext
                default { "1" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "primkeep"
                label   "Primitive Attributes"
                type    string
                default { "" }
                disablewhen "{ doprimkeep == 0 }"
                menutoggle {
                    [ "node = kwargs[\"node\"]" ]
                    [ "if not node:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "geo = node.inputGeometry(0)" ]
                    [ "if not geo:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "menu = []" ]
                    [ "for attrib in geo.primAttribs():" ]
                    [ "    name = attrib.name()" ]
                    [ "    menu += [name, name]" ]
                    [ "" ]
                    [ "return menu" ]
                    language python
                }
                range   { 0 1 }
                parmtag { "autoscope" "0000000000000000" }
            }
            parm {
                name    "dodtlkeep"
                label   "Detail Attributes"
                type    toggle
                nolabel
                joinnext
                default { "1" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "dtlkeep"
                label   "Detail Attributes"
                type    string
                default { "" }
                disablewhen "{ dodtlkeep == 0 }"
                menutoggle {
                    [ "node = kwargs[\"node\"]" ]
                    [ "if not node:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "geo = node.inputGeometry(0)" ]
                    [ "if not geo:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "menu = []" ]
                    [ "for attrib in geo.globalAttribs():" ]
                    [ "    name = attrib.name()" ]
                    [ "    menu += [name, name]" ]
                    [ "" ]
                    [ "return menu" ]
                    language python
                }
                range   { 0 1 }
                parmtag { "autoscope" "0000000000000000" }
            }
        }

        groupsimple {
            name    "fd_groups_to_keep"
            label   "Groups to Keep"

            parm {
                name    "dokeepptgroups"
                label   "Point Groups"
                type    toggle
                nolabel
                joinnext
                default { "1" }
                range   { 0 1 }
            }
            parm {
                name    "keepptgroups"
                label   "Point Groups"
                type    string
                default { "" }
                disablewhen "{ dokeepptgroups == 0 }"
                menutoggle {
                    [ "node = kwargs[\"node\"]" ]
                    [ "if not node:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "geo = node.inputGeometry(0)" ]
                    [ "if not geo:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "menu = []" ]
                    [ "for group in geo.pointGroups():" ]
                    [ "    name = group.name()" ]
                    [ "    menu += [name, name]" ]
                    [ "" ]
                    [ "return menu" ]
                    language python
                }
                range   { 0 1 }
            }
            parm {
                name    "dokeepvtxgroups"
                label   "Vertex Groups"
                type    toggle
                nolabel
                joinnext
                default { "1" }
                range   { 0 1 }
            }
            parm {
                name    "keepvtxgroups"
                label   "Vertex Groups"
                type    string
                default { "" }
                disablewhen "{ dokeepvtxgroups == 0 }"
                menutoggle {
                    [ "node = kwargs[\"node\"]" ]
                    [ "if not node:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "geo = node.inputGeometry(0)" ]
                    [ "if not geo:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "menu = []" ]
                    [ "for group in geo.vertexGroups():" ]
                    [ "    name = group.name()" ]
                    [ "    menu += [name, name]" ]
                    [ "" ]
                    [ "return menu" ]
                    language python
                }
                range   { 0 1 }
            }
            parm {
                name    "dokeepprimgroups"
                label   "Primitive Groups"
                type    toggle
                nolabel
                joinnext
                default { "1" }
                range   { 0 1 }
            }
            parm {
                name    "keepprimgroups"
                label   "Primitive Groups"
                type    string
                default { "" }
                disablewhen "{ dokeepprimgroups == 0 }"
                menutoggle {
                    [ "node = kwargs[\"node\"]" ]
                    [ "if not node:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "geo = node.inputGeometry(0)" ]
                    [ "if not geo:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "menu = []" ]
                    [ "for group in geo.primGroups():" ]
                    [ "    name = group.name()" ]
                    [ "    menu += [name, name]" ]
                    [ "" ]
                    [ "return menu" ]
                    language python
                }
                range   { 0 1 }
            }
            parm {
                name    "dokeepedgegroups"
                label   "Edge Groups"
                type    toggle
                nolabel
                joinnext
                default { "1" }
                range   { 0 1 }
            }
            parm {
                name    "keepedgegroups"
                label   "Edge Groups"
                type    string
                default { "" }
                disablewhen "{ dokeepedgegroups == 0 }"
                menutoggle {
                    [ "node = kwargs[\"node\"]" ]
                    [ "if not node:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "geo = node.inputGeometry(0)" ]
                    [ "if not geo:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "menu = []" ]
                    [ "for group in geo.edgeGroups():" ]
                    [ "    name = group.name()" ]
                    [ "    menu += [name, name]" ]
                    [ "" ]
                    [ "return menu" ]
                    language python
                }
                range   { 0 1 }
            }
        }

        parm {
            name    "snippet"
            baseparm
            label   "VEXpression"
            export  all
        }
        parm {
            name    "exportlist"
            baseparm
            label   "Attributes to Create"
            export  none
        }
        parm {
            name    "vex_strict"
            baseparm
            label   "Enforce Prototypes"
            export  none
        }
        parm {
            name    "vex_strictvariables"
            baseparm
            label   "Standard Variable Names Only"
            export  none
        }
    }

    group {
        name    "folder1_1"
        label   "Bindings"

        parm {
            name    "autobind"
            baseparm
            label   "Autobind by Name"
            export  none
        }
        multiparm {
            name    "bindings"
            label    "Number of Bindings"
            baseparm
            default 0
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "multistartoffset" "1" }

            parm {
                name    "bindname#"
                baseparm
                label   "Attribute Name"
                export  none
            }
            parm {
                name    "bindparm#"
                baseparm
                label   "VEX Parameter"
                export  none
            }
        }

        parm {
            name    "groupautobind"
            baseparm
            label   "Autobind Groups by Name"
            export  none
        }
        multiparm {
            name    "groupbindings"
            label    "Group Bindings"
            baseparm
            default 0
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "multistartoffset" "1" }

            parm {
                name    "bindgroupname#"
                baseparm
                label   "Group Name"
                export  none
            }
            parm {
                name    "bindgroupparm#"
                baseparm
                label   "VEX Parameter"
                export  none
            }
        }

        parm {
            name    "vex_cwdpath"
            baseparm
            label   "Evaluation Node Path"
            export  none
        }
        parm {
            name    "vex_outputmask"
            baseparm
            label   "Export Parameters"
            export  none
        }
        parm {
            name    "vex_updatenmls"
            baseparm
            label   "Update Normals If Displaced"
            export  none
        }
        parm {
            name    "vex_matchattrib"
            baseparm
            label   "Attribute to Match"
            export  none
        }
        parm {
            name    "vex_inplace"
            baseparm
            label   "Compute Results In Place"
            export  none
        }
        parm {
            name    "vex_selectiongroup"
            baseparm
            label   "Output Selection Group"
            export  none
        }
        parm {
            name    "vex_precision"
            baseparm
            label   "VEX Precision"
            export  none
        }
    }


