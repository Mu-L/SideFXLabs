# Dialog script for labs::lot_subdivision automatically generated

{
    name	labs::lot_subdivision
    script	gamedev::sop_lot_subdivision
    label	"Labs Lot Subdivision"

    help {
	""
    }

    inputlabel	1	"2D Polygon"
    inputlabel	2	"Sub-Network Input #2"
    inputlabel	3	"Sub-Network Input #3"
    inputlabel	4	"Sub-Network Input #4"

    groupsimple {
        name    "folder1"
        label   "Base Settings"

        parm {
            name    "alignment"
            label   "Alignment"
            type    ordinal
            default { "0" }
            menu {
                "0" "Longest Edge"
                "1" "Bounding Box XZ"
            }
        }
        parm {
            name    "min_lot_size"
            label   "Minimum Lot Size"
            type    float
            default { "5" }
            range   { 0 1 }
        }
        parm {
            name    "iterations"
            label   "Iterations"
            type    integer
            default { "10" }
            range   { 1! 10 }
        }
        parm {
            name    "shape_seed"
            label   "Random Seed"
            type    float
            default { "0" }
            range   { 0 10 }
        }
    }

    groupsimple {
        name    "folder2"
        label   "Shape Settings"

        parm {
            name    "irregularity"
            label   "Irregularity"
            type    float
            default { "0.3" }
            range   { 0 1 }
        }
        parm {
            name    "vertical_bias"
            label   "Vertical Bias"
            type    float
            default { "0" }
            range   { -10 10 }
        }
        parm {
            name    "vertical_packing"
            label   "Vertical Packing"
            type    float
            default { "0" }
            range   { 1! 10 }
        }
        parm {
            name    "cluster_lots"
            label   "Cluster Lots"
            type    toggle
            joinnext
            default { "0" }
        }
        parm {
            name    "number_of_clusters"
            label   "Number of Clusters"
            type    integer
            joinnext
            default { "50" }
            disablewhen "{ cluster_lots == 0 }"
            range   { 1! 200 }
        }
        parm {
            name    "seed"
            label   "Random Seed"
            type    float
            default { "0" }
            disablewhen "{ cluster_lots == 0 }"
            range   { 0 10 }
        }
    }

}
