--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/handles_rectangle.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"float pi = 3.14159265359;
float epsilon = 1e-4;

float base = chf(\"base\");
float height = chf(\"height\");
int single_corner = chi(\"singlecorner\");
float single_radius = chf(\"singleradius\");

float circumradius, handle_x, handle_z, guide_x, guide_z, range, guide;
vector handle_pos, guide_pos, handle_center, guide_center;

float theta = 0.25 * pi;
float min_side = min(base, height) * 0.5;
vector rectangle_corner = set(base * 0.5, 0.0, height * 0.5);
vector new_origin = set(min_side, 0.0, min_side);
vector center_max = rectangle_corner - new_origin;
vector normal = rectangle_corner - center_max;
float dist = distance(rectangle_corner, center_max);

vector pt_center = lerp(rectangle_corner, center_max, single_radius);

if (single_corner == 0) // None
{
    return;
}
else if (single_corner == 1) // Round
{
    circumradius = lerp(epsilon, min_side, single_radius);
    range = dist - min_side;
    guide = min_side + range * 0.5;

    guide_center = center_max;
    handle_center = pt_center;
}
else if (single_corner == 2) // Round Inverse
{
    circumradius = lerp(epsilon, -min_side, single_radius);
    range = min_side;
    guide = -min_side * 0.5;

    guide_center = rectangle_corner;
    handle_center = rectangle_corner;
}
else if (single_corner == 3) // Straight
{
    circumradius = lerp(epsilon, -dist * 0.5, single_radius);
    range = dist * 0.5;
    guide = -dist * 0.25;

    guide_center = rectangle_corner;
    handle_center = rectangle_corner;
}
else if (single_corner == 4) // Cutout
{
    circumradius = lerp(epsilon, -dist, single_radius);
    range = dist;
    guide = -dist * 0.5;

    guide_center = rectangle_corner;
    handle_center = rectangle_corner;
}

i@index = 0;
v@N = normal;

if (@ptnum == 0) // Corner Handle
{
    handle_x = cos(theta) * circumradius;
    handle_z = sin(theta) * circumradius;
    handle_pos = handle_center + set(handle_x, 0.0, handle_z);

    i@guide_id = 0;
    v@P = handle_pos;
    f@pscale = 1.0;
    v@handle_direction = normalize(handle_pos);
}
else if (@ptnum == 1) // Corner Line Range Guide
{
    guide_x = cos(theta) * guide;
    guide_z = sin(theta) * guide;
    guide_pos = guide_center + set(guide_x, 0.0, guide_z);

    i@guide_id = 1;
    v@P = guide_pos;
    f@pscale = range;
}"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
singlecorner	[ 0	locks=0 ]	(	[ singlecorner	0 ] 	)
base	[ 0	locks=0 ]	(	[ base	1 ] 	)
height	[ 0	locks=0 ]	(	[ height	1 ] 	)
singleradius	[ 0	locks=0 ]	(	[ singleradius	0 ] 	)
}

