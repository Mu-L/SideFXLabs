Content-Type: text/plain

{
    channel base {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../base\") }
    }
    channel height {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../height\") }
    }
    channel enablesingleradius {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../matchedcorners\") }
    }
    channel singleradius {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../singleradius\") }
    }
    channel divisions {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../divisions\") }
    }
    channel singlecorner {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../singlecorner\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/shape_rounded_rectangle.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"float pi = 3.14159265359;
float epsilon = 1e-4;
float base = chf(\"base\");
float height = chf(\"height\");
int enable_single_radius = chi(\"enablesingleradius\");
int single_corner = chi(\"singlecorner\");
float single_radius = chf(\"singleradius\");
int divisions = chi(\"divisions\");

float angle, angle_start, pt_x, pt_z, circumradius;
int pt_id, multiplier;

vector pt_pos, rectangle_corner, center_max, pt_center, new_origin;
float min_side = min(base, height) * 0.5;

for (int i = 0; i < 4; i++)
{
    rectangle_corner = point(1, \"P\", i); // Calculate the center and radius of the rounded corners
    
    if (single_corner == 0) // None
    {
        pt_center = rectangle_corner;

        divisions = 1;
        pt_id = (@ptnum % divisions) + (divisions * i);
    }
    else if (single_corner == 1) // Round
    {
        new_origin = set(min_side * pow(-1, floor((i + 1) / 2)), 0.0, min_side * pow(-1, floor(i / 2)));
        center_max = rectangle_corner - new_origin;
        pt_center = lerp(rectangle_corner, center_max, single_radius);

        circumradius = lerp(epsilon, min_side, single_radius);

        // Calculate the angle increments of the points
        angle_start = 0.5 * pi * i;
        angle = ((0.5 * pi) / divisions) * float(@ptnum % (divisions + 1));
        angle += angle_start;

        pt_id = (@ptnum % (divisions + 1)) + ((divisions + 1) * i);

    }
    else if (single_corner == 2) // Round Inverse
    {
        pt_center = rectangle_corner;

        circumradius = lerp(epsilon, min_side, single_radius);

        // Calculate the angle increments of the points
        angle_start = 1.5 * pi;
        angle_start += i * 0.5 * pi;
        angle = ((0.5 * pi) / divisions) * float(@ptnum % (divisions + 1));
        angle = angle_start - angle;

        pt_id = (@ptnum % (divisions + 1)) + ((divisions + 1) * i);
    }
    else if (single_corner == 3) // Straight
    {
        new_origin = set(min_side * pow(-1, floor((i + 1) / 2)), 0.0, min_side * pow(-1, floor(i / 2)));
        center_max = rectangle_corner - new_origin;
        pt_center = lerp(rectangle_corner, center_max, single_radius);

        circumradius = lerp(epsilon, min_side, single_radius);
        
        divisions = 2; // maybe use a num_pts attribute instead of divisions to make it more procedural and dynamic

        angle_start = i * 0.5 * pi;
        angle = ((0.5 * pi) / (divisions - 1)) * (@ptnum % divisions);
        angle += angle_start;

        pt_id = (@ptnum % divisions) + (divisions * i);
    }
    else if (single_corner == 4) // Cutout
    {
        new_origin = set(min_side * pow(-1, floor((i + 1) / 2)), 0.0, min_side * pow(-1, floor(i / 2)));
        center_max = rectangle_corner - new_origin;
        pt_center = lerp(rectangle_corner, center_max, single_radius);

        divisions = 3; // maybe use a num_pts attribute instead of divisions to make it more procedural and dynamic
        pt_id = (@ptnum % divisions) + (divisions * i);
        multiplier = 1 - ((@ptnum % 3) == 1);

        circumradius = lerp(epsilon, min_side, single_radius * multiplier);

        angle_start = i * 0.5 * pi;
        angle = ((0.5 * pi) / (divisions - 1)) * (@ptnum % divisions);
        angle += angle_start;
    }

    // Calculate the position of the points
    pt_x = circumradius * cos(angle);
    pt_z = circumradius * sin(angle);
    pt_pos = pt_center + set(pt_x, 0, pt_z);

    setpointattrib(0, \"P\", pt_id, pt_pos, \"set\");
}"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
base	[ 0	locks=0 ]	(	[ base	1 ] 	)
height	[ 0	locks=0 ]	(	[ height	1 ] 	)
enablesingleradius	[ 0	locks=0 ]	(	[ enablesingleradius	0 ] 	)
singlecorner	[ 0	locks=0 ]	(	[ singlecorner	0 ] 	)
singleradius	[ 0	locks=0 ]	(	[ singleradius	0 ] 	)
divisions	[ 0	locks=0 ]	(	[ divisions	0 ] 	)
}

