Content-Type: text/plain

{
    channel radius {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../radius\") }
    }
    channel inner_radius {
      lefttype = extend
      righttype = extend
      default = 0.5
      flags = 0
      segment { length = 0 value = 0.5 0.5 expr = ch(\"../innerradius\") }
    }
    channel points {
      lefttype = extend
      righttype = extend
      default = 6
      flags = 0
      segment { length = 0 value = 6 6 expr = ch(\"../points\") }
    }
    channel outer_circle {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../outercircle\") }
    }
    channel inner_circle {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../innercircle\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/handles_star_2.1.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"float pi = 3.14159265359;
float epsilon = 1e-4;

int points = chi(\"points\");
int density = floor((points - 1) * 0.5);
float circumradius = chf(\"radius\");
float inner_radius = chf(\"inner_radius\");
float in_circle_norm = chf(\"inner_circle\"); 
float out_circle_norm = chf(\"outer_circle\");

float pt_x, pt_z, radius;
vector pt_pos;

float theta = 2.0 * pi / points;
float omega = 0.5 * theta;

float apothem = circumradius * cos(pi / points);
float side = 2.0 * circumradius * sin(pi / points);

inner_radius = lerp(epsilon, apothem, inner_radius);

float out_circle_radius_max = ( circumradius * sin(omega) ) / ( 1.0 + sin(omega) );
float in_circle_radius_max = inner_radius * sin(omega);

vector out_pt = set(circumradius - out_circle_radius_max, 0.0, circumradius - out_circle_radius_max);
vector in_pt = set(inner_radius * cos(omega), 0.0, inner_radius * sin(omega));
float distance = distance(out_pt, in_pt);

float out_circle_radius = lerp(circumradius, circumradius - out_circle_radius_max, out_circle_norm);
float radius_difference = distance - in_circle_radius_max - (circumradius - out_circle_radius);
float in_circle_radius = radius_difference < 0 ? in_circle_radius_max + radius_difference : in_circle_radius_max;

if (@ptnum == 0) // Inner Radius Handle
{
        pt_x = inner_radius * cos(theta - omega);
        pt_z = inner_radius * sin(theta - omega);
        
        i@index = 0;
        i@guide_id = 0;
        f@pscale = 1.0;
}
else if (@ptnum == 1) // Inner Radius Range Line Guide
{
        pt_x = 0.5 * apothem * cos(theta - omega);
        pt_z = 0.5 * apothem * sin(theta - omega);

        i@index = 0;
        i@guide_id = 1;
        f@pscale = apothem;
}
else if (@ptnum == 2) // Outer Circle Handle
{
        pt_x = out_circle_radius * cos(theta);
        pt_z = out_circle_radius * sin(theta);
        
        i@index = 1;
        i@guide_id = 0;
        f@pscale = 1.0;
}
else if (@ptnum == 3) // Outer Circle Range Line Guide
{
        radius = circumradius - out_circle_radius_max * 0.5;
        pt_x = radius * cos(theta);
        pt_z = radius * sin(theta);

        i@index = 1;
        i@guide_id = 1;
        f@pscale = out_circle_radius_max;
}
else if (@ptnum == 4) // Outer Circle Circle Guide
{
        radius = circumradius - out_circle_radius_max;
        pt_x = radius * cos(theta);
        pt_z = radius * sin(theta);

        i@index = 1;
        i@guide_id = 3;
        f@pscale = out_circle_radius_max;
}
else if (@ptnum == 5) // Inner Circle Handle
{
        radius = lerp(inner_radius, inner_radius - in_circle_radius, in_circle_norm);

        pt_x = radius * cos(theta + omega);
        pt_z = radius * sin(theta + omega);

        i@index = 2;
        i@guide_id = 0;
        f@pscale = 1.0;
}
else if (@ptnum == 6) // Inner Circle Range Line Guide
{
        pt_x = (inner_radius - in_circle_radius * 0.5) * cos(theta + omega);
        pt_z = (inner_radius - in_circle_radius * 0.5) * sin(theta + omega);
        
        i@index = 2;
        i@guide_id = 1;
        f@pscale = in_circle_radius;
}
else if (@ptnum == 7) // Inner Circle Circle Guide
{
        pt_x = inner_radius * cos(theta + omega);
        pt_z = inner_radius * sin(theta + omega);
        
        i@index = 2;
        i@guide_id = 3;
        f@pscale = in_circle_radius;
}

pt_pos = set(pt_x, 0.0, pt_z);
v@P = pt_pos;
v@N = pt_pos;
v@handle_direction = normalize(pt_pos);

// Inner Radius Snap Line Guides
for (int i = 2; i < density + 1; i++)
{
        float angle = ((pi / 4.0) - (0.5 * i * pi / points)) * 2.0;
        distance = (sin(angle) * pow(circumradius,2)) / (((side * 0.5) * cos(angle)) + (apothem * sin(angle)));
        pt_x = distance * cos(theta - omega);
        pt_z = distance * sin(theta - omega);
        pt_pos = set(pt_x, 0.0, pt_z);

        int pt = 6 + i;
        setpointattrib(0, \"index\", pt, 0, \"set\");
        setpointattrib(0, \"guide_id\", pt, 2, \"set\");
        setpointattrib(0, \"P\", pt, pt_pos, \"set\");
        setpointattrib(0, \"N\", pt, pt_pos, \"set\");
        setpointattrib(0, \"pscale\", pt, 1.0, \"set\");

        // Write Snap Values to an array
        float snap_point = fit(distance, 0, apothem, 0, 1);
        append(f[]@snap_values, snap_point);
}"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
points	[ 0	locks=0 ]	(	[ points	6 ] 	)
radius	[ 0	locks=0 ]	(	[ radius	1 ] 	)
inner_radius	[ 0	locks=0 ]	(	[ inner_radius	0.5 ] 	)
inner_circle	[ 0	locks=0 ]	(	[ inner_circle	0 ] 	)
outer_circle	[ 0	locks=0 ]	(	[ outer_circle	0 ] 	)
inner_divisions	[ 0	locks=0 ]	(	16	)
outer_divisions	[ 0	locks=0 ]	(	5	)
}

