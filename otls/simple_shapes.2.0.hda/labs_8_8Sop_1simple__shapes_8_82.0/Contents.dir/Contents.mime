--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/shape_square_star.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"float pi = 3.14159265359;

int sides = chi(\"sides\");
float circumradius = chf(\"radius\");
float cutout = chf(\"cutout\");

float mainpt_x, mainpt_z, cutpt_x, cutpt_z, start_angle, end_angle, angle;
vector mainpt_pos, cutpt_pos;

int main_ptnum = 3 * floor(@ptnum / 3);
int cut_ptnum = main_ptnum + 1;

float theta = 2.0 * pi / sides;
float phi = pi / sides;
float apothem = circumradius * cos(pi / sides);
float radius = lerp(circumradius, 0.0, cutout);
float height = radius * cos(phi);
float base = radius * sin(phi);
float distance = sqrt((apothem * apothem) + (radius * radius * sin(phi) * sin(phi)));

// calculate the position of main points
mainpt_x = radius * cos(theta * main_ptnum / 3);
mainpt_z = radius * sin(theta * main_ptnum / 3);
mainpt_pos = set(mainpt_x, 0.0, mainpt_z);

setpointattrib(0, \"P\", main_ptnum, mainpt_pos, \"set\");
setpointattrib(0, \"N\", main_ptnum, normalize(mainpt_pos), \"set\");

// calculate the position of side points
float omega = acos(apothem / distance);
angle = (theta * (main_ptnum / 3)) + (phi - omega);
cutpt_x = distance * cos(angle);
cutpt_z = distance * sin(angle);
cutpt_pos = set(cutpt_x, 0.0, cutpt_z);

setpointattrib(0, \"P\", cut_ptnum, cutpt_pos, \"set\");
setpointattrib(0, \"N\", cut_ptnum, normalize(cutpt_pos), \"set\");

angle = (theta * ((main_ptnum / 3) + 1)) - (phi - omega);
cutpt_x = distance * cos(angle);
cutpt_z = distance * sin(angle);
cutpt_pos = set(cutpt_x, 0.0, cutpt_z);

setpointattrib(0, \"P\", cut_ptnum + 1, cutpt_pos, \"set\");
setpointattrib(0, \"N\", cut_ptnum + 1, normalize(cutpt_pos), \"set\");"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
sides	[ 0	locks=0 ]	(	[ sides	0 ] 	)
radius	[ 0	locks=0 ]	(	[ radius	0 ] 	)
cutout	[ 0	locks=0 ]	(	[ cutout	0 ] 	)
}

