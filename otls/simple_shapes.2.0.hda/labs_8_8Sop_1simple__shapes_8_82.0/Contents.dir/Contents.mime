        name    "height"
        label   "Height"
        type    float
        default { "1" }
        range   { 0 5 }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "toppoint"
        label   "Top Point"
        type    float
        default { "0" }
        range   { 0 1 }
    }
    parm {
        name    "vex_strictvariables"
        baseparm
        label   "Standard Variable Names Only"
        export  none
    }

