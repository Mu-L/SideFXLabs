      segment { length = 0 expr = ch(\"../sides\") }
    }
    channel radius {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../radius\") }
    }
    channel cutout {
      lefttype = extend
      righttype = extend
      flags = 0
