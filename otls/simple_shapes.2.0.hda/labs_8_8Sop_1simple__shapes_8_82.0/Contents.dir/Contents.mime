--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/shape_star_circles_2.1.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"float pi = 3.14159265359;
float epsilon = 1e-4;

float circumradius = chf(\"circumradius\");
float inner_radius = chf(\"inner_radius\"); 
int points = chi(\"points\");
float in_circle_norm = chf(\"inner_circle\"); 
float out_circle_norm = chf(\"outer_circle\");
int out_segments = chi(\"outsegments\")+1;
int in_segments = chi(\"insegments\")+1;

int mod_seg, side, side_ptnum;
float angle_start, angle, radius, pt_x, pt_z, offset, angle_offset, angle_range, arc_total, arc_segment, phi;
vector center_pos, pt_pos;

float theta = 2.0 * pi / points;
float omega = 0.5 * theta;
float apothem = circumradius * cos(pi / points);

inner_radius = lerp(epsilon, apothem, inner_radius);

float out_circle_radius_max = ( circumradius * sin(omega) ) / ( 1.0 + sin(omega) );
float in_circle_radius_max = inner_radius * sin(omega);

vector out_pt_max = set(circumradius - out_circle_radius_max, 0.0, circumradius - out_circle_radius_max);
vector in_pt_max = set(inner_radius * cos(omega), 0.0, inner_radius * sin(omega));
float distance_max = distance(out_pt_max, in_pt_max);

float out_circle_distance = lerp(circumradius, circumradius - out_circle_radius_max, out_circle_norm);
float radius_difference = distance_max - in_circle_radius_max - (circumradius - out_circle_distance);
float in_circle_radius = radius_difference < 0 ? in_circle_radius_max + radius_difference : in_circle_radius_max;

in_circle_radius = lerp(epsilon, in_circle_radius, in_circle_norm);
float out_circle_radius = lerp(epsilon, out_circle_radius_max, out_circle_norm);

vector out_pt = set(circumradius - out_circle_radius, 0.0, circumradius - out_circle_radius);
vector in_pt = set(inner_radius * cos(omega), 0.0, inner_radius * sin(omega));
float distance = distance(out_pt, in_pt);

float distance_out = (distance * out_circle_radius) / (out_circle_distance + in_circle_radius);

int total_segments = out_segments + in_segments;
int switch = (@ptnum % total_segments) < out_segments ? 0 : 1; // returns 0 for out_segments and 1 for in_segments
side = (@ptnum / total_segments) * 2 + ((@ptnum % total_segments) >= out_segments);
int mod_ptnum = @ptnum % total_segments;
mod_seg = mod_ptnum < out_segments ? mod_ptnum : mod_ptnum - out_segments;
int cycle_index = @ptnum / total_segments;
int segments_num = ((@ptnum % total_segments) < out_segments) ? out_segments : in_segments;
side_ptnum = mod_seg + (segments_num * cycle_index);

center_pos = point(1, \"P\", side);

if (switch) // Inner Circle
{
    radius = in_circle_radius;

    phi = (pi * 0.5) - acos(out_circle_radius / distance_out) - asin(in_circle_radius * sin(omega) / distance_max);
    angle_offset = (omega * (side - 1)) - (0.5 * pi) + phi;
    phi = phi + (pi * 0.5) - omega;
    arc_total = phi * 2.0;
    arc_segment = arc_total / float(in_segments - 1);
    angle = angle_offset - (arc_segment * mod_seg);
}
else // Outer Circle
{
    radius = out_circle_radius;

    phi = pi - acos(out_circle_radius / distance_out) - asin(in_circle_radius * sin(omega) / distance_max);
    angle_offset = (omega * side) - phi;
    arc_total = phi * 2.0;
    arc_segment = arc_total / float(out_segments - 1);
    angle = angle_offset + (arc_segment * mod_seg);

    offset = circumradius - radius;
    center_pos *= offset;
}

pt_x = radius * cos(angle);
pt_z = radius * sin(angle);
pt_pos = center_pos + set(pt_x, 0.0, pt_z);

v@P = pt_pos;"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
points	[ 0	locks=0 ]	(	[ points	0 ] 	)
inner_circle	[ 0	locks=0 ]	(	[ inner_circle	0 ] 	)
outer_circle	[ 0	locks=0 ]	(	[ outer_circle	0 ] 	)
outsegments	[ 0	locks=0 ]	(	[ outsegments	0 ] 	)
insegments	[ 0	locks=0 ]	(	[ insegments	0 ] 	)
circumradius	[ 0	locks=0 ]	(	[ circumradius	0 ] 	)
inner_radius	[ 0	locks=0 ]	(	[ inner_radius	0 ] 	)
}

