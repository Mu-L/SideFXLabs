--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/handles_double_star.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"float pi = 3.14159265359;

int points = chi(\"points\");
int order = floor((points - 1) * 0.5);
float circumradius = chf(\"radius\");
float inner_radius = chf(\"innerradius\");
float point_radius = chf(\"pointradius\");
int index = chi(\"guideid\");

float pt_x, pt_z, radius, angle, distance, phi;
vector pt_pos;

float theta = 2.0 * pi / points;
float omega = 0.5 * theta;

f@pscale = 1.0;

if (@ptnum == 0) // Point Radius Handle
{
	radius = lerp(0.0, circumradius, point_radius);
	angle = omega;

	i@index = 1;
	i@guide_id = 0;
}
else if (@ptnum == 1) // Point Radius Range Line Guide
{
	radius = circumradius * 0.5;
	angle = omega;

	i@index = 1;
	i@guide_id = 1;
	f@pscale = circumradius;
}
else if (@ptnum == 2) // Inner Radius Handle
{
	radius = lerp(0.0, circumradius, inner_radius);
	angle = omega * 0.5;

	i@index = 0;
	i@guide_id = 0;
}
else if (@ptnum == 3) // Inner Radius Range Line Guide
{
	radius = circumradius * 0.5;
	angle = omega * 0.5;

	i@index = 0;
	i@guide_id = 1;
	f@pscale = circumradius;
}

pt_x = radius * cos(angle);
pt_z = radius * sin(angle);
pt_pos = set(pt_x, 0.0, pt_z);

v@P = pt_pos;
v@N = pt_pos;
v@handle_direction = normalize(pt_pos);

// Point Radius Snap Line Guides
for (int m = 1; m < order + 1; m++)
{
	angle = omega;
	phi = 0.5 * pi * ( 1.0 - (2.0 * (float(m) / points)) );
	distance = circumradius / ( cos(omega) + ( (sin(omega) * cos(phi)) / sin(phi) ) );
	pt_x = distance * cos(angle);
	pt_z = distance * sin(angle);
	pt_pos = set(pt_x, 0.0, pt_z);

	int pt = 3 + m;
	setpointattrib(0, \"index\", pt, 1, \"set\");
	setpointattrib(0, \"guide_id\", pt, 2, \"set\");
	setpointattrib(0, \"P\", pt, pt_pos, \"set\");
	setpointattrib(0, \"N\", pt, pt_pos, \"set\");

    // Write Snap Values to an array
    if (index == 1)
    {
    	float snap_point = fit(distance, 0, circumradius, 0, 1);
		append(f[]@snap_values, snap_point);
    }
}

// Inner Radius Snap Line Guides
for (int m = 1; m < order + 1; m++)
{
	angle = omega * 0.5;
	phi = 0.5 * pi * ( 1.0 - (2.0 * (float(m) / points)) );
	distance = circumradius / ( cos(0.5 * omega) + ( (sin(0.5 * omega) * cos(phi)) / sin(phi) ) );
	pt_x = distance * cos(angle);
	pt_z = distance * sin(angle);
	pt_pos = set(pt_x, 0.0, pt_z);

	int pt = 3 + order + m;
	setpointattrib(0, \"index\", pt, 0, \"set\");
	setpointattrib(0, \"guide_id\", pt, 2, \"set\");
	setpointattrib(0, \"P\", pt, pt_pos, \"set\");
	setpointattrib(0, \"N\", pt, pt_pos, \"set\");

    // Write Snap Values to an array
    if (index == 0)
    {
    	float snap_point = fit(distance, 0, circumradius, 0, 1);
		append(f[]@snap_values, snap_point);
    }
}"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
points	[ 0	locks=0 ]	(	[ points	0 ] 	)
radius	[ 0	locks=0 ]	(	[ radius	0 ] 	)
innerradius	[ 0	locks=0 ]	(	[ innerradius	0 ] 	)
pointradius	[ 0	locks=0 ]	(	[ pointradius	0 ] 	)
guideid	[ 0	locks=0 ]	(	[ guideid	0 ] 	)
}

