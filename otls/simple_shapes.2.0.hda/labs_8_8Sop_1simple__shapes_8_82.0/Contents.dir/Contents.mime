--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/shape_double_star.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"float pi = 3.14159265359;

int points = chi(\"points\");
float circumradius = chf(\"radius\");
float inner_radius = chf(\"innerradius\");
float point_radius = chf(\"pointradius\"); 

float inpt_x, inpt_z, outpt_x, outpt_z, midpt_x, midpt_z;
vector inpt_pos, outpt_pos, midpt_pos;

float theta = 2.0 * pi / npoints(0);
int inner_ptnum = (@ptnum * 2) + 1;
int middle_ptnum = (4 * floor(@ptnum / 4)) + 2;
int outer_ptnum = 4 * floor(@ptnum / 4);

// calculate the position of outer points
outpt_x = circumradius * cos(theta * outer_ptnum);
outpt_z = circumradius * sin(theta * outer_ptnum);
outpt_pos = set(outpt_x, 0.0, outpt_z);

// calculate the position of inner points
inpt_x = circumradius * cos(theta * inner_ptnum);
inpt_z = circumradius * sin(theta * inner_ptnum);
inpt_pos = set(lerp(0.0, inpt_x, inner_radius), 0.0, lerp(0.0, inpt_z, inner_radius));

// calculate the position of mid points
midpt_x = circumradius * cos(theta * middle_ptnum);
midpt_z = circumradius * sin(theta * middle_ptnum);
midpt_pos = set(lerp(0.0, midpt_x, point_radius), 0.0, lerp(0.0, midpt_z, point_radius));

// set point attributes
setpointattrib(0, \"P\", inner_ptnum, inpt_pos, \"set\");
setpointattrib(0, \"N\", inner_ptnum, normalize(inpt_pos), \"set\");
setpointattrib(0, \"P\", middle_ptnum, midpt_pos, \"set\");
setpointattrib(0, \"N\", middle_ptnum, normalize(midpt_pos), \"set\");
setpointattrib(0, \"P\", outer_ptnum, outpt_pos, \"set\");
setpointattrib(0, \"N\", outer_ptnum, normalize(outpt_pos), \"set\");"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
points	[ 0	locks=0 ]	(	[ points	6 ] 	)
radius	[ 0	locks=0 ]	(	[ radius	1 ] 	)
innerradius	[ 0	locks=0 ]	(	[ innerradius	0 ] 	)
pointradius	[ 0	locks=0 ]	(	[ pointradius	0 ] 	)
}

