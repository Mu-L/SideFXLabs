--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/handles_square_star.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"float pi = 3.14159265359;

int sides = chi(\"sides\");
float circumradius = chf(\"radius\");
float cutout = chf(\"cutout\");

float pt_x, pt_z, radius;
vector pt_pos, pt_norm;

float theta = 2.0 * pi / sides;
float omega = 0.5 * theta;

float snap1 = (circumradius * cos(omega)) / (sin(omega) + cos(omega));
float snap2 = (circumradius * cos(omega)) / (2.0 * sin(omega) + cos(omega));
float snap3 = (circumradius * cos(omega)) / (4.0 * sin(omega) + cos(omega));

vector normal = set(cos(omega), 0.0, sin(omega));

i@index = 0;

if (@ptnum == 0) // Cutout Handle
{
	radius = lerp(circumradius, 0.0, cutout);
	pt_x = radius * cos(theta);
	pt_z = radius * sin(theta);
	pt_norm = set(pt_x, 0.0, pt_z);

	i@guide_id = 0;
	f@pscale = 1.0;
}
else if (@ptnum == 1) // Cutout Range Line Guide
{
	radius = circumradius * 0.5;
	pt_x = radius * cos(theta);
	pt_z = radius * sin(theta);
	pt_norm = set(pt_x, 0.0, pt_z);

	i@guide_id = 1;
	f@pscale = circumradius;
}
else if (@ptnum == 2) // Cutout Snap 1 Line Guide
{
	pt_x = snap1 * cos(theta);
	pt_z = snap1 * sin(theta);
	pt_norm = set(pt_x, 0.0, pt_z);
	
	i@guide_id = 2;
	f@pscale = 1.0;
}
else if (@ptnum == 3) // Cutout Snap 1 Rectangle Guide
{
	pt_x = snap1 * cos(theta);
	pt_z = snap1 * sin(theta);
	pt_norm = normal;

	i@guide_id = 4;
	f@pscale = (circumradius - snap1) * cos(omega);
}
else if (@ptnum == 4) // Cutout Snap 2 Line Guide
{
	pt_x = snap2 * cos(theta);
	pt_z = snap2 * sin(theta);
	pt_norm = set(pt_x, 0.0, pt_z);

	i@guide_id = 2;
	f@pscale = 1.0;
}
else if (@ptnum == 5) // Cutout Snap 2 Rectangle Guide
{
	pt_x = snap2 * cos(theta);
	pt_z = snap2 * sin(theta);
	pt_norm = normal;

	i@guide_id = 5;
	f@pscale =(circumradius - snap2) * cos(omega);
}
else if (@ptnum == 6) // Cutout Snap 3 Line Guide
{
	pt_x = snap3 * cos(theta);
	pt_z = snap3 * sin(theta);
	pt_norm = set(pt_x, 0.0, pt_z);

	i@guide_id = 2;
	f@pscale = 1.0;
}
else if (@ptnum == 7) // Cutout Snap 3 Rectangle Guide
{
	pt_x = snap3 * cos(theta);
	pt_z = snap3 * sin(theta);
	pt_norm = normal;

	i@guide_id = 6;
	f@pscale = ((circumradius - snap3) * cos(omega)) * 0.5;
}

pt_pos = set(pt_x, 0.0, pt_z);
v@P = pt_pos;
v@N = pt_norm;
v@handle_direction = normalize(pt_pos);

snap1 = fit(snap1, circumradius, 0, 0, 1);
append(f[]@snap_values, snap1);	
snap2 = fit(snap2, circumradius, 0, 0, 1);
append(f[]@snap_values, snap2);
snap3 = fit(snap3, circumradius, 0, 0, 1);
append(f[]@snap_values, snap3);"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
sides	[ 0	locks=0 ]	(	[ sides	0 ] 	)
radius	[ 0	locks=0 ]	(	[ radius	0 ] 	)
cutout	[ 0	locks=0 ]	(	[ cutout	0 ] 	)
guideid	[ 0	locks=0 ]	(	[ guideid	0 ] 	)
}

