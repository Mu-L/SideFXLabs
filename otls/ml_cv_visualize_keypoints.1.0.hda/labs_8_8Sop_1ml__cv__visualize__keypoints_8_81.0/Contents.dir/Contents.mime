--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/draw_swap_connections.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"// Get the values of \"kp_name\" and \"kp_swap\" for the current point
string kp_name = point(0, \"kp_name\", @ptnum);
string kp_swap = point(0, \"kp_swap\", @ptnum);

// Check if the point's kp_name equals its kp_swap
if (kp_name == kp_swap) {
    removepoint(0, @ptnum);
} else {
    // Initialize the found point variable
    int found_point = -1;

    // Loop through all points in the geometry
    int num_points = npoints(0);
    for (int i = 0; i < num_points; i++) {
        // Skip the current point
        if (i == @ptnum) {
            continue;
        }

        // Get the value of \"kp_name\" and \"kp_swap\" for the current point in the loop
        string other_kp_name = point(0, \"kp_name\", i);
        string other_kp_swap = point(0, \"kp_swap\", i);

        // Skip if the point's \"kp_name\" equals its \"kp_swap\"
        if (other_kp_name == other_kp_swap) {
            continue;
        }

        // Check if this point's \"kp_name\" matches the original point's \"kp_swap\"
        if (other_kp_name == kp_swap) {
            found_point = i;
            break;
        }
    }

    // If a matching point is found, create a polyline between the points
    if (found_point != -1) {
        // Create a new primitive (polyline) and add the points to it
        int new_prim = addprim(0, \"polyline\");
        addvertex(0, new_prim, @ptnum);
        addvertex(0, new_prim, found_point);
    }
}
"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
}

