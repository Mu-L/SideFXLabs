--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/color_by_type.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"detail"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"// Function to generate a unique color based on an index using the golden ratio
vector generateColor(int index) {
    float golden_ratio_conjugate = 0.61803398875;
    float hue = frac(index * golden_ratio_conjugate);
    float saturation = 1; 
    float value = 1; 

    // Convert HSV to RGB
    return hsvtorgb(hue, saturation, value);
}

// Initialize an array to store kp_type values
string ky_type_values[];

// Loop through all points in the geometry
int num_points = npoints(0);
for (int i = 0; i < num_points; i++) {
    
    // Retrieve the kp_type attribute value for the current point
    string kp_type = point(0, \"kp_type\", i);

    // Check if kp_type is already in the array
    if (find(ky_type_values, kp_type) < 0) {
        // If not, add it
        append(ky_type_values, kp_type);
    }
    
    // Get the color index for this kp_type
    int color_index = find(ky_type_values, kp_type);
    
    // Retrieve the color from the colors array
    vector color = generateColor(color_index);
    
    // Assign the color to the current point
    setpointattrib(0, \"Cd\", i, color, \"set\");   
}

"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
}

