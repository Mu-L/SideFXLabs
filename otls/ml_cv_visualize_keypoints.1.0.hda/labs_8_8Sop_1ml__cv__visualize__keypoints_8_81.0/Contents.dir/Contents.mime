Content-Type: text/plain

{
    channel radius {
      lefttype = extend
      righttype = extend
      default = 0.18099999999999999
      flags = 0
      segment { length = 0 value = 0.18099999999999999 0.18099999999999999 expr = ch(\"../radius\") }
    }
  }

