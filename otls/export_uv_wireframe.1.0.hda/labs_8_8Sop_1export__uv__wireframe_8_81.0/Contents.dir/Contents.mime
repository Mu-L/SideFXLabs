Content-Disposition: attachment; filename="hdaroot/copnet1.spareparmdef"
Content-Type: text/plain

    parm {
        name    "usecoppath"
        baseparm
        label   "Use External COP"
        export  none
    }
    parm {
        name    "coppath"
        baseparm
        label   "COP Path"
        export  none
    }
    parm {
        name    "singleoutput"
        baseparm
        label   "Single Output"
        joinnext
        export  none
    }
    parm {
        name    "useinput"
        baseparm
        label   "Use COP's Input"
        export  none
    }
    parm {
        name    "output"
        baseparm
        label   "Output"
        export  none
    }
    parm {
        name    "plane"
        baseparm
        label   "Plane"
        export  none
    }
    parm {
        name    "docompile"
        baseparm
        label   "Compiled Cook"
        export  none
    }
    parm {
        name    "outputapexgraph"
        baseparm
        label   "Output APEX Graph"
        export  none
    }
    parm {
        name    "setres"
        baseparm
        label   "Set Default Resolution"
        nolabel
        joinnext
        export  none
    }
    parm {
        name    "res"
        baseparm
        label   "Default Resolution"
        joinnext
        export  none
    }
    parm {
        name    "resmenu"
        baseparm
        label   "Resolution Menu"
        export  none
    }
    parm {
        name    "setpixelscale"
        baseparm
        label   "Set Default Pixel Scale"
        nolabel
        joinnext
        export  none
    }
    parm {
        name    "pixelscale"
        baseparm
        label   "Default Pixel Scale"
        export  none
    }
    parm {
        name    "setborder"
        baseparm
        label   "Set Default Border"
        nolabel
        joinnext
        export  none
    }
    parm {
        name    "border"
        baseparm
        label   "Default Border"
        export  none
    }
    parm {
        name    "setprecision"
        baseparm
        label   "Set Default Precision"
        nolabel
        joinnext
        export  none
    }
    parm {
        name    "precision"
        baseparm
        label   "Default Precision"
        export  none
    }
    parm {
        name    "setudim"
        baseparm
        label   "Set Default UDIM"
        nolabel
        joinnext
        export  none
    }
    parm {
        name    "udim"
        baseparm
        label   "Default UDIM"
        export  none
    }
    parm {
        name    "setvistile"
        baseparm
        label   "Set Tile Visualization"
        nolabel
        joinnext
        export  none
    }
    parm {
        name    "vistile"
        baseparm
        label   "Tile Visualization"
        export  none
    }
    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/copnet1.chn"
Content-Type: text/plain

{
    channel res1 {
      lefttype = extend
      righttype = extend
      default = 1024
      flags = 0
      segment { length = 0 value = 1024 1024 expr = ch(\"../resolution1\") }
    }
    channel res2 {
      lefttype = extend
      righttype = extend
      default = 1024
      flags = 0
      segment { length = 0 value = 1024 1024 expr = ch(\"../resolution2\") }
    }
    channel udim {
      lefttype = extend
      righttype = extend
      default = 1001
      flags = 0
      segment { length = 0 expr = "if(ispdgeval(), pdgattrib(\"piecevalue\", 0), detail(-1, \"udimnum\", 0))" }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
