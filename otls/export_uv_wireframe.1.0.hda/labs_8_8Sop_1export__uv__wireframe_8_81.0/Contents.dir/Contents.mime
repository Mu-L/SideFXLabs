    channel f1 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = $FSTART }
    }
    channel f2 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = $FEND }
    }
    channel udim1 {
      lefttype = extend
      righttype = extend
      default = 1001
      flags = 0
      segment { length = 0 value = 1001 1001 expr = @piecevalue }
    }
    channel udim2 {
      lefttype = extend
      righttype = extend
      default = 1001
      flags = 0
      segment { length = 0 value = 1001 1001 expr = @piecevalue }
    }
    channel res1 {
      lefttype = extend
      righttype = extend
      default = 1024
      flags = 0
      segment { length = 0 value = 1024 1024 expr = ch(\"../../resolution1\") }
    }
    channel res2 {
      lefttype = extend
      righttype = extend
      default = 1024
      flags = 0
      segment { length = 0 value = 1024 1024 expr = ch(\"../../resolution2\") }
    }
  }

