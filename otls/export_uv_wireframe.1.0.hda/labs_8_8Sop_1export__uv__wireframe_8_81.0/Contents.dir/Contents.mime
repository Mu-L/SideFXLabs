        }
        parm {
            name    "sepparm2"
            baseparm
            label   "Separator"
            export  none
        }
        group {
            name    "folder1"
            label   "ROP Configuration"

            parm {
                name    "roporder"
                baseparm
                label   "ROP Cook Order"
                export  none
            }
            parm {
                name    "roppath"
                baseparm
                label   "ROP Path"
                export  none
            }
            parm {
                name    "usecustombutton"
                baseparm
                label   "Use Custom Execute Button"
                nolabel
                joinnext
                export  none
            }
            parm {
                name    "custombutton"
                baseparm
                label   "Execute Parm Name"
                export  none
            }
            parm {
                name    "usereloadpath"
                baseparm
                label   "Use Reload Path"
                nolabel
                joinnext
                export  none
            }
            parm {
                name    "reloadpath"
                baseparm
                label   "Reload Parm Path"
                export  none
            }
            parm {
                name    "useoppath"
                baseparm
