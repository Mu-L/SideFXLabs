--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/copnetwork.spareparmdef"
Content-Type: text/plain

    parm {
        name    "usecoppath"
        baseparm
        label   "Use External COP"
        export  none
    }
    parm {
        name    "coppath"
        baseparm
        label   "COP Path"
        export  none
    }
    groupcollapsible {
        name    "folder4"
        label   "Outputs"
        parmtag { "group_default" "1" }
        grouptag { "sidefx::switcher" "folder3" }

        parm {
            name    "singleoutput"
            baseparm
            label   "Single Output"
            joinnext
            export  none
        }
        parm {
            name    "useinput"
            baseparm
            label   "Use COP's Input"
            export  none
        }
        parm {
            name    "output"
            baseparm
            label   "Output"
            export  none
        }
        parm {
            name    "plane"
            baseparm
            label   "Post Transform"
            export  none
        }
        parm {
            name    "docompile"
            baseparm
            label   "Compiled Cook"
            export  none
        }
        parm {
            name    "outputapexgraph"
            baseparm
            label   "Output APEX Graph"
            export  none
        }
    }

    groupcollapsible {
        name    "folder5"
        label   "Resolution and Properties"
        parmtag { "group_default" "1" }
        grouptag { "sidefx::switcher" "folder0" }

        parm {
            name    "setres"
            baseparm
            label   "Set Default Resolution"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "res"
            baseparm
            label   "Default Resolution"
            joinnext
            export  none
        }
        parm {
            name    "resmenu"
            baseparm
            label   "Resolution Menu"
            export  none
        }
        parm {
            name    "setpixelscale"
            baseparm
            label   "Set Default Pixel Scale"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "pixelscale"
