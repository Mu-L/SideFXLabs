                label   "Use External Hip"
                nolabel
                joinnext
                export  none
            }
            parm {
                name    "externalhip"
                baseparm
                label   "External HIP File"
                export  none
            }
            parm {
                name    "sethip"
                baseparm
                label   "Reset $HIP On Cook"
                export  none
            }
            parm {
                name    "ignoreerrors"
                baseparm
                label   "Ignore Scene Load Errors"
                export  none
            }
            parm {
                name    "cookinputrops"
                baseparm
                label   "Cook Input ROP Nodes"
                export  none
            }
            parm {
                name    "unlocktargetrop"
                baseparm
                label   "Unlock Target ROP Node"
                export  none
            }
        }

        group {
            name    "folder1_1"
            label   "Output Files"

            parm {
                name    "outputsfrom"
                baseparm
                label   "Output Paths From"
                export  none
            }
            parm {
                name    "usefiletag"
                baseparm
                label   "Use File Tag"
                nolabel
                joinnext
                export  none
            }
            parm {
                name    "filetag"
                baseparm
                label   "Output File Tag"
                export  none
            }
            parm {
                name    "usecustomoutput"
                baseparm
