        parm {
            name    "pdg_workitemgeneration"
            baseparm
            label   "Generate When"
            export  none
        }
        parm {
            name    "pdg_cachemode"
            baseparm
            label   "Cache Mode"
            export  none
        }
        parm {
            name    "expandinputs"
            baseparm
            label   "Expand Input Files Across Frame Range"
            invisible
            export  none
        }
        parm {
            name    "enablepdgservice"
            baseparm
            label   "Use ROP Fetch Service"
            invisible
            export  none
        }
        parm {
            name    "pdg_cooktype"
            baseparm
            label   "Cook Type"
            export  none
        }
        parm {
