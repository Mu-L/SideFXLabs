--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/group_true_by_expression.chn"
Content-Type: text/plain

{
    channel vexsnippet {
      lefttype = extend
      righttype = extend
      defaultString = \"\"
      flags = 0
      segment { options = {	 autoslope  ai ao }

	 length = 0 accel = 0.33333333333333331 0.33333333333333331 expr = "groupnode = hou.pwd().node('..')
groupname = '_sbe_true'
code = []

groupexpr = groupnode.parm('singlesnippet').eval()
if len(groupexpr) != 0:
    s = '@group_%s = %s;\\n'
    code.append(s % (groupname, groupexpr))


return ''.join(code)" language = python }
    }
    channel bindclass {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../class\")+1 }
    }
    channel bindgrouptype {
      lefttype = extend
      righttype = extend
      default = 3
      flags = 0
      segment { length = 0 value = 3 3 expr = ch(\"../grouptype\") }
    }
    channel bindgroup {
      lefttype = extend
      righttype = extend
      defaultString = chs(\"../group\")
      flags = 0
      segment { length = 0 expr = chs(\"../group\") }
    }
  }

