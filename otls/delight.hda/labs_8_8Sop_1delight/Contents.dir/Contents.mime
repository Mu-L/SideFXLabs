float lum = luminance(v@Cd);
v@Cd = lerp(  lerp(v@Cd/clamp(AO+lum,0,1),point(2, \"Cd\", @ptnum),ch(\"ao_tint\")), v@Cd, lerp(1, clamp(lum + AO, 0,1), ch(\"ao_strength\"))) ;

"	)
