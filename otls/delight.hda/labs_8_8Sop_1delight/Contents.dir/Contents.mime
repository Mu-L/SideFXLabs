        baseparm
        label   "Thread Job Size"
        export  none
    }
    group {
        name    "stdswitcher3"
        label   "Vex Setup"

        parm {
            name    "vexsrc"
            baseparm
            label   "Vex Source"
            export  all
        }
        parm {
            name    "shoppath"
            baseparm
            label   "Shop Path"
            export  all
        }
        parm {
            name    "script"
            baseparm
            label   "Script"
            export  all
        }
        parm {
            name    "clear"
            baseparm
            label   "Re-load VEX Functions"
            export  all
        }
        parm {
            name    "vop_compiler"
            baseparm
            label   "Compiler"
            export  none
        }
        parm {
            name    "vop_forcecompile"
            baseparm
            label   "Force Compile"
            export  none
        }
        parm {
            name    "vex_cwdpath"
            baseparm
            label   "Evaluation Node Path"
            export  none
        }
        parm {
            name    "vex_outputmask"
            baseparm
            label   "Export Parameters"
            export  none
        }
        parm {
            name    "vex_multithread"
            baseparm
            label   "Enable Multithreading"
            export  none
        }
    }

    group {
        name    "stdswitcher3_1"
        label   "Attribute Bindings"

        parm {
            name    "autobind"
            baseparm
            label   "Autobind by Name"
            export  none
        }
        multiparm {
            name    "bindings"
            label    "Number of Bindings"
            baseparm
            default 0
            parmtag { "multistartoffset" "1" }

            parm {
                name    "bindname#"
                baseparm
                label   "Attribute Name"
                export  none
            }
            parm {
                name    "bindparm#"
                baseparm
