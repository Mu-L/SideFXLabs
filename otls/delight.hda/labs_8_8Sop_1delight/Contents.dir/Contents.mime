    parm {
        name    "bindgroup"
        baseparm
        label   "Group"
        export  none
        bindselector uvselect "Modify Points"
            "Select the points to affect and press Enter to complete."
            0 1 0xffffffff 0 bindgrouptype 0
    }
    parm {
        name    "bindgrouptype"
        baseparm
        label   "Group Type"
        export  none
