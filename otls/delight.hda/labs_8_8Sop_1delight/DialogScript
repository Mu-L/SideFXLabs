# Dialog script for labs::delight automatically generated

{
    name	labs::delight
    script	gamedev::sop_delight
    label	"Labs Delight"

    help {
	""
    }

    inputlabel	1	"Input Geo"
    inputlabel	2	"Sub-Network Input #2"
    inputlabel	3	"Sub-Network Input #3"
    inputlabel	4	"Sub-Network Input #4"

    parm {
        name    "samples"
        label   "Number of Samples"
        type    integer
        default { "50" }
        range   { 1! 1000 }
        parmtag { "autoscope" "0000000000000000" }
    }
    parm {
        name    "iterations"
        label   "Blurring Iterations"
        type    integer
        default { "30" }
        range   { 0 100 }
        parmtag { "autoscope" "0000000000000000" }
    }
    parm {
        name    "grouptype"
        label   "Group Type"
        type    ordinal
        invisible
        default { "prims" }
        menu {
            "guess"         "Guess from Group"
            "breakpoints"   "Breakpoints"
            "edges"         "Edges"
            "points"        "Points"
            "prims"         "Primitives"
        }
        parmtag { "autoscope" "0000000000000000" }
    }
    parm {
        name    "ao_brightening"
        label   "AO Brightening"
        type    toggle
        default { "0" }
    }
    parm {
        name    "ao_strength"
        label   "AO Strength"
        type    float
        default { "1" }
        disablewhen "{ ao_brightening == 0 }"
        range   { 0 10 }
    }
    parm {
        name    "ao_blend_strength"
        label   "AO Blend Strength"
        type    float
        default { "0.75" }
        disablewhen "{ ao_brightening == 0 }"
        range   { 0 10 }
    }
    parm {
        name    "ao_iterations"
        label   "AO Blurring Iterations"
        type    integer
        default { "2" }
        range   { 0 100 }
        parmtag { "autoscope" "0000000000000000" }
    }
    parm {
        name    "ao_tint"
        label   "AO Tint"
        type    float
        default { "0.75" }
        disablewhen "{ ao_brightening == 0 }"
        range   { 0 10 }
    }
    parm {
        name    "lighting_exposure"
        label   "Lighting Exposure"
        type    float
        default { "0" }
        range   { -10 10 }
    }
    parm {
        name    "lighting_saturation"
        label   "Lighting Saturation"
        type    float
        default { "1" }
        range   { 0 1 }
        parmtag { "autoscope" "0000000000000000" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "vis_lighting"
        label   "Visualize Lighting"
        type    toggle
        default { "0" }
    }
}
