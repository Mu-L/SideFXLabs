--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/find_files.chn"
Content-Type: text/plain

{
    channel filepath1 {
      lefttype = extend
      righttype = extend
      defaultString = \"$HIP/USD/HDRIhaven/*.usd\"
      flags = 0
      segment { length = 0 expr = chs(\"../filepath\") }
    }
    channel reftype1 {
      lefttype = extend
      righttype = extend
      defaultString = \"file\"
      flags = 0
      segment { length = 0 expr = chs(\"../reftype\") }
    }
    channel refeditop {
      lefttype = extend
      righttype = extend
      defaultString = \"prependfront\"
      flags = 0
      segment { length = 0 expr = chs(\"../refop\") }
    }
    channel parentprimtype {
      lefttype = extend
      righttype = extend
      defaultString = \"UsdGeomXform\"
      flags = 0
      segment { length = 0 expr = chs(\"../parentprimtype\") }
    }
  }

