Content-Type: text/plain

    parm {
        name    "querygroup"
        baseparm
        label   "Group"
        export  none
        bindselector points "Fuse Points"
            "Select the points to fuse or snap and press Enter to complete."
            0 1 0xffffffff 0 "" 0
    }
    parm {
        name    "usetargetgroup"
        baseparm
        label   "Target Group"
        nolabel
        joinnext
        export  none
    }
    parm {
        name    "targetgroup"
        baseparm
        label   "Target Group"
        export  none
    }
    parm {
        name    "modifyboth"
        baseparm
        label   "Modify Target"
        export  none
    }
    parm {
        name    "posattrib"
        baseparm
        label   "Position Attribute"
        export  none
    }
    groupsimple {
        name    "snapgroup2"
        label   "Snap"
        grouptag { "sidefx::switcher" "snapgroup" }

        parm {
            name    "snaptype"
            baseparm
            label   "Snap To"
            joinnext
            export  none
        }
        parm {
            name    "algorithm"
            baseparm
            label   "Using"
            export  none
        }
        parm {
            name    "usetol3d"
            baseparm
            label   "Use Snap Distance"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "tol3d"
            baseparm
            label   "Snap Distance"
            export  all
        }
        parm {
            name    "targetptattrib"
            baseparm
            label   "Target Points Attribute"
            export  none
        }
        parm {
            name    "targetclass"
            baseparm
            label   "Target Class"
            export  none
        }
        parm {
            name    "usepositionsnapmethod"
            baseparm
            label   "Snap Positions"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "positionsnapmethod"
            baseparm
            label   "Output Positions"
            export  none
        }
        parm {
            name    "positionsnapweightname"
            baseparm
            label   "Weight Attribute"
            export  none
        }
        parm {
            name    "useradiusattrib"
            baseparm
            label   "Radius Attribute"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "radiusattrib"
            baseparm
            label   "Radius Attribute"
            export  none
        }
        parm {
            name    "usematchattrib"
            baseparm
            label   "Match Attribute"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "matchattrib"
            baseparm
            label   "Match Attribute"
            export  none
        }
        parm {
            name    "matchtype"
            baseparm
            label   "Match Condition"
            export  none
        }
        parm {
            name    "matchtol"
            baseparm
            label   "Match Tolerance"
            export  none
        }
        parm {
            name    "gridtype"
            baseparm
            label   "Grid Type"
            export  none
        }
        parm {
            name    "gridspacing"
            baseparm
            label   "Grid Spacing"
            export  none
        }
        parm {
            name    "gridlines"
            baseparm
            label   "Grid Lines"
            export  none
        }
        parm {
            name    "gridpow2"
            baseparm
            label   "Grid Power 2"
            export  none
        }
        parm {
            name    "gridoffset"
            baseparm
            label   "Grid Offset"
            export  none
        }
        parm {
            name    "gridround"
            baseparm
            label   "Grid Rounding"
            export  none
        }
        parm {
            name    "usegridtol"
            baseparm
            label   "Use Grid Tolerance"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "gridtol"
            baseparm
            label   "Grid Tolerance"
            export  all
        }
    }

    groupsimple {
        name    "consolidategroup2"
        label   "Fuse"
        grouptag { "sidefx::switcher" "consolidategroup" }

        parm {
            name    "consolidatesnappedpoints"
            baseparm
            label   "Fuse Snapped Points"
            export  none
        }
        parm {
            name    "keepconsolidatedpoints"
            baseparm
            label   "Keep Fused Points"
            export  none
        }
        parm {
            name    "deldegen"
            baseparm
            label   "Remove Repeated Vertices and Degenerate Primitives"
            export  none
        }
        parm {
            name    "deldegenpoints"
            baseparm
            label   "Remove Unused Points from Degenerate Primitives"
            export  none
        }
        parm {
            name    "delunusedpoints"
            baseparm
            label   "Remove All Unused Points"
            export  none
        }
    }

    groupsimple {
        name    "outputgroup2"
        label   "Output Attributes and Groups"
        grouptag { "sidefx::switcher" "outputgroup" }

        parm {
            name    "recomputenml"
            baseparm
            label   "Recompute Affected Normals"
            export  none
        }
        parm {
            name    "createsnappedgroup"
            baseparm
            label   "Create Snapped Points Group"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "snappedgroupname"
            baseparm
            label   "Snapped Points Group"
            export  none
        }
        parm {
            name    "createsnappedattrib"
            baseparm
            label   "Create Snapped Destination Attribute"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "snappedattribname"
            baseparm
            label   "Snapped Destination Attribute"
            export  none
        }
        multiparm {
            name    "numpointattribs"
            label    "Attributes to Snap"
            baseparm
            default 0

            parm {
                name    "attribsnapmethod#"
                baseparm
                label   "Output Values"
                export  none
            }
            parm {
                name    "pointattribnames#"
                baseparm
                label   "Point Attributes"
                export  none
            }
            parm {
                name    "pointattribweightname#"
                baseparm
                label   "Weight Attribute"
                export  none
            }
        }

        multiparm {
            name    "numgroups"
            label    "Groups to Snap"
            baseparm
            default 0

            parm {
                name    "grouppropagation#"
                baseparm
                label   "Group Propagation"
                export  none
            }
            parm {
                name    "pointgroupnames#"
                baseparm
                label   "Point Group Names"
                export  none
            }
        }

    }

    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/fuse_all_shrubs_by_min_radius3.chn"
Content-Type: text/plain

{
    channel tol3d {
      lefttype = extend
      righttype = extend
      default = 1e-10
      flags = 0
      segment { length = 0 value = 1e-10 1e-10 expr = detail(-1,\"_bps_minshrubtolradius\",0)*2 }
    }
  }

