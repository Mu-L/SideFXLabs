snippet	[ 0	locks=0 ]	(	"
//  Blend between up vector and terrain normal based on plant 
//  stages normterrain attribute.
p@_bps_terrainorient = p@orient;
float bias = @_bps_normterrain;
vector4 blend = slerp(p@_bps_uporient, p@_bps_terrainorient, bias);
p@orient = blend;
"	)
