Content-Type: text/plain

{
    channel seed {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../seed\")*(detail(-2,\"iteration\",0)+1) }
    }
    channel density {
      lefttype = extend
      righttype = extend
      default = 0.050000000000000003
      flags = 0
      segment { length = 0 value = 0.050000000000000003 0.050000000000000003 expr = "point(-1, 0, \"_bps_density\", 0) * ch(\"../densitymultiplier\")" }
    }
    channel randomyaw {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "point(-1, 0, \"_bps_yaw\", 0)" }
    }
  }

