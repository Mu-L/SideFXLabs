snippet	[ 0	locks=0 ]	(	"
//  Group the volume primitive types to then search for 
//  an input mask.
//  Anything that is not a volume is treated like
//  geometry for the HeightField Mask by Geometry

string primtype = primintrinsic(0, \"typename\", @primnum);
