--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/create_species_viability_layers.spareparmdef"
Content-Type: text/plain

    multiparm {
        name    "numcopy"
        label    "Number of Copies"
        baseparm
        default 1

        parm {
            name    "create#"
            baseparm
            label   "Source"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "srcname#"
            baseparm
            label   "Source"
            export  none
        }
        parm {
            name    "dstname#"
            baseparm
            label   "Destination"
            export  none
        }
        parm {
            name    "copysrc#"
            baseparm
            label   "Copy Source Data"
            export  none
        }
        parm {
            name    "replacedst#"
            baseparm
            label   "Replace Existng"
            export  none
        }
    }

    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }

