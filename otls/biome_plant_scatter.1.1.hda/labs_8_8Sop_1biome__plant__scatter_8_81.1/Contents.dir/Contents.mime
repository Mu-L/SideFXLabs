{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
bindeach	[ 0	locks=0 ]	(	"off"	)
snippet	[ 0	locks=0 ]	(	"
//  Fill the temperature and precipitation HeightField
//  layers with the constant precipitation and 
//  temperature values from an existing biome

@_bps_precipitation = ch('precipitation');
@_bps_temperature = ch('temperature');
@_bps_soil = 1;
"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
