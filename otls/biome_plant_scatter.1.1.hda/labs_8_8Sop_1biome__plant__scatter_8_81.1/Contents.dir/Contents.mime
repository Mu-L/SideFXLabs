Content-Type: text/plain

    group {
        name    "folder1"
        label   "Masking"
        grouptag { "sidefx::switcher" "folder0" }

        parm {
            name    "combine"
            baseparm
            label   "Combine with Existing"
            export  none
        }
        parm {
            name    "blend"
            baseparm
            label   "Blend"
            export  none
        }
        parm {
            name    "method"
            baseparm
            label   "Method"
            export  none
        }
        parm {
            name    "maskdir"
            baseparm
            label   "Masking by Geometry"
            export  none
        }
        parm {
            name    "invertmask"
            baseparm
            label   "Invert Mask"
            export  none
        }
        parm {
            name    "maxdist"
            baseparm
            label   "Maximum Distance"
            export  none
        }
        parm {
            name    "value"
            baseparm
            label   "Value"
            export  none
        }
        parm {
            name    "blurmethod"
            baseparm
            label   "Blur Method"
            export  none
        }
        parm {
            name    "blurradius"
            baseparm
            label   "Blur Radius"
            export  none
        }
        parm {
            name    "dojitter"
            baseparm
            label   "Supersampling"
            export  none
        }
        parm {
            name    "sample"
            baseparm
            label   "Samples"
            export  none
        }
        parm {
            name    "jitter"
            baseparm
            label   "Jitter"
            export  none
        }
        parm {
            name    "jittercombine"
            baseparm
            label   "Ray Combiner"
            export  none
        }
        parm {
            name    "seed"
            baseparm
            label   "Seed"
            export  none
        }
    }

    group {
        name    "folder1_1"
        label   "Layer Bindings"

        parm {
            name    "masklayer"
            baseparm
            label   "Mask Layer"
            export  none
        }
        parm {
            name    "heightlayer"
            baseparm
            label   "Height Layer"
            export  none
        }
    }

    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }

