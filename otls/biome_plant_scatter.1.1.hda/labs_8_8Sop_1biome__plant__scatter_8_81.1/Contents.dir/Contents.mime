vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"string missinglayers[];

if(findattribval(0,\"prim\", \"name\", chs(\"tempname\")) == -1)
{
    append(missinglayers, chs(\"tempname\"));
}

if(findattribval(0,\"prim\", \"name\", chs(\"precname\")) == -1)
{
    append(missinglayers, chs(\"precname\"));
}

if(findattribval(0,\"prim\", \"name\", chs(\"soilname\")) == -1)
{
    append(missinglayers, chs(\"soilname\"));
}

if(len(missinglayers))
{
    foreach(string layer; missinglayers)
    {
        warning(\"Warning: Cannot find required HeightField Layer \\\"%s\\\"\", layer);
    }
}"	)
exportlist	[ 0	locks=0 ]	(	*	)
