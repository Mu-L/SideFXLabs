            name    "useradiusattrib"
            baseparm
            label   "Radius Attribute"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "radiusattrib"
            baseparm
            label   "Radius Attribute"
            export  none
        }
        parm {
            name    "usematchattrib"
            baseparm
            label   "Match Attribute"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "matchattrib"
            baseparm
            label   "Match Attribute"
            export  none
        }
        parm {
            name    "matchtype"
            baseparm
            label   "Match Condition"
            export  none
        }
        parm {
            name    "matchtol"
            baseparm
            label   "Match Tolerance"
            export  none
        }
        parm {
            name    "gridtype"
            baseparm
            label   "Grid Type"
            export  none
        }
        parm {
            name    "gridspacing"
            baseparm
            label   "Grid Spacing"
            export  none
        }
        parm {
            name    "gridlines"
            baseparm
            label   "Grid Lines"
            export  none
        }
        parm {
            name    "gridpow2"
            baseparm
            label   "Grid Power 2"
            export  none
        }
        parm {
            name    "gridoffset"
            baseparm
            label   "Grid Offset"
            export  none
        }
        parm {
            name    "gridround"
            baseparm
            label   "Grid Rounding"
            export  none
        }
        parm {
            name    "usegridtol"
            baseparm
            label   "Use Grid Tolerance"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "gridtol"
            baseparm
            label   "Grid Tolerance"
            export  all
        }
    }

    groupsimple {
        name    "consolidategroup2"
        label   "Fuse"
        grouptag { "sidefx::switcher" "consolidategroup" }

        parm {
            name    "consolidatesnappedpoints"
            baseparm
            label   "Fuse Snapped Points"
            export  none
        }
        parm {
            name    "keepconsolidatedpoints"
            baseparm
            label   "Keep Fused Points"
            export  none
        }
        parm {
            name    "deldegen"
            baseparm
            label   "Remove Repeated Vertices and Degenerate Primitives"
            export  none
        }
        parm {
            name    "deldegenpoints"
            baseparm
            label   "Remove Unused Points from Degenerate Primitives"
            export  none
        }
        parm {
            name    "delunusedpoints"
            baseparm
            label   "Remove All Unused Points"
            export  none
        }
    }

    groupsimple {
        name    "outputgroup2"
        label   "Output Attributes and Groups"
        grouptag { "sidefx::switcher" "outputgroup" }

        parm {
            name    "recomputenml"
            baseparm
            label   "Recompute Affected Normals"
            export  none
        }
        parm {
            name    "createsnappedgroup"
            baseparm
            label   "Create Snapped Points Group"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "snappedgroupname"
            baseparm
            label   "Snapped Points Group"
            export  none
        }
        parm {
            name    "createsnappedattrib"
            baseparm
            label   "Create Snapped Destination Attribute"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "snappedattribname"
            baseparm
            label   "Snapped Destination Attribute"
            export  none
        }
        multiparm {
            name    "numpointattribs"
            label    "Attributes to Snap"
            baseparm
            default 0

            parm {
                name    "attribsnapmethod#"
                baseparm
                label   "Output Values"
                export  none
            }
            parm {
                name    "pointattribnames#"
                baseparm
                label   "Point Attributes"
                export  none
            }
            parm {
                name    "pointattribweightname#"
                baseparm
                label   "Weight Attribute"
                export  none
            }
        }

        multiparm {
            name    "numgroups"
            label    "Groups to Snap"
            baseparm
            default 0

            parm {
                name    "grouppropagation#"
                baseparm
                label   "Group Propagation"
                export  none
            }
            parm {
                name    "pointgroupnames#"
                baseparm
                label   "Point Group Names"
                export  none
            }
        }

    }

    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }

