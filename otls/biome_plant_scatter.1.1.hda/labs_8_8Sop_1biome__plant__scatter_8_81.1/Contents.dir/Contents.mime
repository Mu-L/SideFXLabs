        parm {
            name    "updatetinting"
            baseparm
            label   "Update Tinting"
            export  none
        }
        parm {
            name    "heightvolume"
            baseparm
            label   "Height Layer"
            export  none
        }
        parm {
            name    "cdvolume"
            baseparm
            label   "Color Layer"
            export  none
        }
        parm {
            name    "computerange"
            baseparm
            label   "Compute Range"
            export  none
        }
        parm {
            name    "cdrangeoverride"
            baseparm
            label   "Diffuse Range"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "cdrange"
            baseparm
            label   "Diffuse Range"
            export  none
        }
        parm {
            name    "cdrampmode"
            baseparm
            label   "Mode"
            joinnext
            export  none
        }
        parm {
            name    "cdpreset"
            baseparm
            label   "Diffuse"
            export  none
        }
        parm {
            name    "cdramp"
            baseparm
            label   "Diffuse Ramp"
