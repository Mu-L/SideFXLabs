import toolutils
import hou, os

launch_fo = toolutils.createModuleFromSection("launch_fo", kwargs["type"], "launch_fo")

def launch_fo(dataset_path):
    node = hou.node("./Launch_FiftyOne/launch_fiftyone")    
    paths_node = hou.node("./Launch_FiftyOne/create_paths")
    paths_node.dirtyWorkItems(False)
    paths_node.parm("stringvalue2").set(dataset_path)
    node.dirtyWorkItems(False)
    node.cookWorkItems(False, False, False, False)   
   
def select_ds(kwargs):
    parent = kwargs['node']
    delivery_dir = parent.parm('deliverydir').eval()
    render_dir = parent.parm('renderdir').eval()
    
    if(os.path.exists(delivery_dir)):
        base_dir = delivery_dir
    elif(os.path.exists(render_dir)):
        base_dir = render_dir
    
    dataset_path = hou.ui.selectFile(start_directory=base_dir, title='Select Dataset Directory', file_type=hou.fileType.Directory) 
    launch_fo(dataset_path)
    
def cur_ds(kwargs):
    parent = kwargs['node']
    ds_major = parent.parm('dsversionmajor').eval()
    ds_minor = parent.parm('dsversionminor').eval()
    delivery_dir = parent.parm('deliverydir').eval()
    render_dir = parent.parm('renderdir').eval()
    
    if(os.path.exists(delivery_dir)):
        base_dir = delivery_dir
    elif(os.path.exists(render_dir)):
        base_dir = render_dir
    else:
        missing_ds = command = r'Dataset {}.{} does not exist yet.'.format(ds_major, ds_minor)
        hou.ui.displayConfirmation(missing_ds, severity=hou.severityType.Warning, title="Dataset Missing")
        
    dataset_path = base_dir + 'ds' + str(ds_major) + '.' + str(ds_minor) + '/'
    
    if(os.path.exists(dataset_path)):
        launch_fo(dataset_path)
    else:
        missing_ds = command = r'Dataset {}.{} does not exist yet.'.format(ds_major, ds_minor)
        hou.ui.displayConfirmation(missing_ds, severity=hou.severityType.Warning, title="Dataset Missing")
        
def sel_distro_ds(kwargs):
    parent = kwargs['node']
    base_dir = parent.parm('deliverydir').eval()
    dataset_path = hou.ui.selectFile(start_directory=base_dir, title='Select Dataset Directory', file_type=hou.fileType.Directory) 
    category_filter = parent.parm('filtercat').eval()
    category_filter_name = parent.parm('catname').eval()
    
    if category_filter == 0 or category_filter_name == '':
        category_filter_name = ''
    
    ##get all the params from annotation multiparm
    attrmultiparm = parent.parm('synthattrs')
    attrinstances = attrmultiparm.multiParmInstances()
    
    ##Get all user specified attrs
    attrs = []
    for x in attrinstances:
        attrs.append(x.eval()) 
    attrs = str(attrs)
    
    node = hou.node("./visualize_distributions/visualize_distributions")    
    paths_node = hou.node("./visualize_distributions/create_paths")
    paths_node.dirtyWorkItems(False)
    
    ##create attributes
    paths_node.parm("stringvalue1").set(dataset_path)
    paths_node.parm("stringvalue2").set(attrs)
    paths_node.parm("stringvalue3").set(category_filter_name)
    
    ##dirty and cook
    node.dirtyWorkItems(False)
    node.cookWorkItems(False, False, False, False)   
    
def custom_per_variant(kwargs):
    network_editor = hou.ui.paneTabOfType(hou.paneTabType.NetworkEditor)
    node = kwargs["node"].node("custom_per_variant/output0")

    if network_editor and node:
        network_editor.setCurrentNode(node, pick_node=True)
        
