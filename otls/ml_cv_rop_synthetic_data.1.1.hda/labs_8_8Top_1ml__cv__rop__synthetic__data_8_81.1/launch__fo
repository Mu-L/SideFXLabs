import hou, os

def launch_fo(parent, dataset_path):

    # get command parameters
    fiftyone_launcher = parent.parm('fiftyone_launcher').eval()
    use_desktop = parent.parm('desktop51')

    # generate command
    if(use_desktop):
        viewer = '-d'
    else:
        viewer =''
    
    # Create command for fiftyone shell
    command = r'python "{}" -dd "{}" {}'.format(fiftyone_launcher, dataset_path, viewer)
    
    # send command to command prompt
    if hou.ui.displayConfirmation("Launching FiftyOne will hault Houdini until the cmd shell is closed.", severity=hou.severityType.Warning, title="Launch FiftyOne"):
        os.system('start /wait cmd /c {}'.format(command))
    
def select_ds(kwargs):
    parent = kwargs['node']
    base_dir = parent.parm('base_dir').eval()
    dataset_path = hou.ui.selectFile(start_directory=base_dir, title='Select Dataset Directory', file_type=hou.fileType.Directory) 
    launch_fo(parent, dataset_path)
    
def cur_ds(kwargs):
    parent = kwargs['node']
    base_dir = parent.parm('base_dir').eval()
    ds_major = parent.parm('dsversionmajor').eval()
    ds_minor = parent.parm('dsversionminor').eval()
    dataset_path = base_dir + 'ds' + str(ds_major) + '.' + str(ds_minor) + '/'
    
    if(os.path.exists(dataset_path)):
        launch_fo(parent, dataset_path)
    else:
        missing_ds = command = r'Dataset {}.{} does not exist yet.'.format(ds_major, ds_minor)
        hou.ui.displayConfirmation(missing_ds, severity=hou.severityType.Warning, title="Dataset Missing")
