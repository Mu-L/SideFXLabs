      default = 20
      flags = 0
      segment { length = 0 value = 20 20 expr = ch(\"../maxiter\") }
    }
    channel phase {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../phase\") }
    }
