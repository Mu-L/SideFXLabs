{
    channel method {
      lefttype = extend
      righttype = extend
      default = 3
      flags = 0
      segment { length = 0 value = 3 3 expr = ch(\"../method\") }
    }
    channel fuse_distance {
      lefttype = extend
      righttype = extend
      default = 0.01
      flags = 0
      segment { length = 0 value = 0.01 0.01 expr = ch(\"../fuse_distance\") }
    }
    channel num_points {
      lefttype = extend
      righttype = extend
      default = 25
      flags = 0
      segment { length = 0 value = 25 25 expr = ch(\"../num_points\") }
    }
    channel convex_multiplier {
      lefttype = extend
      righttype = extend
      default = 0.10000000000000001
      flags = 0
      segment { length = 0 value = 0.10000000000000001 0.10000000000000001 expr = ch(\"../convex_multiplier\") }
    }
    channel occlusion_multiplier {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../occlusion_multiplier\") }
    }
    channel num_clusters {
      lefttype = extend
      righttype = extend
      default = 30
      flags = 0
      segment { length = 0 value = 30 30 expr = ch(\"../num_clusters\") }
    }
    channel normal_blur_cluster {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../normal_blur_cluster\") }
    }
    channel random_seed {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../random_seed\") }
    }
    channel blur_amount {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../blur_amount\") }
    }
    channel nplanes {
      lefttype = extend
      righttype = extend
      default = 2
      flags = 0
      segment { length = 0 value = 2 2 expr = ch(\"../nplanes\") }
    }
    channel small_island_cutoff {
      lefttype = extend
      righttype = extend
      default = 0.01
      flags = 0
      segment { length = 0 value = 0.01 0.01 expr = ch(\"../small_island_cutoff\") }
    }
    channel method2 {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../method2\") }
    }
    channel orientation_mode {
      lefttype = extend
      righttype = extend
      default = 2
      flags = 0
      segment { length = 0 value = 2 2 expr = ch(\"../orientation_mode\") }
    }
    channel packing_iterations {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../packing_iterations\") }
    }
    channel layout_padding {
      lefttype = extend
      righttype = extend
      default = 2
      flags = 0
      segment { length = 0 value = 2 2 expr = ch(\"../layout_padding\") }
    }
    channel resolution {
      lefttype = extend
      righttype = extend
      default = 2
      flags = 0
      segment { length = 0 value = 2 2 expr = ch(\"../resolution2\") }
    }
    channel graintol {
      lefttype = extend
      righttype = extend
      default = 0.12
      flags = 0
      segment { length = 0 value = 0.12 0.12 expr = ch(\"../graintol\") }
    }
    channel mergethreshold {
      lefttype = extend
      righttype = extend
      default = 0.5
      flags = 0
