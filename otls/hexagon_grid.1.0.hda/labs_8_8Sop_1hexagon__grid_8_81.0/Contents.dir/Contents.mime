vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"int layout_mode = chi(\"layout_mode\");
float tile_size = chf(\"tile_size\");
int orientation = chi(\"orientation\");
vector4 layout;
vector4 pointy = set(sqrt(3), sqrt(3) * 0.5, 0.0, 1.5);
vector4 flat = set(1.5, 0.0, sqrt(3) / 2.0, sqrt(3));

if (layout_mode == 0)
{
    layout = pointy;
}
else if (layout_mode == 1)
{
    layout = flat;
}

v@_hex_coordinates = set(@_hex_q, @_hex_r, @_hex_s);

float axis1 = (layout.x * @_hex_q + layout.y * @_hex_r) * tile_size;
float axis2 = (layout.z * @_hex_q + layout.w * @_hex_r) * tile_size;

if (orientation == 0)
{
    @P = set(axis1, axis2, 0);
}
else if (orientation == 1)
{
    @P = set(0, axis2, -axis1);
}
else if (orientation == 2)
{
    @P = set(axis1, 0, -axis2);
}"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
layout_mode	[ 8	locks=0 ]	(	[ layout_mode	0 ] 	)
tile_size	[ 0	locks=0 ]	(	[ tile_size	1 ] 	)
orientation	[ 8	locks=0 ]	(	[ orientation	2 ] 	)
}

