--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/rectangle.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"detail"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"int tile_orientation = chi(\"tileorientation\");
int qmin = chi(\"qmin\");
int qmax = chi(\"qmax\");
int rmin = chi(\"rmin\");
int rmax = chi(\"rmax\");
int ptnum = 0;

if (tile_orientation == 0)
{
    for (int r = rmin; r <= rmax; r++)
    {   
        int r_offset = floor(r / 2.0); // or r >> 1
        
        for (int q = qmin - r_offset; q <= qmax - r_offset; q++)
        {
            addpoint(0, ptnum);
            
            setpointattrib(0, \"_hex_q\", ptnum, q, \"set\");
            setpointattrib(0, \"_hex_r\", ptnum, r, \"set\");
            setpointattrib(0, \"_hex_s\", ptnum, -q-r, \"set\");

            ptnum++;
        }
    }
}
else if (tile_orientation == 1)
{
    for (int q = qmin; q <= qmax; q++)
    {   
        int q_offset = floor(q / 2.0); // or r >> 1
        
        for (int r = rmin - q_offset; r <= rmax - q_offset; r++)
        {
            addpoint(0, ptnum);
            
            setpointattrib(0, \"_hex_q\", ptnum, q, \"set\");
            setpointattrib(0, \"_hex_r\", ptnum, r, \"set\");
            setpointattrib(0, \"_hex_s\", ptnum, -q-r, \"set\");

            ptnum++;
        }
    }
}"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
tileorientation	[ 8	locks=0 ]	(	[ tileorientation	0 ] 	)
fd_rectangle	[ 0	locks=0 ]	(	0	)
qmin	[ 0	locks=0 ]	(	[ qmin	0 ] 	)
qmax	[ 0	locks=0 ]	(	[ qmax	0 ] 	)
rmin	[ 0	locks=0 ]	(	[ rmin	0 ] 	)
rmax	[ 0	locks=0 ]	(	[ rmax	3 ] 	)
}

