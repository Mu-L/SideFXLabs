Content-Disposition: attachment; filename="hdaroot/grid_gen.chn"
Content-Type: text/plain

{
    channel tile_size {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../cellradius\") }
    }
    channel layout_mode {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../cellorientation\") }
    }
    channel orientation {
      lefttype = extend
      righttype = extend
      default = 2
      flags = 0
      segment { length = 0 value = 2 2 expr = ch(\"../orientation\") }
    }
