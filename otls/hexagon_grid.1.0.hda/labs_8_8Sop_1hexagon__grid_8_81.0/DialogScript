            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "gridshape"
            label   "Shape"
            type    ordinal
            invisible
            default { "0" }
            menu {
                "0" "Hexagon"
                "1" "Triangle"
                "2" "Rectangle"
                "3" "Parallelogram"
            }
            range   { 0 10 }
        }
        groupsimple {
            name    "fd_shapehexagon"
            label   "Hexagon Shape"
            hidewhen "{ gridshape > 1 }"
            grouptag { "sidefx::look" "blank" }

            parm {
                name    "gridsize"
                label   "Size"
                type    integer
                default { "2" }
                range   { 0! 10 }
            }
        }

        groupsimple {
            name    "fd_shaperectangle"
            label   "Rectangle Shape"
            hidewhen "{ gridshape != 2 }"
            grouptag { "sidefx::look" "blank" }

            parm {
                name    "qmin"
                label   "Q Min"
                type    integer
                default { "-5" }
                range   { -10 10 }
            }
            parm {
                name    "qmax"
                label   "Q Max"
                type    integer
                default { "5" }
                range   { -10 10 }
            }
            parm {
                name    "rmin"
                label   "R Min"
                type    integer
                default { "-5" }
                range   { -10 10 }
            }
            parm {
                name    "rmax"
                label   "R Max"
                type    integer
                default { "5" }
                range   { -10 10 }
            }
        }

        groupsimple {
            name    "fd_shapeparallelogram"
            label   "Parallelogram Shape"
            hidewhen "{ gridshape != 3 }"
            grouptag { "sidefx::look" "blank" }

            parm {
                name    "axes"
                label   "Axes"
                type    ordinal
                default { "0" }
                menu {
                    "0" "QR"
                    "1" "SQ"
                    "2" "RS"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "axis1min"
                label   "Axis 1 Min"
                type    integer
                default { "-5" }
                range   { -10 10 }
                parmtag { "script_callback_language" "python" }
