            baseparm
            label   "Output Selection Group"
            export  none
        }
        parm {
            name    "vex_precision"
            baseparm
            label   "VEX Precision"
            export  none
        }
    }

    parm {
        name    "vex_strictvariables"
        baseparm
        label   "Standard Variable Names Only"
        export  none
    }

