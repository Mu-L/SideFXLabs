--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/get_raw_string_for_relative_file_path2.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"int numvariations;
dict abs;
d[]@numvariations;
if(isvalidindex(d@plant_definition, \"variants\"))
{
    d[]@numvariations = d@plant_definition[\"variants\"];
}
i@numvars = len(@numvariations);
//for(int i = 0; i < len(@numvariations)
//printf('%s', @numvariations[0]);

string meshvariant;
string meshdeadvariant;
string unrealassetpath;
string unrealassetdeadpath;
float agemin, agemax, deadratio, scalemin, scalemax, weight;
int reftype;

for (int i = 0; i < len(@numvariations); i++)
{
    dict current_def = @numvariations[i];
    d@current_def = current_def;
    if(isvalidindex(d@current_def, \"meshvariant#\"))
    {
        meshvariant = d@current_def[\"meshvariant#\"];
        d@plant_definition['meshvariant'+itoa(i+1)] = meshvariant;
    }
    if(isvalidindex(d@current_def, \"meshdeadvariant#\"))
    {
        meshdeadvariant = d@current_def[\"meshdeadvariant#\"];
        d@plant_definition['meshdeadvariant'+itoa(i+1)] = meshdeadvariant;
    }
    if(isvalidindex(d@current_def, \"filemeshvariant#\"))
    {
        d@plant_definition[\"filemeshvariant\"+itoa(i+1)] = chsraw(\"../filemeshvariant\"+itoa(i+1)); 
    }
    if(isvalidindex(d@current_def, \"filemeshdeadvariant#\"))
    {
        d@plant_definition[\"filemeshdeadvariant\"+itoa(i+1)] = chsraw(\"../filemeshdeadvariant\"+itoa(i+1)); 
    }
    if(isvalidindex(d@current_def, \"filemeshdeadvariant#\"))
    {
        d@plant_definition[\"filemeshdeadvariant\"+itoa(i+1)] = chsraw(\"../filemeshdeadvariant\"+itoa(i+1)); 
    }
    if(isvalidindex(d@current_def, \"agemin#\"))
    {
        agemin = d@current_def[\"agemin#\"];
        d@plant_definition['agemin'+itoa(i+1)] = agemin;
    }
    if(isvalidindex(d@current_def, \"agemax#\"))
    {
        agemax = d@current_def[\"agemax#\"];
        d@plant_definition['agemax'+itoa(i+1)] = agemax;
    }
    if(isvalidindex(d@current_def, \"deadratio#\"))
    {
        deadratio = d@current_def[\"deadratio#\"];
        d@plant_definition['deadratio'+itoa(i+1)] = deadratio;
    }
    if(isvalidindex(d@current_def, \"scalemin#\"))
    {
        scalemin = d@current_def[\"scalemin#\"];
        d@plant_definition['scalemin'+itoa(i+1)] = scalemin;
    }
    if(isvalidindex(d@current_def, \"scalemax#\"))
    {
        scalemax = d@current_def[\"scalemax#\"];
        d@plant_definition['scalemax'+itoa(i+1)] = scalemax;
    }
    if(isvalidindex(d@current_def, \"unrealassetpath#\"))
    {
        unrealassetpath = d@current_def[\"unrealassetpath#\"];
        d@plant_definition['unrealassetpath'+itoa(i+1)] = unrealassetpath;
    }
    if(isvalidindex(d@current_def, \"unrealassetdeadpath#\"))
    {
        unrealassetdeadpath = d@current_def[\"unrealassetdeadpath#\"];
        d@plant_definition['unrealassetdeadpath'+itoa(i+1)] = unrealassetdeadpath;
    }
    if(isvalidindex(d@current_def, \"weight#\"))
    {
        weight = d@current_def[\"weight#\"];
        d@plant_definition['weight'+itoa(i+1)] = weight;
    }
    if(isvalidindex(d@current_def, \"reftype#\"))
    {
        reftype = d@current_def[\"reftype#\"];
        d@plant_definition['reftype'+itoa(i+1)] = reftype;
    }
    //printf('%s', @numvariations[i]);
     
    //d@plant_definition[\"filemeshdeadvariant\"+itoa(i)] = chsraw(\"../filemeshdeadvariant\"+itoa(i));
    abs = set(\"absfilemeshvariant\"+itoa(i+1), chs(\"../filemeshvariant\"+itoa(i+1)), \"absfilemeshdeadvariant\"+itoa(i+1), chs(\"../filemeshdeadvariant\"+itoa(i+1)));
    insert(d@plant_definition, abs);
    
   
}

 d@plant_definition[\"variants\"] = len(@numvariations);"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
}

