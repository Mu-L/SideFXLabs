--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/circlefromedges2.spareparmdef"
Content-Type: text/plain

    parm {
        name    "group"
        baseparm
        label   "Group"
        export  none
        bindselector prims_points_edges Group
            "Select the edges to transform into a circle."
            0 1 0xffffffff 0 grouptype 0
    }
    parm {
        name    "grouptype"
        baseparm
        label   "Group Type"
        export  none
    }
    parm {
        name    "getboundary"
        baseparm
        label   "Consider only Group Boundary"
        export  none
    }
    parm {
        name    "explicitradius"
        baseparm
        label   "explicitradius"
        nolabel
        joinnext
        export  all
    }
    parm {
        name    "radius"
        baseparm
        label   "Radius"
        export  all
    }
    parm {
        name    "scale"
        baseparm
        label   "Scale"
        export  all
    }
    parm {
        name    "outputedgegroup"
        baseparm
        label   "Output Edge Group"
        export  none
    }
    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/circlefromedges2.chn"
Content-Type: text/plain

{
    channel radius {
      lefttype = extend
      righttype = extend
      default = 0.5
      flags = 0
      segment { length = 0 value = 0.5 0.5 expr = "detail(-1, \"_cho_maxlength\", 0)" }
    }
  }

