Content-Disposition: attachment; filename="hdaroot/validate_packed_sequence.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"detail"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"int count = nprimitives(0);
if (count < 2)
{
    error(\"Copy Points requires a source packed primitive followed by at least one packed target.\");
    return;
}
for (int prim_number = 0; prim_number < count; ++prim_number)
{
    if (!startswith(primintrinsic(0, \"typename\", prim_number), \"Packed\"))
    {
        error(\"Copy Points accepts packed primitives only.\");
        return;
    }
}
setdetailattrib(0, \"container_count\", count, \"set\");
"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
