if (!chi("../inherit_rotation"))
{
    if (haspointattrib(0, "orient")) removeattrib(0, "point", "orient");
    if (haspointattrib(0, "N")) removeattrib(0, "point", "N");
    if (haspointattrib(0, "up")) removeattrib(0, "point", "up");
    if (haspointattrib(0, "rot")) removeattrib(0, "point", "rot");
}
if (!chi("../inherit_scale"))
{
    if (haspointattrib(0, "scale")) removeattrib(0, "point", "scale");
    if (haspointattrib(0, "pscale")) removeattrib(0, "point", "pscale");
}
