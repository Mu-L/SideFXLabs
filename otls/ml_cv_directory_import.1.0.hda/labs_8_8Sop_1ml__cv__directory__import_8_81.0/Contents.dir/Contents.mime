    parm {
        name    "python"
        baseparm
        label   "Python Code"
        export  none
    }
    parm {
        name    "import"
        label   "Import Path"
        type    directory
        default { "" }
    }
    parm {
        name    "File_Pattern"
        label   "File Pattern"
        type    string
        default { "" }
    }
    parm {
        name    "maintainstate"
        baseparm
        label   "Maintain State"
        export  none
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/directory_search.parm"
Content-Type: text/plain

{
version 0.8
python	[ 0	locks=0 ]	(	"node = hou.pwd()
geo = node.geometry()

import os
import fnmatch

# Fetch parameter values
paths = node.parm(\"import\").eval()
pathlist = paths.split(\",\")
file_pattern = node.parm(\"File_Pattern\").eval()

# Initialize the file list
filelist = []

# If paths is not empty, proceed with file searching
if paths != \"\":
    for path in pathlist:
        for root, dirs, files in os.walk(path):
            for file in files:
                if fnmatch.fnmatch(file, file_pattern):
                    fullpath = os.path.join(root, file)
                    # Adjust paths if necessary
                    # fullpath = \"'\" + fullpath + \"'\"
                    # fullpath = fullpath.replace(\"\\\\\", \"/\")
                    filelist.append(fullpath)

# Convert filelist to a suitable format for Houdini attribute
filelist_str = \" \".join(filelist)

# Add and set global attribute 'filelist'
geo.addAttrib(hou.attribType.Global, \"filelist\", [\"\"], False)
geo.setGlobalAttribValue(\"filelist\", filelist)

# Add and set global attribute 'numfiles'
geo.addAttrib(hou.attribType.Global, \"numfiles\", 0, False)
geo.setGlobalAttribValue(\"numfiles\", len(filelist)) "	)
maintainstate	[ 0	locks=0 ]	(	"off"	)
import	[ 0	locks=0 ]	(	`chs(\"../dir\")`	)
File_Pattern	[ 0	locks=0 ]	(	`chs(\"../filepattern\")`	)
}

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
