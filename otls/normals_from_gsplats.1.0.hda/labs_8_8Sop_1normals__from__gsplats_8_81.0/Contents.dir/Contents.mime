Content-Disposition: attachment; filename="hdaroot/particlefluidsurface1.chn"
Content-Type: text/plain

{
    channel doerode {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"dodilate\") }
    }
    channel erodeoffset {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"dilateoffset\") }
    }
    channel erodemask {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"dilatemask\") }
    }
    channel particlesep {
      lefttype = extend
      righttype = extend
      default = 0.10000000000000001
      flags = 0
      segment { length = 0 value = 0.10000000000000001 0.10000000000000001 expr = "if(ch(\"../overwritesurfaceseparation\"), ch(\"../surfaceseparation\"), ch(\"../pointsfromvolume1/particlesep\")*2)" }
    }
    channel voxelsize {
      lefttype = extend
      righttype = extend
      default = 0.75
      flags = 0
      segment { length = 0 value = 0.75 0.75 expr = ch(\"../voxelscale\") }
    }
  }

