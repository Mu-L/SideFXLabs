--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/attribwrangle2.chn"
Content-Type: text/plain

{
    channel search_radius {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../searchradius\") }
    }
    channel smooth_amount {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../smoothamount\") }
    }
    channel sharpen_amount {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../sharpenamount\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/attribwrangle2.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"vector N = v@N;
vector P = @P;
float radius = ch(\"search_radius\");
float smooth = ch(\"smooth_amount\");
float sharpen = ch(\"sharpen_amount\");

if (radius > 0)
{
    int pc[] = pcfind(0, \"P\", @P, radius, 100);
    
    if (len(pc) > 0)
    {
        int i;
        
        vector avg = 0;
        float total_w = 0;
        
        for (i = 0; i < len(pc); i++)
        {
            int neighbor = pc[i];
            vector nbP = point(0, \"P\", neighbor);
            vector nbN = normalize(point(0, \"N\", neighbor));
            float d = length(P - nbP);
            
            float w = exp(-d * d / (2 * radius * radius));
            float dot = abs(dot(N, nbN));
            w *= (0.5 + 0.5 * dot);
            
            avg += w * nbN;
            total_w += w;
        }
        
        if (total_w > 0)
        {
            avg = avg / total_w;
        }
        
        N = lerp(N, normalize(avg), smooth);
        
        if (sharpen > 0 && total_w > 0)
        {
            vector diff = normalize(N) - normalize(avg);
            N = normalize(N + diff * sharpen);
        }
    }
}

v@N = normalize(N);"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
search_radius	[ 0	locks=0 ]	(	[ search_radius	0 ] 	)
smooth_amount	[ 0	locks=0 ]	(	[ smooth_amount	0 ] 	)
sharpen_amount	[ 0	locks=0 ]	(	[ sharpen_amount	0 ] 	)
}

