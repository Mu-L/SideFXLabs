--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/cylinder_generation.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"// Declaration of Variables
int enable_uniform_radius = chi(\"enableuniformradius\");
int open_cylinder = chi(\"opencylinder\");
float uniform_radius = chf(\"uniformradius\");
float base_radius = chf(\"baseradius\");
float top_radius = chf(\"topradius\");
float sides = chf(\"sides\");
float divisions = chf(\"divisions\");
float arc_start = radians(chf(\"arcstart\"));
float arc_end = radians(chf(\"arcend\"));

int direction = chi(\"direction\");

float height = chf(\"height\");
int enable_ramp = chi(\"enableramp\");
float ramp_multiplier = chf(\"rampmultiplier\");

float pi = 3.14159265359;
float x, y, z, angle, radius, ramp_vposition;
vector pos;

if (enable_uniform_radius)
{
    base_radius = uniform_radius;
    top_radius = uniform_radius;
}

float dif_radius = top_radius - base_radius;

float sides_counter = @ptnum % (sides + 1);
float segments_counter = (int)(@ptnum / (@numpt / (divisions + 1)));

// Shape Generation
radius = base_radius + ((dif_radius / divisions) * segments_counter);

if (open_cylinder)
{
    angle = (((arc_end - arc_start)) / sides * sides_counter) - arc_end;
} else {
    angle = (2 * pi / sides * sides_counter);
}

ramp_vposition = fit(segments_counter, 0, divisions, 0.0, 1.0);
        
// Position
if (enable_ramp) {
    radius += (chramp(\"../curveramp\", ramp_vposition) * ramp_multiplier);
}

x = cos(angle) * radius;
y = fit(segments_counter, 0, divisions, -height * 0.5, height * 0.5);
z = sin(angle) * radius;

if (direction == 0) {
    pos = set(y, x, -z);
} else if (direction == 1) {
    pos = set(x, y, z);
} else {
    pos = set(-x, z,y);
}

@P = pos;"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
baseradius	[ 0	locks=0 ]	(	[ baseradius	0 ] 	)
topradius	[ 0	locks=0 ]	(	[ topradius	1 ] 	)
enableuniformradius	[ 0	locks=0 ]	(	[ enableuniformradius	0 ] 	)
