    }
    channel enable2 {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = "ch(\"../creategroupcaps\")==1 && ch(\"../opencylinder\")==0 && ch(\"../endcaps\")==1" }
    }
  }

