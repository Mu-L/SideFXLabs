                    parmtag { "autoscope" "0000000000000000" }
                    parmtag { "spare_category" "Image" }
                    parmtag { "uiscope" "None" }
                    parmtag { "usdvaluetype" "string" }
                }
                parm {
                    name    "diffusecomponents"
                    label   "Diffuse Components"
                    type    string
                    default { "diffuse" }
                    help    "A space-separated list of component types that will behave like diffuse bounces. This will affect which reflection scope is used based on the ray type and also which bounce limit to use. Uncategorized component types are assumed to be reflections."
                    parmtag { "autoscope" "0000000000000000" }
                    parmtag { "spare_category" "Image" }
                    parmtag { "uiscope" "None" }
                    parmtag { "usdvaluetype" "string" }
                }
                parm {
                    name    "refractcomponents"
                    label   "Refract Components"
                    type    string
                    default { "refract" }
                    help    "A space-separated list of component types that will behave like refract bounces. This will affect which reflection scope is used based on the ray type and also which bounce limit to use. Uncategorized component types are assumed to be reflections."
                    parmtag { "autoscope" "0000000000000000" }
                    parmtag { "spare_category" "Image" }
                    parmtag { "uiscope" "None" }
                    parmtag { "usdvaluetype" "string" }
                }
                parm {
                    name    "volumecomponents"
                    label   "Volume Components"
                    type    string
                    default { "volume" }
                    help    "A space-separated list of component types that will behave like volume bounces. This will affect which reflection scope is used based on the ray type and also which bounce limit to use. Uncategorized component types are assumed to be reflections."
                    parmtag { "autoscope" "0000000000000000" }
                    parmtag { "spare_category" "Image" }
                    parmtag { "uiscope" "None" }
                    parmtag { "usdvaluetype" "string" }
                }
                parm {
                    name    "ssscomponents"
                    label   "SSS Components"
                    type    string
                    default { "sss" }
                    help    "A space-separated list of component types that will behave like subsurface scatter bounces. This will affect which reflection scope is used based on the ray type and also which bounce limit to use. Uncategorized component types are assumed to be reflections."
                    parmtag { "autoscope" "0000000000000000" }
                    parmtag { "spare_category" "Image" }
                    parmtag { "uiscope" "None" }
                    parmtag { "usdvaluetype" "string" }
                }
            }

        }

    }

    group {
        name    "fd_rendersettings_1"
        label   "Render ROP"

        parm {
            name    "execute"
            label   "Render to Disk"
            type    button
            joinnext
            default { "0" }
            help    "Renders with the last render control settings. This blocks Houdini until the render completes."
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "takecontrol" "always" }
        }
        parm {
            name    "renderpreview"
            label   "Render to MPlay"
            type    button
            joinnext
            default { "0" }
            help    "Render directly into an MPlay preview window, instead of to an image file. (You can save the image to disk from inside MPlay.)"
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "takecontrol" "always" }
        }
        parm {
            name    "executebackground"
            label   "Render to Disk in Background"
            type    button
            joinnext
            default { "0" }
            help    "Renders with the last render control settings in a background process."
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "takecontrol" "always" }
        }
        parm {
            name    "renderdialog"
            label   "Controls..."
            type    button
            nolabel
            default { "0" }
            help    "Click to open a dialog that lets you launch a “one-off” render with different frame range and dependency settings."
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "takecontrol" "always" }
        }
        parm {
            name    "trange"
            label   "Valid Frame Range"
            type    ordinal
            default { "off" }
            menu {
                "off"       "Render Current Frame"
                "normal"    "Render Specific Frame Range"
                "on"        "Render Specific Frame Range Only (Strict)"
                "stage"     "Render Frame Range From Stage"
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "f"
            label   "Start/End/Inc"
            type    float
            size    3
            default { [ "@frame_index" hscript-expr ] [ "@frame_index" hscript-expr ] "1" }
            help    "When Valid frame range is “Render frame range” or “Render frame range (strict)”, the start and end frames (inclusive) and interval."
            range   { 0 10 }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "foffset"
            label   "Preroll/Postroll/Inc"
            type    float
            size    3
            default { "0" "0" "1" }
            help    "When Valid frame range is “Render stage’s frame range”, the number of frames before and after the stage’s official start and end frame to save, and the interval between time samples."
            range   { 0 10 }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "allframesatonce"
            label   "Render All Frames With a Single Process"
            type    toggle
            default { "off" }
            help    "Render all frames in a background process. Default is off. This allows continued interaction with Houdini while the render process runs."
            disablewhen "{ trange == off }"
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "override_camera"
            label   "Override Camera"
            type    string
            default { "" }
            help    "Scene graph path to the Camera prim to render from. If this is blank, the node uses the camera specified on the render settings primitive."
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_action" "import loputils\nloputils.selectPrimsInParm(kwargs, False)" }
            parmtag { "script_action_help" "Select a primitive in the Scene Viewer or Scene Graph Tree pane.\nCtrl-click to select using the primitive picker dialog.\nAlt-click to toggle movement of the display flag." }
            parmtag { "script_action_icon" "BUTTONS_reselect" }
            parmtag { "sidefx::usdpathtype" "prim" }
        }
        parm {
            name    "outputimage"
            label   "Override Output Image"
            type    image
            default { "`ifs(ch(\"enableid\"),chs(\"picture_id\"),chs(\"picture_rgb\"))`" }
            help    "If this is not blank, render to this file path instead of the output specified in the RenderSettings prim. When starting a new render process for each frame, this parameter can use standard Houdini variables such as $F4 to specify unique per-frame image files. When Render All Frames With a Single Process is enabled, this parameter must pass an un-expanded frame specifier (such as $F4 or <FF>) to husk. This may require the use of a backslash to prevent variable expansion when evaluating the parameter."
            menureplace {
                [ "opmenu -l -a usdrender_rop outputimage" ]
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
    }

    group {
        name    "fd_rendersettings_2"
        label   "Background Plate"

        parm {
            name    "primpattern"
            label   "Primitives"
            type    string
            default { "" }
            help    "A space-separated list of prim paths for the objects you want to act as hold-outs. "
            menutoggle {
                [ "opmenu -l -a backgroundplate primpattern" ]
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_action" "import loputils\nloputils.selectPrimsInParm(kwargs, True)" }
            parmtag { "script_action_help" "Select primitives in the Scene Viewer or Scene Graph Tree pane.\nCtrl-click to select using the primitive picker dialog.\nShift-click to select using the primitive pattern editor.\nAlt-click to toggle movement of the display flag." }
            parmtag { "script_action_icon" "BUTTONS_reselect" }
            parmtag { "sidefx::usdpathtype" "primlist" }
        }
        parm {
            name    "spacer"
            label   "Spacer"
            type    label
            nolabel
            joinnext
            default { "" }
            parmtag { "autoscope" "0000000000000000" }
        }
        parm {
            name    "quicksetup3"
            label   " "
            type    ordinal
            default { "menu" }
            menu {
                "menu"          "Quick Setups	↓"
                "buildcop2net"  "Sample Compositing Network"
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        groupsimple {
            name    "folder0"
            label   "Background"
            grouptag { "group_type" "simple" }
            grouptag { "visibletabs" "1" }

            parm {
                name    "primpath"
                label   "Rendersettings Primitive Path"
                type    string
                default { "/Render/rendersettings" }
                help    "The prim path of a USD Render Settings prim to use to set up the background and matte settings. The default is /Render/rendersettings, which is the default for where the Karma render node looks for render settings. If this prim doesn’t already exist in the incoming stage, this node will create it."
                menureplace {
                    [ "opmenu -l -a backgroundplate primpath" ]
                }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_action" "import loputils\nloputils.selectPrimsInParm(kwargs, False)" }
                parmtag { "script_action_help" "Select a primitive in the Scene Viewer or Scene Graph Tree pane.\nCtrl-click to select using the primitive picker dialog.\nAlt-click to toggle movement of the display flag." }
                parmtag { "script_action_icon" "BUTTONS_reselect" }
                parmtag { "sidefx::usdpathtype" "prim" }
            }
            parm {
                name    "plate"
                label   "Plate"
                type    image
                default { "" }
                help    "The file path of the background image to use. "
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "filechooser_mode" "read" }
                parmtag { "parmvop" "1" }
                parmtag { "shaderparmcontexts" "surface" }
            }
            parm {
                name    "s"
                label   "Scale"
                type    vector2
                size    2
                default { "1" "1" }
                help    " Horizontal and vertical scaling factors for the background image. These are normalized relative to the rendered image size, so for example a horizontal scale of 1 is the width of the rendered image."
                range   { 0 2 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "t"
                label   "Translate"
                type    vector2
                size    2
                default { "0" "0" }
                help    "Horziontal and vertical offsets for the background image. These are normalized relative to the rendered images size, so for example a horizontal offset of 0.25 moves the background image to the right 1/4 of the width of the rendered image."
                range   { -1! 1! }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "useoffscreentex"
                label   "Use Offscreen Texture"
                type    toggle
                default { "off" }
                help    "If the background plate does not perfectly cover the camera view, the “real” background (empty space) will show through. Use this to replace empty space with a texture. If you leave this off, the node will fill empty space with the Offscreen color instead."
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "parmvop" "1" }
                parmtag { "shaderparmcontexts" "surface" }
            }
            parm {
                name    "offscreentex"
                label   "Offscreen Texture"
                type    image
                default { "" }
                help    "When Use offscreen texture is on, the file path of the texture image to use to cover empty space."
                disablewhen "{ useoffscreentex == 0 }"
                hidewhen "{ useoffscreentex == 0 }"
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "filechooser_mode" "read" }
                parmtag { "parmvop" "1" }
                parmtag { "shaderparmcontexts" "surface" }
            }
            parm {
                name    "offscreentex_rotate"
                label   "Rotate"
                type    vector
                size    3
                default { "0" "0" "0" }
                help    "When Use offscreen texture is on, this sets the rotation of the offscreen texture in 3D space."
                disablewhen "{ useoffscreentex == 0 }"
                hidewhen "{ useoffscreentex == 0 }"
                range   { 0 10 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "parmvop" "1" }
                parmtag { "shaderparmcontexts" "surface" }
            }
            parm {
                name    "offscreen_col"
                label   "Offscreen Color"
                type    color
                size    3
                default { "0" "0" "0" }
                help    "When Use offscreen texture is off, the color to use for any “empty space” if the background plate does not fully cover the camera view."
                disablewhen "{ useoffscreentex == 1 }"
                hidewhen "{ useoffscreentex == 1 }"
                range   { 0 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "parmvop" "1" }
                parmtag { "shaderparmcontexts" "surface" }
            }
            parm {
                name    "labelparm"
                label   "Shader Parameters"
                type    label
                default { "Shader Parameters" }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "metallic"
                label   "Metallic"
                type    float
                default { "0" }
                help    "Values closer to 1 give the shader a more metallic appearance."
                disablewhen "{ reflection == 0 }"
                range   { 0! 1! }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "reflect"
                label   "Reflectivity"
                type    float
                default { "1" }
                help    "Controls the reflectivity of surfaces facing the viewer. This is also affected by the Index of Refraction."
                disablewhen "{ reflection == 0 }"
                range   { 0! 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "rough"
                label   "Roughness"
                type    float
                default { "0.3" }
                help    "Controls how dull a surface appears. A value of 0.0 results in a smooth surface with perfectly sharp reflections. A value of 1.0 produces a completely dull surface."
                disablewhen "{ reflection == 0 }"
                range   { 0! 1! }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "parmvop" "1" }
            }
            parm {
                name    "ior"
                label   "IOR"
                type    float
                default { "1.5" }
                help    "Higher values reflect more light and bend refraction rays more."
                disablewhen "{ reflection == 0 }"
                range   { 1 3 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "parmvop" "1" }
            }
        }

        groupsimple {
            name    "outputs"
            label   "Holdout AOVs"
            grouptag { "group_type" "simple" }
            grouptag { "visibletabs" "1" }

            parm {
                name    "shadows"
                label   "Shadows"
                type    ordinal
                default { "0" }
                help    "Whether to record all holdout shadows in a single AOV, or generate a separate AOV for each light LPE tag."
                menu {
                    "0" "Combined"
                    "1" "Per LPE Tag"
                }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "diffuse"
                label   "Diffuse"
                type    toggle
                default { "on" }
                help    "Generate an AOV for diffuse bounces on holdout objects. "
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "emission"
                label   "Emission"
                type    toggle
                default { "off" }
                help    "Generate an AOV for light emissions on holdout objects. "
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "reflection"
                label   "Glossy Reflection"
                type    toggle
                default { "off" }
                help    "Generate an AOV for glossy reflections on holdout objects. When disabled, the background shader will become diffuse only, reflectivity and metallic shader parameters will be set to 0."
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "reflectionocclusion"
                label   "Reflection Occlusion"
                type    ordinal
                default { "0" }
                help    "When Glossy Reflection is enabled, whether to record all holdout reflection occlusion in a single AOV, or generate a separate AOV for each light LPE tag."
                disablewhen "{ reflection == 0 }"
                menu {
                    "0" "Combined"
                    "1" "Per LPE Tag"
                }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

    }

}
