{
    channel oracle_minsamples {
      lefttype = extend
      righttype = extend
      default = 3
      flags = 0
      segment { length = 0 value = 3 3 expr = ch(\"../oracle_minsamples\") }
    }
    channel tonemapcurve1value {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = "primuv(\"sopnet/tonemap_curve\", 0, \"P\", 1, ch(\"tonemapcurve1pos\"), 0)" }
