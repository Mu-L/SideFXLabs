--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/create_synth_attr.spareparmdef"
Content-Type: text/plain

    group {
        name    "folder1"
        label   "Code"

        parm {
            name    "group"
            baseparm
            label   "Group"
            export  none
            bindselector uvselect "Modify Attribs"
                "Select the geometry to affect and press Enter to complete."
                0 1 0xffffffff 0 grouptype 0
        }
        parm {
            name    "grouptype"
            baseparm
            label   "Group Type"
            export  none
        }
        parm {
            name    "class"
            baseparm
            label   "Run Over"
            export  none
        }
        parm {
            name    "vex_numcount"
            baseparm
            label   "Number Count"
            export  none
        }
        parm {
            name    "vex_threadjobsize"
            baseparm
            label   "Thread Job Size"
            export  none
        }
        groupsimple {
            name    "folder_generatedparms_snippet"
            label   "Generated Channel Parameters"
            grouptag { "sidefx::look" "blank" }

            parm {
                name    "attr_name"
                label   "Attr Name"
                type    string
                default { "" }
            }
        }

        parm {
            name    "snippet"
            baseparm
            label   "VEXpression"
            export  all
        }
        parm {
            name    "exportlist"
            baseparm
            label   "Attributes to Create"
            export  none
        }
        parm {
            name    "vex_strict"
            baseparm
            label   "Enforce Prototypes"
            export  none
        }
    }

    group {
        name    "folder1_1"
        label   "Bindings"

        parm {
            name    "autobind"
            baseparm
            label   "Autobind by Name"
            export  none
        }
        multiparm {
            name    "bindings"
            label    "Number of Bindings"
            baseparm
            default 0
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "multistartoffset" "1" }

            parm {
                name    "bindname#"
                baseparm
                label   "Attribute Name"
                export  none
            }
            parm {
                name    "bindparm#"
                baseparm
                label   "VEX Parameter"
                export  none
            }
        }

        parm {
            name    "groupautobind"
            baseparm
            label   "Autobind Groups by Name"
            export  none
        }
        multiparm {
            name    "groupbindings"
            label    "Group Bindings"
            baseparm
            default 0
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "multistartoffset" "1" }

            parm {
                name    "bindgroupname#"
                baseparm
                label   "Group Name"
                export  none
            }
            parm {
                name    "bindgroupparm#"
                baseparm
                label   "VEX Parameter"
                export  none
            }
        }

        parm {
            name    "vex_cwdpath"
            baseparm
            label   "Evaluation Node Path"
            export  none
        }
        parm {
            name    "vex_outputmask"
            baseparm
            label   "Export Parameters"
            export  none
        }
        parm {
            name    "vex_updatenmls"
            baseparm
            label   "Update Normals If Displaced"
            export  none
        }
        parm {
            name    "vex_matchattrib"
            baseparm
            label   "Attribute to Match"
            export  none
        }
        parm {
            name    "vex_inplace"
            baseparm
            label   "Compute Results In Place"
            export  none
        }
        parm {
            name    "vex_selectiongroup"
            baseparm
            label   "Output Selection Group"
            export  none
        }
        parm {
            name    "vex_precision"
            baseparm
            label   "VEX Precision"
            export  none
        }
    }


--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/create_synth_attr.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"string svalue;
string input_string = chs('attr_name');
string attr_names[] = split(input_string, \" \"); // Use chsplist to get a list of attribute names

int class = chi('class');

foreach (string attr_name; attr_names) // Loop through each attribute name
{
    int attr_type = attribtype(0, \"point\", attr_name);
    i@attr_type = attr_type;
    
    // integer attribute
    if(attr_type == 0)
    {
        int value = attrib(0, \"point\", attr_name, @ptnum); 
        svalue = sprintf(\"%g\", value);   
    }

    // float attribute
    else if(attr_type == 1)
    {
        float value[] = attrib(0, \"point\", attr_name, @ptnum);   
        svalue = sprintf(\"%g\", value);  
    }
        
    // string attribute
    else if(attr_type == 2)
    {
        string value = attrib(0, \"point\", attr_name, @ptnum);   
        svalue = \"'\" + value + \"'\";
    }

    // integer array attribute
    else if(attr_type == 3)
    {
        int value[] = attrib(0, \"point\", attr_name, @ptnum);
        svalue = sprintf(\"%g\", value); 
    }

    // float array attribute
    else if(attr_type == 4)
    {
        float value[] = attrib(0, \"point\", attr_name, @ptnum);
        svalue = sprintf(\"%g\", value); 
    }

    // string array attribute
    else if(attr_type == 5)
    {
        string value[] = attrib(0, \"point\", attr_name, @ptnum);
        string new_array[] = {};
        // format string values properly
        foreach(string val; value) {
            string new_val = \"'\" + val + \"'\";
            append(new_array, new_val);
        }            
        svalue = sprintf(\"%g\", new_array); 
    }

    // string dictionary attribute
    else if(attr_type == 6)
    {
        dict value = attrib(0, \"point\", attr_name, @ptnum);
        svalue = sprintf(\"%g\", value); 
    }

    // catch unsupported attribute types
    else
    {
        error('The attribute \"%s\" is an unsupported type', attr_name);
    }

    // Assign to the new attribute for each attr_name
    addpointattrib(0, 'synth_' + attr_name, '');
    setpointattrib(0, 'synth_' + attr_name, @ptnum, \"[\" + itoa(attr_type) + \",\" + svalue + \"]\", 'set');
}"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
attr_name	[ 8	locks=0	autoscope=1	autosel=4294967295 ]	(	`chs(\"../attrname\")`	)
}

