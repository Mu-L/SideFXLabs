import soptoolutils
import os
import fnmatch

def setViewFlag(node):
    node.setOutputForViewFlag(-1)
    
def get_all_files(dir, recursive):
    file_list = []
    for root, _, files in os.walk(dir):
            for file in files:
                file_path = os.path.join(root, file)
                file_list.append(file_path)
            if not recursive: break            
    return file_list

def initVariants(kwargs , mode):
    node = kwargs['node']
    autofillmode = node.parm(mode).eval()
    nvariants = 0
    all_filtered_files = []
    if autofillmode == 0:
        dir = node.parm('variantsdir').eval()
        pattern = node.parm('pattern').eval()
        splitpattern = pattern.split()
        recursive = 0
        recursive = node.parm('recursive').eval()
        all_files = get_all_files(dir, recursive)
        ##filtered_files = list(filter(lambda i : hou.hscriptExpression('strmatch("%s", "%s")' % (pattern, i)), all_files))  
        for string in splitpattern:
            filtered_files = fnmatch.filter(all_files, string)
            for file in filtered_files:
                if file not in all_filtered_files:
                    all_filtered_files.append(file)
        nvariants = len(all_filtered_files)
        node.parm('variants').set(nvariants)
        for i in range(nvariants):
            parmname = 'filemeshvariant' + '%d' % (i+1)
            reftypeparmname = 'reftype' + '%d' % (i+1)
            node.parm(reftypeparmname).set(0)
            node.parm(parmname).set(str(all_filtered_files[i]))
    ## from merge path
    elif autofillmode == 1:
        mergepath = node.parm('variantsmergepath').eval()
        mergenode = hou.node(mergepath)
        nvariants = len(mergenode.inputs())
        node.parm('variants').set(nvariants)
        for i in range(nvariants):
            parmname = 'meshvariant' + '%d' % (i+1)
            reftypeparmname = 'reftype' + '%d' % (i+1)
            node.parm(reftypeparmname).set(1)
            node.parm(parmname).set(str(mergenode.inputs()[i].path()))
     
    autofillradii = node.parm('autofillradii').eval()
    if autofillradii == 1:
        calculateBounds(kwargs)
    changeAllNames(kwargs)
    
def calculateBounds(kwargs):
    node = kwargs['node']
    nvariants = node.parm('variants').eval()
    for i in range(nvariants):
        radiusparmname = 'radius' + '%d' % (i+1)
        trunkradiusparmname = 'trunkradius' + '%d' % (i+1)
        filemeshparmname = 'filemeshvariant' + '%d' % (i+1)
        meshparmname = 'meshvariant' + '%d' % (i+1)
        reftypeparmname = 'reftype' + '%d' % (i+1)
        filenode = node.node("editable_file")
        boundsnode = node.node("file_bounds")
        clipnode = node.node("trunk_bounds")
        if node.parm(reftypeparmname).eval() == 0:
            path = node.parm(filemeshparmname).eval()
        else:
            objpath = node.parm(meshparmname).eval()
            path = "op:" + hou.node(objpath).path()
        filenode.parm("file").set(path)
        
        #set radius by file node bounds 
        boundsgeo = boundsnode.geometry()
        bbox = boundsgeo.boundingBox()
        size = bbox.sizevec()
        maxsize = max(size[0], size[2]);
        node.parm(radiusparmname).set(maxsize / 2.0)
        
        #set trunk radius by clip node bounds 
        boundsgeo = clipnode.geometry()
        bbox = boundsgeo.boundingBox()
        size = bbox.sizevec()
        maxsize = max(size[0], size[2]);
        node.parm(trunkradiusparmname).set(maxsize / 2.0)
        

def changeName(kwargs, parm):
    node = kwargs['node']

    meshvariantnode = parm.evalAsNode()
    meshpath = ""
    if meshvariantnode:
        meshpath = meshvariantnode.path()
    parmname = parm.name()
    
    if 'filemeshdead' in parmname:
        i = parmname.replace('filemeshdeadvariant', "")
    elif 'filemesh' in parmname:
        i = parmname.replace('filemeshvariant', "")
    elif 'meshdead' in parmname:
        i = parmname.replace('meshdeadvariant', "")
    else:
        i = parmname.replace('meshvariant', "")
    
    if 'dead' in parmname:
        nameparm = node.parm('deadname' + i)
    else:
        nameparm = node.parm('name' + i)

        
    setname = node.parm('setname' + i).evalAsInt()
    
    if setname:
        meshpathnode = node.node("editable_meshpath")
        namenode = node.node("Get_Name")
        
        meshpathnode.parm("meshpath").set(meshpath)
        if namenode:
            geo = namenode.geometry()
            usdname = ""
            if geo.prims() and geo.findPrimAttrib("name"):
                prim = geo.prims()[0]
                usdname = geo.prims()[0].attribValue("name")
            nameparm.set(usdname)
                
                 
def changeNames(kwargs, parm):
    node = kwargs['node']
    parmname = parm.name()
    removedwords = parmname.replace('setname', "")
    removedwords = removedwords.replace('reftype', "")
    i = removedwords
    if node.parm('reftype' + i).evalAsInt() == 0:
        meshvariantparm = node.parm('filemeshvariant' + i)
        deadmeshvariantparm = node.parm('filemeshdeadvariant' + i)
    else:
        meshvariantparm = node.parm('meshvariant' + i)
        deadmeshvariantparm = node.parm('meshdeadvariant' + i)
    
    changeName(kwargs, meshvariantparm)
    changeName(kwargs, deadmeshvariantparm)
    
def changeAllNames(kwargs):
    node = kwargs['node']
    nvariants = node.parm('variants').eval()
    for i in range(nvariants):
        reftypeparmname = 'reftype' + '%d' % (i+1)
        reftypeparm = node.parm(reftypeparmname)
        changeNames(kwargs, reftypeparm)
    
