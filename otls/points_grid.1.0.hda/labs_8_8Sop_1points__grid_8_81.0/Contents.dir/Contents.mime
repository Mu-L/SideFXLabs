{
    channel unisize {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../unisize\") }
    }
    channel pointsx {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../pointsx\") }
    }
    channel pointsy {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../pointsy\") }
    }
    channel pointsz {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../pointsz\") }
    }
    channel sizex {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../sizex\") }
    }
    channel sizey {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../sizey\") }
    }
    channel sizez {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../sizez\") }
    }
    channel useuniformsize {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../useuniformsize\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/position_points.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"int useuniformsize = chi(\"useuniformsize\");

float unisize = chf(\"unisize\");
float sizex = chf(\"sizex\");
float sizey = chf(\"sizey\");
float sizez = chf(\"sizez\");

int npx = chi(\"pointsx\");
int npy = chi(\"pointsy\");
int npz = chi(\"pointsz\");

vector size;
if (useuniformsize) {
    size = set(unisize, unisize, unisize);
} else {
    size = set(sizex, sizey, sizez);
}

int idx = @ptnum;

// Linear index -> 3D grid coordinate
int i = idx % npx;
int j = (idx / npx) % npy;
int k = idx / (npx * npy);

// Normalized position in [0,1] per axis
float fx = (npx > 1) ? (float)i / (npx - 1) : 0.5;
float fy = (npy > 1) ? (float)j / (npy - 1) : 0.5;
float fz = (npz > 1) ? (float)k / (npz - 1) : 0.5;

vector f = set(fx, fy, fz);
@P = f * size - size * 0.5;"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
useuniformsize	[ 8	locks=0 ]	(	[ useuniformsize	0 ] 	)
unisize	[ 8	locks=0 ]	(	[ unisize	0 ] 	)
sizex	[ 8	locks=0 ]	(	[ sizex	0 ] 	)
sizey	[ 8	locks=0 ]	(	[ sizey	0 ] 	)
sizez	[ 8	locks=0 ]	(	[ sizez	0 ] 	)
pointsx	[ 8	locks=0 ]	(	[ pointsx	0 ] 	)
pointsy	[ 8	locks=0 ]	(	[ pointsy	0 ] 	)
pointsz	[ 8	locks=0 ]	(	[ pointsz	0 ] 	)
}

