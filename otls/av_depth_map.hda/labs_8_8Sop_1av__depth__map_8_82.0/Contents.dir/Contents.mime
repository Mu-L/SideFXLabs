    parm {
        name    "cook"
        baseparm
        label   "Cook"
        joinnext
        export  none
    }
    parm {
        name    "manual_mode"
        baseparm
        label   "Manual"
        joinnext
        export  none
    }
    parm {
        name    "bExportLog"
        baseparm
        label   "Use Log"
        export  none
    }
    group {
        name    "folder3"
        label   "Depth Map"
        grouptag { "sidefx::switcher" "folder0" }

        parm {
            name    "down"
            baseparm
            label   "Downscale"
            export  none
        }
        groupcollapsible {
            name    "folder4"
            label   "Advanced"
            grouptag { "sidefx::switcher" "folder1" }

            parm {
                name    "sNumCam"
                baseparm
                label   "SGM: Num Neighbor Cameras"
                export  none
            }
            parm {
                name    "sWSH"
                baseparm
                label   "SGM: WSH"
                export  none
            }
            parm {
                name    "sGamC"
                baseparm
                label   "SGM: GammaC"
                export  none
            }
            parm {
                name    "sGamP"
                baseparm
                label   "SGM: GammaP"
                export  none
            }
            parm {
                name    "rNumSamp"
                baseparm
                label   "Refine: Num of Samples"
                export  none
            }
            parm {
                name    "rNumDepth"
                baseparm
                label   "Refine: Num of Depths"
                export  none
            }
            parm {
                name    "rNumIter"
                baseparm
                label   "Refine: Num of Iterations"
                export  none
            }
            parm {
                name    "rWSH"
                baseparm
                label   "Refine: WSH"
                export  none
            }
            parm {
                name    "rNumCam"
                baseparm
                label   "Refine: Num Neighbor Cameras"
                export  none
            }
            parm {
                name    "rSigma"
                baseparm
                label   "Refine: Sigma"
                export  none
            }
            parm {
                name    "rGamC"
                baseparm
                label   "Refine: GammaC"
                export  none
            }
            parm {
                name    "rGamP"
                baseparm
                label   "Refine: GammaP"
                export  none
            }
            parm {
                name    "rTcRc"
                baseparm
                label   "Refine: Tc or Rc Pixel Size"
                export  none
            }
            parm {
                name    "minViewAngle"
                baseparm
                label   "Min View Angle"
                export  none
            }
            parm {
                name    "maxViewAngle"
                baseparm
                label   "Max View Angle"
                export  none
            }
            parm {
                name    "nbGPUs"
                baseparm
                label   "Number of GPUs"
                export  none
            }
        }

    }

    group {
        name    "folder3_1"
        label   "Depth Map Filter"

        groupcollapsible {
            name    "folder5"
            label   "Advanced"
            grouptag { "sidefx::switcher" "folder2" }

            parm {
                name    "numCam"
                baseparm
                label   "Number of Nearest Cameras"
                export  none
            }
            parm {
                name    "minCon"
                baseparm
                label   "Min Consistent Cameras"
                export  none
            }
            parm {
                name    "minConBad"
