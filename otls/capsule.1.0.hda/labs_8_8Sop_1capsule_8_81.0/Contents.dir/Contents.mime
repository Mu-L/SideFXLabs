Content-Disposition: attachment; filename="hdaroot/sphere.chn"
Content-Type: text/plain

{
    channel cols {
      lefttype = extend
      righttype = extend
      default = 24
      flags = 0
      segment { length = 0 value = 24 24 expr = ch(\"../sides\") }
    }
    channel scale {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../radius\") }
    }
    channel rows {
      lefttype = extend
      righttype = extend
      default = 13
      flags = 0
      segment { length = 0 value = 13 13 expr = "(ch(\"../capsegments\") * 2) + 1" }
    }
    channel orient {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../direction\") }
    }
  }

