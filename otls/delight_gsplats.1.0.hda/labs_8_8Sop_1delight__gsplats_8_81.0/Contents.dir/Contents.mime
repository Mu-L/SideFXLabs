--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/attribwrangle1.chn"
Content-Type: text/plain

{
    channel light_blur_radius {
      lefttype = extend
      righttype = extend
      default = 0.050000000000000003
      flags = 0
      segment { length = 0 value = 0.050000000000000003 0.050000000000000003 expr = ch(\"../lightblurradius\") }
    }
    channel max_blur_points {
      lefttype = extend
      righttype = extend
      default = 64
      flags = 0
      segment { length = 0 value = 64 64 expr = ch(\"../maxblurpoints\") }
    }
    channel delight_amount {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../delightamount\") }
    }
    channel crevice_shadow_lift {
      lefttype = extend
      righttype = extend
      default = 0.5
      flags = 0
      segment { length = 0 value = 0.5 0.5 expr = ch(\"../creviceshadowlift\") }
    }
    channel exposure {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../exposure\") }
    }
    channel saturation {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../saturation\") }
    }
    channel alpha_weighting {
      lefttype = extend
      righttype = extend
      default = 0.5
      flags = 0
      segment { length = 0 value = 0.5 0.5 expr = ch(\"../alphaweighting\") }
    }
    channel scale_influence {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../scaleinfluence\") }
    }
    channel spatial_falloff_sigma {
      lefttype = extend
      righttype = extend
      default = 0.5
      flags = 0
      segment { length = 0 value = 0.5 0.5 expr = ch(\"../spatialfalloffsigma\") }
    }
    channel edge_preservation_sigma {
      lefttype = extend
      righttype = extend
      default = 0.5
      flags = 0
      segment { length = 0 value = 0.5 0.5 expr = ch(\"../edgepreservationsigma\") }
    }
    channel ao_amount {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../aoamount\") }
    }
    channel ao_radius {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../aoradius\") }
    }
    channel white_balancex {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../whitebalancer\") }
    }
    channel white_balancey {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../whitebalanceg\") }
    }
    channel white_balancez {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../whitebalanceb\") }
    }
    channel light_color_preservation {
      lefttype = extend
      righttype = extend
      default = 0.29999999999999999
      flags = 0
      segment { length = 0 value = 0.29999999999999999 0.29999999999999999 expr = ch(\"../lightcolorpreservation\") }
    }
    channel gamma {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../gamma\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/attribwrangle1.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"float filter_radius            = chf(\"light_blur_radius\");
int max_points                 = chi(\"max_blur_points\");
float delight_blend            = chf(\"delight_amount\");
float shadow_lift              = chf(\"crevice_shadow_lift\");
float exposure                 = chf(\"exposure\");
float gamma                    = chf(\"gamma\");
float saturation               = chf(\"saturation\");
float alpha_weighting          = chf(\"alpha_weighting\");
float scale_influence          = chf(\"scale_influence\");
vector white_balance           = chv(\"white_balance\");
float light_color_preservation = chf(\"light_color_preservation\");
float spatial_sigma            = chf(\"spatial_falloff_sigma\");
float color_sigma              = chf(\"edge_preservation_sigma\");
float ao_amount                = chf(\"ao_amount\");
float ao_radius                = chf(\"ao_radius\");
float target_luma              = 0.18;

float avg_splat_scale = (v@scale.x + v@scale.y + v@scale.z) / 3;
float adaptive_radius = filter_radius * lerp(1.0, avg_splat_scale * 10, scale_influence);
float adaptive_ao_radius = adaptive_radius * max(ao_radius, 0.001);

vector luma_weights = set(0.2126, 0.7152, 0.0722);
float self_luma = dot(v@Cd, luma_weights);

int handle = pcopen(0, \"P\", @P, adaptive_radius, max_points);
vector blurred_color_sum = vector(0);
float total_weight = 0;
float max_luma = 0;
int count = 0;
float spatial_denom = 2 * pow(max(spatial_sigma, 0.001), 2);
float color_denom   = 2 * pow(max(color_sigma, 0.001), 2);

while (pciterate(handle))
{
    vector neighbor_pos;
    vector neighbor_color;
    float neighbor_alpha;
    vector neighbor_scale;

    pcimport(handle, \"P\", neighbor_pos);
    pcimport(handle, \"Cd\", neighbor_color);
    pcimport(handle, \"GS_Alpha\", neighbor_alpha);
    pcimport(handle, \"scale\", neighbor_scale);

    float geo_dist = distance(@P, neighbor_pos);
    float spatial_weight = exp(-pow(geo_dist, 2) / spatial_denom);
    float neighbor_luma = dot(neighbor_color, luma_weights);
    float luma_diff = abs(self_luma - neighbor_luma);
    float range_weight = exp(-pow(luma_diff, 2) / color_denom);
    float avg_neighbor_scale = (neighbor_scale.x + neighbor_scale.y + neighbor_scale.z) / 3;
    float splat_weight = lerp(1, neighbor_alpha * avg_neighbor_scale, alpha_weighting);
    float final_weight = max(spatial_weight * range_weight * splat_weight, 0.0001);

    blurred_color_sum += neighbor_color * final_weight;
    total_weight += final_weight;

    if (neighbor_luma > max_luma) max_luma = neighbor_luma;
    
    count++;
}

vector global_lighting = total_weight > 0 ? blurred_color_sum / total_weight : v@Cd;
max_luma = count > 0 ? max_luma : self_luma;

float light_luma = dot(global_lighting, luma_weights);
vector wb = max(white_balance, {0.001, 0.001, 0.001});
global_lighting /= wb;
float balanced_luma = dot(global_lighting, luma_weights);
global_lighting *= light_luma / max(balanced_luma, 0.001);

float local_occlusion = self_luma / max(max_luma, 0.01);
float micro_correction = lerp(1, local_occlusion, shadow_lift);

int ao_handle = pcopen(0, \"P\", @P, adaptive_ao_radius, max_points);
float ao_sum = 0;
float ao_weight_sum = 0;
float ao_max_luma = 0;
int ao_count = 0;

while (pciterate(ao_handle))
{
    vector neighbor_pos;
    vector neighbor_color;

    pcimport(ao_handle, \"P\", neighbor_pos);
    pcimport(ao_handle, \"Cd\", neighbor_color);

    float dist = distance(@P, neighbor_pos);
    float weight = exp(-pow(dist, 2) / spatial_denom);
    float neighbor_luma = dot(neighbor_color, luma_weights);

    ao_sum += neighbor_luma * weight;
    ao_weight_sum += weight;

    if (neighbor_luma > ao_max_luma) ao_max_luma = neighbor_luma;

    ao_count++;
}

float ao_avg_luma = ao_weight_sum > 0 ? ao_sum / ao_weight_sum : self_luma;
ao_max_luma = ao_count > 0 ? ao_max_luma : self_luma;

float ao_value = clamp(ao_avg_luma / max(ao_max_luma, 0.01), 0, 1);
float ao_factor = lerp(1, ao_value, ao_amount);

vector final_light_map = global_lighting * micro_correction;
final_light_map = max(final_light_map, vector(0.05));

float light_map_luma = dot(final_light_map, luma_weights);
vector neutral_light = set(light_map_luma, light_map_luma, light_map_luma);

vector corrected_light = lerp(neutral_light, final_light_map, light_color_preservation);
corrected_light = max(corrected_light, vector(0.05));

vector delighted_albedo = v@Cd * (target_luma / corrected_light);
delighted_albedo *= ao_factor;

vector final_color = lerp(v@Cd, delighted_albedo, delight_blend);

float exposure_multiplier = pow(2, exposure);
final_color *= exposure_multiplier;

final_color = pow(max(final_color, 0), 1 / max(gamma, 0.001));

float final_luma = dot(final_color, luma_weights);
vector grayscale = set(final_luma, final_luma, final_luma);
final_color = lerp(grayscale, final_color, saturation);

v@albedo = clamp(final_color, 0, 1);
"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
light_blur_radius	[ 0	locks=0 ]	(	[ light_blur_radius	0 ] 	)
max_blur_points	[ 0	locks=0 ]	(	[ max_blur_points	0 ] 	)
delight_amount	[ 0	locks=0 ]	(	[ delight_amount	0 ] 	)
crevice_shadow_lift	[ 0	locks=0 ]	(	[ crevice_shadow_lift	0 ] 	)
exposure	[ 0	locks=0 ]	(	[ exposure	0 ] 	)
gamma	[ 0	locks=0 ]	(	[ gamma	0 ] 	)
saturation	[ 0	locks=0 ]	(	[ saturation	0 ] 	)
alpha_weighting	[ 0	locks=0 ]	(	[ alpha_weighting	0 ] 	)
scale_influence	[ 0	locks=0 ]	(	[ scale_influence	0 ] 	)
spatial_falloff_sigma	[ 0	locks=0 ]	(	[ spatial_falloff_sigma	0 ] 	)
edge_preservation_sigma	[ 0	locks=0 ]	(	[ edge_preservation_sigma	0 ] 	)
white_balance	[ 0	locks=0 ]	(	[ white_balancex	0 ] 	[ white_balancey	0 ] 	[ white_balancez	0 ] 	)
ao_amount	[ 0	locks=0 ]	(	[ ao_amount	0 ] 	)
ao_radius	[ 0	locks=0 ]	(	[ ao_radius	0 ] 	)
light_color_preservation	[ 0	locks=0 ]	(	[ light_color_preservation	0 ] 	)
