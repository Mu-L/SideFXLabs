# Dialog script for labs::path_deform automatically generated

{
    name	labs::path_deform
    script	gamedev::sop_path_deform
    label	"Labs Path Deform"

    help {
	""
    }

    inputlabel	1	"Input Mesh"
    inputlabel	2	"Input Curve"
    inputlabel	3	"Banking Curve (determines up direction) "
    inputlabel	4	End

    groupsimple {
        name    "fd_basesettings"
        label   "Base Settings"
        grouptag { "group_type" "simple" }

        parm {
            name    "axis"
            label   "Axis"
            type    ordinal
            default { "0" }
            menu {
                "0" "+X"
                "1" "+Y"
                "2" "+Z"
                "3" "-X"
                "4" "-Y"
                "5" "-Z"
            }
        }
        parm {
            name    "curve_offset"
            label   "Curve Offset"
            type    float
            default { "0" }
            range   { 0 1 }
        }
        parm {
            name    "curve_resolution"
            label   "Curve Resolution"
            type    float
            default { "0.1" }
            range   { 0 10 }
        }
        parm {
            name    "normal_blur"
            label   "Normal Blur Strength"
            type    integer
            default { "0" }
            range   { 0 10 }
        }
        parm {
            name    "clip_min"
            label   "Clip Bottom End"
            type    toggle
            joinnext
            default { "0" }
        }
        parm {
            name    "clip_max"
            label   "Clip Top End"
            type    toggle
            joinnext
            default { "0" }
        }
        parm {
            name    "collapse"
            label   "Collapse Instead of Clip"
            type    toggle
            default { "1" }
        }
    }

    groupsimple {
        name    "fd_scalecontrols"
        label   "Scale Controls"
        grouptag { "group_type" "simple" }

        parm {
            name    "scale_to_length"
            label   "Scale To Curve Length"
            type    float
            default { "0" }
            range   { 0 1 }
        }
        parm {
            name    "scale"
            label   "Scale"
            type    float
            default { "1" }
            range   { 0 1 }
            parmtag { "autoscope" "0000000000000000" }
        }
        parm {
            name    "scaleramp"
            label   "Scale Ramp"
            type    ramp_flt
            default { "2" }
            range   { 1! 10 }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "rampfloatdefault" "1pos ( 0 ) 1value ( 1 ) 1interp ( linear ) 2pos ( 1 ) 2value ( 1 ) 2interp ( linear )" }
            parmtag { "rampshowcontrolsdefault" "0" }
        }
    }

    groupsimple {
        name    "fd_twistcontrols"
        label   "Twist Controls"
        grouptag { "group_type" "simple" }

        parm {
            name    "twist"
            label   "Twist"
            type    float
            default { "0" }
            range   { 0 100 }
        }
        parm {
            name    "twist_ramp"
            label   "Twist Ramp"
            type    ramp_flt
            default { "2" }
            range   { 1! 10 }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "rampfloatdefault" "1pos ( 0 ) 1value ( 0 ) 1interp ( linear ) 2pos ( 1 ) 2value ( 1 ) 2interp ( linear )" }
            parmtag { "rampshowcontrolsdefault" "0" }
        }
    }

}
