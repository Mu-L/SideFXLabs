distancerange	[ 0	locks=0 ]	(	[ distancerange1	19 ] 	[ distancerange2	20 ] 	)
latitude_min	[ 0	locks=0 ]	(	[ latitude_min	0 ] 	)
latitude_max	[ 0	locks=0 ]	(	[ latitude_max	90 ] 	)
