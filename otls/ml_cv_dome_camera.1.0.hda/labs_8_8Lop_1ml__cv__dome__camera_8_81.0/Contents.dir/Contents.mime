--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/auto_dome/sopnet1/revolve1.chn"
Content-Type: text/plain

{
    channel beginangle {
      lefttype = extend
      righttype = extend
      default = 7
      flags = 0
      segment { length = 0 value = 7 7 expr = -ch(\"../CONTROL1/azi_min\") }
    }
    channel endangle {
      lefttype = extend
      righttype = extend
      default = 46.5
      flags = 0
      segment { length = 0 value = 46.5 46.5 expr = -ch(\"../CONTROL1/azi_max\") }
    }
    channel divs {
      lefttype = extend
      righttype = extend
      default = 5
      flags = 0
      segment { length = 0 value = 5 5 expr = "round(abs(ch(\"endangle\") - ch(\"beginangle\")) / 10)" }
    }
  }

