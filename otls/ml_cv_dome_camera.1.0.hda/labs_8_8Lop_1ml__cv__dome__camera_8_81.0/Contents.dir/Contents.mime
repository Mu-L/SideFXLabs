--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/point_dome_preview/sopnet1/carve1.spareparmdef"
Content-Type: text/plain

    parm {
        name    "group"
        baseparm
        label   "Group"
        export  none
        bindselector prims "Carve Primitives"
            "Select the faces and/or hulls to carve and press Enter to complete."
            0 1 0x000000ff 0 "" 0
    }
    parm {
        name    "firstu"
        baseparm
        label   "First U"
        joinnext
        export  none
    }
    parm {
        name    "domainu1"
        baseparm
        label   "First U"
        export  none
    }
    parm {
        name    "secondu"
        baseparm
        label   "Second U"
        joinnext
        export  none
    }
    parm {
        name    "domainu2"
        baseparm
        label   "Second U"
        export  none
    }
    parm {
        name    "firstv"
        baseparm
        label   "First V"
        joinnext
        export  none
    }
    parm {
        name    "domainv1"
        baseparm
        label   "First V"
        export  none
    }
    parm {
        name    "secondv"
        baseparm
        label   "Second V"
        joinnext
        export  none
    }
    parm {
        name    "domainv2"
        baseparm
        label   "Second V"
        export  none
    }
    groupradio {
        name    "onlybreakpoints3"
        label   "Divisions"

        parm {
            name    "divsu"
            baseparm
            label   "U Divisions"
            export  none
        }
        parm {
            name    "divsv"
            baseparm
            label   "V Divisions"
            export  none
        }
    }

    groupradio {
        name    "onlybreakpoints3_1"
        label   "Breakpoints"
        tabbreak

        parm {
            name    "allubreakpoints"
            baseparm
            label   "Cut At All Internal U Breakpoints"
            export  none
        }
        parm {
            name    "allvbreakpoints"
            baseparm
            label   "Cut At All Internal V Breakpoints"
            export  none
        }
    }

    groupradio {
        name    "stdswitcher3"
        label   "Cut"

        parm {
            name    "keepin"
            baseparm
            label   "Keep Inside"
            export  none
        }
        parm {
            name    "keepout"
            baseparm
            label   "Keep Outside"
            export  none
        }
    }

    groupradio {
        name    "stdswitcher3_1"
        label   "Extract"

        parm {
            name    "extractop"
            baseparm
            label   "Extract Type"
            export  none
        }
        parm {
            name    "keepOriginal"
            baseparm
            label   "Keep Original"
            export  none
        }
    }

    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }
    parm {
        name    "arclen"
        baseparm
        label   "Carve Curves by Relative Arc Length"
        export  none
    }
    parm {
        name    "usedomainu1attrib"
        baseparm
        label   "Use First U Attrib"
        nolabel
        export  none
    }
    parm {
        name    "domainu1attrib"
        baseparm
        label   "First U Attrib"
        export  none
    }
    parm {
        name    "usedomainu2attrib"
        baseparm
        label   "Use Second U Attrib"
        nolabel
        export  none
    }
    parm {
        name    "domainu2attrib"
        baseparm
        label   "Second U Attrib"
        export  none
    }
    parm {
        name    "usedomainv1attrib"
        baseparm
        label   "Use First V Attrib"
        nolabel
        export  none
    }
    parm {
        name    "domainv1attrib"
        baseparm
        label   "First V Attrib"
        export  none
    }
    parm {
        name    "usedomainv2attrib"
        baseparm
        label   "Use Second V Attrib"
        nolabel
        export  none
    }
    parm {
        name    "domainv2attrib"
        baseparm
        label   "Second V Attrib"
        export  none
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/point_dome_preview/sopnet1/carve1.chn"
Content-Type: text/plain

{
    channel domainu1 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "1 - fit(ch(\"../CONTROL/azimuthrange1\"), 0, 360, 0, 1)" }
    }
    channel domainu2 {
      lefttype = extend
      righttype = extend
      default = 0.192
      flags = 0
      segment { length = 0 value = 0.192 0.192 expr = "1 - fit(ch(\"../CONTROL/azimuthrange2\"), 0, 360, 0, 1)" }
    }
    channel domainv1 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "fit(ch(\"../CONTROL/latituderange2\"), -90, 90, 0, 1) * (-1) + 1" }
    }
    channel domainv2 {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = "fit(ch(\"../CONTROL/latituderange1\"), -90, 90, 0, 1) * (-1) + 1" }
    }
  }

