--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/check_if_too_close.spareparmdef"
Content-Type: text/plain

    group {
        name    "fd_general"
        label   "General"

        parm {
            name    "seed"
            label   "Seed"
            type    float
            default { "0" }
            help    "Randomizes the orientation of cameras"
            range   { 0 10 }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "primpath"
            label   "Primitive Path"
            type    string
            default { "/camdome" }
            help    "USD primitive path where the node will generate the cameras"
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "cambasename"
            label   "Camera Base Name"
            type    string
            default { "cam" }
            help    "Base name for the camera object. A number will be appended to this name."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "objcentered"
            label   "Object Centered"
            type    toggle
            default { "0" }
            help    "Disables random camera orientation (default behavior), centering the camera on the object instead"
            parmtag { "script_callback_language" "python" }
        }
    }

    group {
        name    "fd_general_1"
        label   "Advanced"

        parm {
            name    "lb_message"
            label   "Message"
            type    label
            default { "Note:   This node assumes that the point distribution \nwas set up relative to the origin. If your point cloud \nis already set up relative to the location of the focus \nobject please disable \"Transform Point Cloud to Object\"" }
            parmtag { "sidefx::look" "block" }
        }
        parm {
            name    "xformtoobj"
            label   "Transform Point Cloud to Object"
            type    toggle
            default { "0" }
            help    "Transforms the point cloud to the centroid of the focus object. Useful when the point cloud is originally centered around the world origin"
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "padding"
            label   "Padding"
            type    vector2
            size    2
            default { "0" "0" }
            help    "Adds padding rotation (in degrees) to the camera to create a buffer between the focus object and the edge of the camera frustum"
            range   { -1 1 }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "lb_note"
            label   "Note"
            type    label
            default { "Note:   Use \"Frame Minimum\" as a visual reference \nfor setting your frame padding" }
            parmtag { "sidefx::look" "block" }
        }
        parm {
            name    "framemin"
            label   "Frame Minimum"
            type    toggle
            default { "0" }
            help    "Orients the camera so the focus object is toward the bottom left corner. Useful for setting the desired frustum padding."
            parmtag { "script_callback_language" "python" }
        }
    }


--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/check_if_too_close.chn"
Content-Type: text/plain

{
    channel seed {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "if(ch(\"../usewithpdg\")==1, ch(\"../seed_pdg\"), ch(\"../seed\")) + 100" }
    }
    channel objcentered {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../centerobj\") }
    }
    channel paddingx {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../paddingx\") }
    }
    channel paddingy {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../paddingy\") }
    }
    channel framemin {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../frameminimum\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
