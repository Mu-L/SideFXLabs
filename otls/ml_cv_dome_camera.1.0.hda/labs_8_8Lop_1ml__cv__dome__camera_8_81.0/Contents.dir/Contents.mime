--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/auto_dome_preview/sopnet1/CONTROL1.spareparmdef"
Content-Type: text/plain

    parm {
        name    "copyinput"
        baseparm
        label   "Copy Input (Note: Input will be still cooked if disabled)"
        invisible
        export  none
    }
    parm {
        name    "cacheinput"
        baseparm
        label   "Cache Input"
        invisible
        export  none
    }
    parm {
        name    "lat_min"
        label   "Latitude Min"
        type    float
        default { "0" }
        range   { -90! 90! }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "lat_max"
        label   "Latitude Max"
        type    float
        default { "90" }
        range   { -90! 90! }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "azi_min"
        label   "Azimuth Min"
        type    float
        default { "0" }
        range   { 0! 360! }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "azi_max"
        label   "Azimuth Max"
        type    float
        default { "360" }
        range   { 0! 360! }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "dist_min"
        label   "Distance Min"
        type    float
        default { "0" }
        range   { 0! 50 }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "dist_max"
        label   "Distance Max"
        type    float
        default { "20" }
        range   { 0! 50 }
        parmtag { "script_callback_language" "python" }
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/auto_dome_preview/sopnet1/CONTROL1.chn"
Content-Type: text/plain

{
    channel lat_min {
      lefttype = extend
      righttype = extend
      default = 10.199999999999999
      flags = 0
      segment { length = 0 value = 10.199999999999999 10.199999999999999 expr = ch(\"../../../latitude_min\") }
    }
    channel lat_max {
      lefttype = extend
      righttype = extend
      default = 90
      flags = 0
      segment { length = 0 value = 90 90 expr = ch(\"../../../latitude_max\") }
    }
    channel azi_min {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../../../azimuth_min\") }
    }
    channel azi_max {
      lefttype = extend
      righttype = extend
      default = 203
      flags = 0
      segment { length = 0 value = 203 203 expr = ch(\"../../../azimuth_max\") }
    }
    channel dist_min {
      lefttype = extend
      righttype = extend
      default = 28.399999999999999
      flags = 0
      segment { length = 0 value = 28.399999999999999 28.399999999999999 expr = ch(\"../CONTROL/distancerange1\") }
    }
    channel dist_max {
      lefttype = extend
      righttype = extend
      default = 50
      flags = 0
      segment { length = 0 value = 50 50 expr = ch(\"../CONTROL/distancerange2\") }
    }
  }

