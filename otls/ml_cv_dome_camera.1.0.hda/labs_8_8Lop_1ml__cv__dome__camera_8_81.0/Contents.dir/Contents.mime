    }
    channel elev_max {
      lefttype = extend
      righttype = extend
      default = 65.200000000000003
      flags = 0
      segment { length = 0 value = 65.200000000000003 65.200000000000003 expr = ch(\"../CONTROLS/latitude_max\") }
    }
    channel azimuth_min {
      lefttype = extend
      righttype = extend
      default = 205.30000000000001
      flags = 0
      segment { length = 0 value = 205.30000000000001 205.30000000000001 expr = ch(\"../CONTROLS/azimuth_min\") }
    }
