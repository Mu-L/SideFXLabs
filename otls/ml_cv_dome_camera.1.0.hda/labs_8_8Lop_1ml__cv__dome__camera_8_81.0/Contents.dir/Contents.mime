    channel objcentered {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../centerobj\") }
    }
    channel paddingx {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../paddingx\") }
    }
    channel paddingy {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../paddingy\") }
    }
    channel framemin {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../frameminimum\") }
    }
  }

