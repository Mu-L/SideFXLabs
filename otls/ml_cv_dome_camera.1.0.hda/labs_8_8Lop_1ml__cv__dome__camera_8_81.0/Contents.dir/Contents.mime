Content-Disposition: attachment; filename="hdaroot/cameras_from_point_cloud/aim_points/attribcreate2.chn"
Content-Type: text/plain

{
    channel value1v1 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "0.8 + @ptnum" }
    }
    channel value2v1 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../CONTROL/padding1\") }
    }
    channel value2v2 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../CONTROL/padding2\") }
    }
    channel value3v1 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../CONTROL/frameminimum\") }
    }
  }

