cacheinput	[ 0	locks=0 ]	(	"off"	)
lat_min	[ 0	locks=0 ]	(	[ lat_min	0 ] 	)
lat_max	[ 0	locks=0 ]	(	[ lat_max	90 ] 	)
azi_min	[ 0	locks=0 ]	(	[ azi_min	0 ] 	)
azi_max	[ 0	locks=0 ]	(	[ azi_max	360 ] 	)
dist_min	[ 0	locks=0 ]	(	[ dist_min	0 ] 	)
dist_max	[ 0	locks=0 ]	(	[ dist_max	20 ] 	)
}

