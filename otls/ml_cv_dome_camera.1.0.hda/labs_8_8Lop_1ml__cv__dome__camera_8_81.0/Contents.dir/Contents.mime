useareaforvolumes	[ 0	locks=0 ]	(	"off"	)
usedensitytexture	[ 0	locks=0 ]	(	"off"	)
densitytexture	[ 0	locks=0 ]	(	default.pic	)
uvattrib	[ 0	locks=0 ]	(	uv	)
primcountattrib	[ 0	locks=0 ]	(	count	)
useemergencylimit	[ 0	locks=0 ]	(	"on"	)
