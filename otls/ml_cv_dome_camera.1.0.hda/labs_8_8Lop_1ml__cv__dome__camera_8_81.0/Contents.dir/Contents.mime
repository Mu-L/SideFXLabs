Content-Disposition: attachment; filename="hdaroot/cameras_from_point_cloud/aim_points/refine_aim/get_min_max_rotations/get_rotations.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"detail"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"f@bbox_x_min = getbbox_min(1).x;
f@bbox_x_max = getbbox_max(1).x;
f@x_min_rot = (((-1 - getbbox_min(1).y) * f@vFOV) + v@padding.y);
f@x_max_rot = (((1 - getbbox_max(1).y) * f@vFOV) - v@padding.y);
f@y_min_rot = -1*(((-1 - getbbox_min(1).x) * f@hFOV) + v@padding.x);
f@y_max_rot = -1*(((1 - getbbox_max(1).x) * f@hFOV) - v@padding.x);
"	)
exportlist	[ 0	locks=0 ]	(	*	)
