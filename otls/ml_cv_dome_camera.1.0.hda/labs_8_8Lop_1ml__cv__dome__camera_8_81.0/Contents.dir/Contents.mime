    parm {
        name    "chooseinputbyname"
        baseparm
        label   "Choose Input"
        export  none
    }
    parm {
        name    "input"
        baseparm
        label   "Select Input"
        export  all
    }
    parm {
        name    "selectinputname"
        baseparm
        label   "Select Input"
        export  none
    }
    parm {
        name    "selectinputvalue"
        baseparm
        label   "Select Input"
        export  none
    }
    parm {
        name    "config_separator"
        baseparm
        label   "config_separator"
        export  none
    }
    parm {
        name    "badinput"
        baseparm
        label   "Bad Input Response"
        export  none
    }
    parm {
        name    "fallback"
        baseparm
        label   "Fallback Input"
        export  all
    }
    parm {
        name    "selectfallbackname"
        baseparm
        label   "Fallback Input"
        export  none
    }
    parm {
        name    "inputname"
        baseparm
        label   "Input Name Default"
        export  none
    }
    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }

