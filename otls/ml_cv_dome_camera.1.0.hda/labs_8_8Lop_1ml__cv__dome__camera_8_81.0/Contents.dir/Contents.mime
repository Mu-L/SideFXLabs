Content-Disposition: attachment; filename="hdaroot/check_if_too_close/transform_points_to_obj.spareparmdef"
Content-Type: text/plain

    parm {
        name    "xformtoobj"
        label   "Transform to Object"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }

