    parm {
        name    "focusobjprimpath"
        label   "Focus Object Prim Path"
        type    string
        default { "" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "copyinput"
        baseparm
        label   "Copy Input (Note: Input will be still cooked if disabled)"
        invisible
        export  none
    }
    parm {
        name    "cacheinput"
        baseparm
        label   "Cache Input"
        invisible
        export  none
    }
    parm {
        name    "numpts"
        label   "Number of Points"
        type    integer
        default { "0" }
        range   { 0 500 }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "seed"
        label   "Seed"
        type    float
        default { "0" }
        range   { 0 1 }
    }
    parm {
        name    "distancerange"
        label   "Distance Range"
        type    float
        size    2
        default { "0" "0" }
        range   { 0 50 }
    }
    parm {
        name    "latituderange"
        label   "Latitude Range"
        type    float
        size    2
        default { "0" "0" }
        range   { -90! 90! }
    }
    parm {
        name    "azimuthrange"
        label   "Azimuth Range"
        type    float
        size    2
        default { "0" "0" }
        range   { 0! 360! }
    }
    parm {
        name    "maintainobjscreenpct"
        label   "Maintain Object Screen Percentage"
        type    toggle
        default { "off" }
        parmtag { "script_callback_language" "python" }
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/point_dome_preview/sopnet1/CONTROL.chn"
Content-Type: text/plain

{
    channel numpts {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../../numpts\") }
    }
    channel seed {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../../seed\") }
    }
    channel distancerange1 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../../distancerange1\") }
    }
    channel distancerange2 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../../distancerange2\") }
    }
    channel latituderange1 {
      lefttype = extend
      righttype = extend
      default = 0.5
      flags = 0
      segment { length = 0 value = 0.5 0.5 expr = ch(\"../../latitude_min\") }
    }
    channel latituderange2 {
      lefttype = extend
      righttype = extend
      default = 0.65555555555555556
      flags = 0
      segment { length = 0 value = 0.65555555555555556 0.65555555555555556 expr = ch(\"../../latitude_max\") }
    }
    channel azimuthrange1 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../../azimuth_min\") }
    }
    channel azimuthrange2 {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../../azimuth_max\") }
    }
    channel maintainobjscreenpct {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../../objscreenpercentage\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/point_dome_preview/sopnet1/CONTROL.parm"
Content-Type: text/plain

{
version 0.8
copyinput	[ 0	locks=0 ]	(	"on"	)
cacheinput	[ 0	locks=0 ]	(	"off"	)
focusobjprimpath	[ 0	locks=0 ]	(	/cube1	)
numpts	[ 0	locks=0 ]	(	[ numpts	0 ] 	)
seed	[ 0	locks=0 ]	(	[ seed	0 ] 	)
distancerange	[ 0	locks=0 ]	(	[ distancerange1	0 ] 	[ distancerange2	0 ] 	)
latituderange	[ 0	locks=0 ]	(	[ latituderange1	0 ] 	[ latituderange2	0 ] 	)
azimuthrange	[ 0	locks=0 ]	(	[ azimuthrange1	0 ] 	[ azimuthrange2	0 ] 	)
