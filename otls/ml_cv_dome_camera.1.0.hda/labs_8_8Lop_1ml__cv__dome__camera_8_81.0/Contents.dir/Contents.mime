--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/auto_dome.spareparmdef"
Content-Type: text/plain

    parm {
        name    "seed"
        label   "Seed"
        type    float
        default { "0" }
        help    "Randomizes the distribution of cameras"
        range   { 0 1 }
    }
    parm {
        name    "numpts"
        label   "Number of Points"
        type    integer
        default { "50" }
        help    "Specifies the number of points to generate"
        range   { 0 500 }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "distancerange"
        label   "Distance Range"
        type    float
        size    2
        default { "19" "20" }
        help    "Defines the allowable range for the camera's distance from the centroid of the focus object"
        range   { 0 50 }
    }
    parm {
        name    "latitude_min"
        label   "Latitude Min"
        type    float
        default { "0" }
        help    "Defines the allowable range in elevation around the centroid of the focus object."
        range   { -90! 90! }
    }
    parm {
        name    "latitude_max"
        label   "Latitude Max"
        type    float
        default { "90" }
        help    "Defines the allowable range in elevation around the centroid of the focus object."
        range   { -90! 90! }
    }
    parm {
        name    "azimuth_min"
        label   "Azimuth Min"
        type    float
        default { "0" }
        help    "Defines the allowable range of azimuth (which refers to the horizontal angle) around the centroid of the focus object"
        range   { 0! 360! }
    }
    parm {
        name    "azimuth_max"
        label   "Azimuth Max"
        type    float
        default { "360" }
        help    "Defines the allowable range of azimuth (which refers to the horizontal angle) around the centroid of the focus object"
        range   { 0! 360! }
    }
    parm {
        name    "objscreenpercentage"
        label   "Maintain Object Screen Percentage"
        type    toggle
        default { "0" }
        help    "Distributes cameras to achieve an equal distribution of the focus object's screen space size, rather than equalizing the distances between the focus object and the camera. Useful when there is significant variation in camera distance"
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }
    parm {
        name    "spare_input1"
        label   "Spare Input 1"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -2, such as: npoints(-2)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/auto_dome.chn"
Content-Type: text/plain

{
    channel seed {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "if(ch(\"../usewithpdg\")==1, ch(\"../seed_pdg\"), ch(\"../seed\"))" }
    }
    channel distancerange1 {
      lefttype = extend
      righttype = extend
      default = 19
      flags = 0
      segment { length = 0 value = 19 19 expr = "detail(-1,\"min_dist\",0) * 100 / ch(\"../screenpct_max\")" }
    }
    channel distancerange2 {
      lefttype = extend
      righttype = extend
      default = 20
      flags = 0
      segment { length = 0 value = 20 20 expr = "detail(-1,\"min_dist\",0)* 100 / ch(\"../screenpct_min\")" }
    }
    channel latitude_min {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../latitude_min\") }
    }
    channel latitude_max {
      lefttype = extend
      righttype = extend
      default = 90
      flags = 0
      segment { length = 0 value = 90 90 expr = ch(\"../latitude_max\") }
    }
    channel azimuth_min {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../azimuth_min\") }
    }
    channel azimuth_max {
      lefttype = extend
      righttype = extend
      default = 360
      flags = 0
      segment { length = 0 value = 360 360 expr = ch(\"../azimuth_max\") }
    }
    channel objscreenpercentage {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../objscreenpct\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/auto_dome.parm"
Content-Type: text/plain

{
version 0.8
seed	[ 8	locks=0 ]	(	[ seed	0 ] 	)
numpts	[ 0	locks=0 ]	(	1	)
distancerange	[ 8	locks=0 ]	(	[ distancerange1	19 ] 	[ distancerange2	20 ] 	)
latitude_min	[ 8	locks=0 ]	(	[ latitude_min	0 ] 	)
latitude_max	[ 8	locks=0 ]	(	[ latitude_max	90 ] 	)
azimuth_min	[ 8	locks=0 ]	(	[ azimuth_min	0 ] 	)
azimuth_max	[ 8	locks=0 ]	(	[ azimuth_max	360 ] 	)
objscreenpercentage	[ 0	locks=0 ]	(	[ objscreenpercentage	0 ] 	)
spare_input0	[ 0	locks=0 ]	(	../auto_dome_driver/get_min_max_dist	)
spare_input1	[ 0	locks=0 ]	(	../auto_dome_driver	)
}

