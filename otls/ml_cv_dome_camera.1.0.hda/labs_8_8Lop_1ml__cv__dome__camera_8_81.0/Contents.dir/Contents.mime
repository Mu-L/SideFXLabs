    }
    channel sample_f2 {
      lefttype = extend
      righttype = extend
      default = 240
      flags = 0
      segment { length = 0 value = 240 240 expr = @ropend }
    }
    channel sample_f3 {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = @ropinc }
    }
    channel computeextents {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "if(!strcmp(chs(\"size_control\"), \"none\"), 0, 1)" }
    }
  }

