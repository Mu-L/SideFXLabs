version 0.8
fd_general	[ 0	locks=0 ]	(	0	0	)
seed	[ 8	locks=0 ]	(	[ seed	0 ] 	)
primpath	[ 0	locks=0 ]	(	`chs(\"../primpath\")`	)
cambasename	[ 0	locks=0 ]	(	`chs(\"../cambasename\")`	)
objcentered	[ 0	locks=0 ]	(	[ objcentered	0 ] 	)
lb_message	[ 0	locks=0 ]	(	"Note:   This node assumes that the point distribution 
was set up relative to the origin. If your point cloud 
is already set up relative to the location of the focus 
object please disable \"Transform Point Cloud to Object\""	)
xformtoobj	[ 0	locks=0 ]	(	"on"	)
padding	[ 8	locks=0 ]	(	[ paddingx	0 ] 	[ paddingy	0 ] 	)
lb_note	[ 0	locks=0 ]	(	"Note:   Use \"Frame Minimum\" as a visual reference 
for setting your frame padding"	)
framemin	[ 0	locks=0 ]	(	[ framemin	0 ] 	)
}

