--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/auto_dome/sopnet1/unit_arc.chn"
Content-Type: text/plain

{
    channel endangle {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "min(-ch(\"../CONTROL1/lat_min\"), 89.99)" }
    }
    channel beginangle {
      lefttype = extend
      righttype = extend
      default = -90
      flags = 0
      segment { length = 0 value = -90 -90 expr = -ch(\"../CONTROL1/lat_max\") }
    }
    channel divs {
      lefttype = extend
      righttype = extend
      default = 30
      flags = 0
      segment { length = 0 value = 30 30 expr = "round(abs(ch(\"endangle\") - ch(\"beginangle\")) / 10)" }
    }
  }

