      lefttype = extend
      righttype = extend
      default = -8.0999999999999996
      flags = 0
      segment { length = 0 value = -8.0999999999999996 -8.0999999999999996 expr = ch(\"../CONTROLS/latitude_min\") }
    }
    channel elev_max {
      lefttype = extend
      righttype = extend
      default = 65.200000000000003
      flags = 0
      segment { length = 0 value = 65.200000000000003 65.200000000000003 expr = ch(\"../CONTROLS/latitude_max\") }
    }
    channel azimuth_min {
      lefttype = extend
      righttype = extend
      default = 205.30000000000001
      flags = 0
      segment { length = 0 value = 205.30000000000001 205.30000000000001 expr = ch(\"../CONTROLS/azimuth_min\") }
    }
    channel azimuth_max {
      lefttype = extend
      righttype = extend
      default = 309.39999999999998
      flags = 0
      segment { length = 0 value = 309.39999999999998 309.39999999999998 expr = ch(\"../CONTROLS/azimuth_max\") }
    }
    channel seed {
      lefttype = extend
      righttype = extend
      default = 8.4489999999999998
      flags = 0
      segment { length = 0 value = 8.4489999999999998 8.4489999999999998 expr = "ch(\"../CONTROLS/seed\") + 2694" }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/point_dome/sopnet1/point_dome/attribwrangle1.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"float elev_min = chf('elev_min');
float elev_max = chf('elev_max');
float azimuth_min = chf('azimuth_min');
float azimuth_max = chf('azimuth_max');
float seed = chf('seed');

float z_angle = radians(fit01(rand(@ptnum + seed + 346), elev_min, elev_max));
vector z_axis  = {0,0,1}; // axis is a 3 float vector {0.0, 0.0, 0.0}

matrix3 z_mtx = ident();
rotate(z_mtx, z_angle, z_axis);

v@P *= z_mtx;

float y_angle = radians(fit01(rand(@ptnum + seed + 238), azimuth_min, azimuth_max));
vector y_axis  = {0,1,0};

matrix3 y_mtx = ident();
rotate(y_mtx, y_angle, y_axis);

v@P *= y_mtx;
f@pscale = 1.0;"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
elev_min	[ 8	locks=0 ]	(	[ elev_min	0 ] 	)
elev_max	[ 8	locks=0 ]	(	[ elev_max	0 ] 	)
azimuth_min	[ 0	locks=0 ]	(	[ azimuth_min	0 ] 	)
azimuth_max	[ 8	locks=0 ]	(	[ azimuth_max	0 ] 	)
seed	[ 8	locks=0 ]	(	[ seed	0 ] 	)
}

