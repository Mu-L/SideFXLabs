azimuthrange	[ 8	locks=0 ]	(	[ azimuthrange1	0 ] 	[ azimuthrange2	0 ] 	)
maintainobjscreenpct	[ 0	locks=0 ]	(	[ maintainobjscreenpct	0 ] 	)
}

