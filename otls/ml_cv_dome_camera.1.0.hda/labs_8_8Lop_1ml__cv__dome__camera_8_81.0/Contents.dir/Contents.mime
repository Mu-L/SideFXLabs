        type    float
        default { "0" }
        range   { -90! 90! }
    }
    parm {
        name    "latitude_max"
        label   "Latitude Max"
        type    float
        default { "0" }
        range   { -90! 90! }
    }
    parm {
        name    "azimuth_min"
        label   "Azimuth Min"
        type    float
        default { "0" }
        range   { 0! 360! }
    }
    parm {
        name    "azimuth_max"
        label   "Azimuth Max"
        type    float
        default { "0" }
        range   { 0! 360! }
    }
    parm {
        name    "min_dist"
        label   "Distance Min"
        type    float
        default { "0" }
        range   { 0 1 }
    }
    parm {
        name    "max_dist"
        label   "Distance Max"
        type    float
        default { "0" }
        range   { 0 1 }
    }

