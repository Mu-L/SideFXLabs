Content-Type: text/plain

{
version 0.8
type	[ 0	locks=0 ]	(	"poly"	)
surftype	[ 0	locks=0 ]	(	"quads"	)
orient	[ 0	locks=0 ]	(	"xy"	)
size	[ 8	locks=0 ]	(	[ sizex	10 ] 	[ sizey	10 ] 	)
t	[ 8	locks=0 ]	(	0	0	[ tz	0 ] 	)
r	[ 0	locks=0 ]	(	0	0	0	)
rows	[ 0	locks=0 ]	(	2	)
cols	[ 0	locks=0 ]	(	2	)
orderu	[ 0	locks=0 ]	(	4	)
