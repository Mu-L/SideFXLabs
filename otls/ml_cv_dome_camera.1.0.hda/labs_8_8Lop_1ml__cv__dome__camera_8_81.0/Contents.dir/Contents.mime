--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/cameras_from_point_cloud/aim_points/refine_aim.spareparmdef"
Content-Type: text/plain

    parm {
        name    "label1"
        baseparm
        label   "Input #1 Label"
        invisible
        export  all
    }
    parm {
        name    "label2"
        baseparm
        label   "Input #2 Label"
        invisible
        export  all
    }
    parm {
        name    "label3"
        baseparm
        label   "Input #3 Label"
        invisible
        export  all
    }
    parm {
        name    "label4"
        baseparm
        label   "Input #4 Label"
        invisible
        export  all
    }
    parm {
        name    "seed"
        label   "Seed"
        type    float
        default { "0" }
        range   { 0 10 }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "aperture"
        label   "Aperature"
        type    float
        size    2
        default { "0" "0" }
        range   { 0 10 }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "resolution"
        label   "Resolution"
        type    integer
        size    2
        default { "0" "0" }
        range   { 0 10 }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "focallength"
        label   "Focal Length"
        type    float
        default { "0" }
        range   { 0 10 }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "padding"
        label   "Padding"
        type    float
        default { "0" }
        range   { 0 10 }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "callibratepadding"
        label   "Callibrate Padding"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }
    parm {
        name    "spare_input1"
        label   "Spare Input 1"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -2, such as: npoints(-2)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/cameras_from_point_cloud/aim_points/refine_aim.chn"
Content-Type: text/plain

{
    channel aperture1 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "detail(-1, \"horizontalAperture\", 0)" }
    }
    channel aperture2 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "detail(-1, \"verticalAperture\", 0)" }
    }
    channel focallength {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "detail(-1, \"focalLength\", 0)" }
    }
    channel seed {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "detail(-2, \"iteration\", 0) + ch(\"../CONTROL/seed\")" }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
