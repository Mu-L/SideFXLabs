{
    channel seed {
      lefttype = extend
      righttype = extend
      default = 0.248
      flags = 0
      segment { length = 0 value = 0.248 0.248 expr = "ch(\"../CONTROLS/seed\") + 62385" }
    }
    channel min_dist {
      lefttype = extend
      righttype = extend
      default = 8
      flags = 0
      segment { length = 0 value = 8 8 expr = ch(\"../CONTROLS/min_dist\") }
    }
    channel max_dist {
      lefttype = extend
      righttype = extend
      default = 10
      flags = 0
      segment { length = 0 value = 10 10 expr = ch(\"../CONTROLS/max_dist\") }
    }
