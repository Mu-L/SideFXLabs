--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/cameras_from_point_cloud/aim_points/CONTROL.spareparmdef"
Content-Type: text/plain

    parm {
        name    "copyinput"
        baseparm
        label   "Copy Input (Note: Input will be still cooked if disabled)"
        export  none
    }
    parm {
        name    "cacheinput"
        baseparm
        label   "Cache Input"
        export  none
    }
    parm {
        name    "seed"
        label   "Seed"
        type    float
        default { "0" }
        range   { 0 10 }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "padding"
        label   "Padding"
        type    float
        size    2
        default { "0" "0" }
        range   { 0 10 }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "frameminimum"
        label   "Frame Minimum"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "primpath"
        label   "Prim Path"
        type    string
        default { "" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "cambasename"
        label   "Camera Base Name"
        type    string
        default { "" }
        parmtag { "script_callback_language" "python" }
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/cameras_from_point_cloud/aim_points/CONTROL.chn"
Content-Type: text/plain

{
    channel seed {
      lefttype = extend
      righttype = extend
      default = 5
      flags = 0
      segment { length = 0 value = 5 5 expr = "if(ch(\"../../../usewithpdg\")==1, ch(\"../../../seed_pdg\"), ch(\"../../../seed\"))" }
    }
    channel padding1 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../../paddingx\") }
    }
    channel padding2 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../../paddingy\") }
    }
    channel frameminimum {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../../framemin\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/cameras_from_point_cloud/aim_points/CONTROL.parm"
Content-Type: text/plain

{
version 0.8
copyinput	[ 0	locks=0 ]	(	"on"	)
cacheinput	[ 0	locks=0 ]	(	"off"	)
seed	[ 8	locks=0 ]	(	[ seed	0 ] 	)
padding	[ 8	locks=0 ]	(	[ padding1	0 ] 	[ padding2	0 ] 	)
frameminimum	[ 0	locks=0 ]	(	[ frameminimum	0 ] 	)
primpath	[ 0	locks=0 ]	(	`chs(\"../../primpath\")`	)
cambasename	[ 0	locks=0 ]	(	`chs(\"../../cambasename\")`	)
}

