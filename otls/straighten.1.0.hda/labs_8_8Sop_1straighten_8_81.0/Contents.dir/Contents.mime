      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "explodematrix(dihedral(vector3(detail(-1, \"N\", 0), detail(-1, \"N\", 1), detail(-1, \"N\", 2)), vector3(1,0,0)), \"SRT\", \"XYZ\", \"RY\")" }
    }
    channel addattrib {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../outputxform\") }
    }
  }

