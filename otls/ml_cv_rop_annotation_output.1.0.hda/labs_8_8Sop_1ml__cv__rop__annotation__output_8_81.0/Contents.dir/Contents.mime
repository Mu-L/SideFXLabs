Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"vector cameraPos = point(2, \"P\", 0);  // Camera position attribute
vector targetPos = @P;        // Target point position
vector rayDir = targetPos - cameraPos;  // Ray direction

// Raycast to target
vector pos[];
int prim[];
vector uvw[];

int numHits = intersect_all(1, cameraPos, rayDir, pos, prim, uvw, .01, -1);

// Check occlusions
if(numHits > 1)
{
    setpointgroup(0, 'in_frustum', @ptnum, 0, 'set');
}


"	)
exportlist	[ 0	locks=0 ]	(	*	)
