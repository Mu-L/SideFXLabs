import soptoolutils
import os

    
def get_all_files(dir):
    file_list = []
    for root, _, files in os.walk(dir):
            for file in files:
                file_path = os.path.join(root, file)
                file_list.append(file_path)
    return file_list

def initVariants(kwargs , mode):
    node = kwargs['node']
    autofillmode = node.parm(mode).eval()
    
    if autofillmode == 0:
        dir = node.parm('variantsdir').eval()
        contains = node.parm('findfilescontaining').eval()
        all_files = get_all_files(dir)
        filtered_files = list(filter(lambda i : contains in i, all_files))
        
        nvariants = len(filtered_files)
        node.parm('variants').set(nvariants)
        for i in range(nvariants):
