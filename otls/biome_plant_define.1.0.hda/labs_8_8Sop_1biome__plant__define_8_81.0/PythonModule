import soptoolutils
import os
import fnmatch
    
def get_all_files(dir, recursive):
    file_list = []
    for root, _, files in os.walk(dir):
            for file in files:
                file_path = os.path.join(root, file)
                file_list.append(file_path)
            if not recursive: break            
    return file_list

def initVariants(kwargs , mode):
    node = kwargs['node']
    autofillmode = node.parm(mode).eval()
    nvariants = 0
    all_filtered_files = []
    if autofillmode == 0:
        dir = node.parm('variantsdir').eval()
        pattern = node.parm('pattern').eval()
        splitpattern = pattern.split()
        recursive = 0
        recursive = node.parm('recursive').eval()
        all_files = get_all_files(dir, recursive)
        ##filtered_files = list(filter(lambda i : hou.hscriptExpression('strmatch("%s", "%s")' % (pattern, i)), all_files))  
        for string in splitpattern:
            filtered_files = fnmatch.filter(all_files, string)
            for file in filtered_files:
                if file not in all_filtered_files:
                    all_filtered_files.append(file)
        nvariants = len(all_filtered_files)
        node.parm('variants').set(nvariants)
        for i in range(nvariants):
            parmname = 'filemeshvariant' + '%d' % (i+1)
            reftypeparmname = 'reftype' + '%d' % (i+1)
            node.parm(reftypeparmname).set(0)
            node.parm(parmname).set(str(all_filtered_files[i]))
    ## from merge path
    elif autofillmode == 1:
        mergepath = node.parm('variantsmergepath').eval()
        mergenode = hou.node(mergepath)
        nvariants = len(mergenode.inputs())
        node.parm('variants').set(nvariants)
        for i in range(nvariants):
            parmname = 'meshvariant' + '%d' % (i+1)
            reftypeparmname = 'reftype' + '%d' % (i+1)
            node.parm(reftypeparmname).set(1)
            node.parm(parmname).set(str(mergenode.inputs()[i].path()))
    