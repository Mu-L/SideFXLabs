      segment { length = 0 value = -0.50000001490116119 -0.50000001490116119 expr = "centroid(-1, D_X)" }
    }
    channel ty {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "centroid(-1, D_Y)" }
    }
    channel tz {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "centroid(-1, D_Z)" }
    }
  }

