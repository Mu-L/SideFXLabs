--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/volume_name_missing_error.chn"
Content-Type: text/plain

{
    channel enable1 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "strcmp(chs(\"../volname\"), \"\") == 0" }
    }
    channel enable2 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = "# Looks at the primitives in the Object Merge above and checks to see if a 
# volume name exists matching the input volume name on the HDA

node = hou.pwd()
HDAnode = node.parent()
selectedVolume = HDAnode.parm(\"volname\").eval()
inputGeo = node.inputs()[0].geometry()

if selectedVolume:
    for prim in inputGeo.prims():
        if prim.attribValue(\"name\") == selectedVolume:
            return 0
            
        else:
            return 1" language = python }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
