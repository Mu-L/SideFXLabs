snippet	[ 0	locks=0 ]	(	"// Normalizes the image dimensions so that the greatest dimension is 1

vector dimensions = prim(0, \"intrinsic:voxelresolution\", 0);
float dimension_max = max(dimensions.x, dimensions.y); 

dimensions = dimensions / dimension_max;

v@_rfi_dimensions = dimensions;"	)
