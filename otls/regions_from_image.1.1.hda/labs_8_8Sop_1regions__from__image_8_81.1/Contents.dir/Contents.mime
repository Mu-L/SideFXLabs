Content-Type: text/plain

{
version 0.8
numerror	[ 0	locks=0 ]	(	2	)
errormsg1	[ 0	locks=0 ]	(	"Volume Name parameter must have the name of a COP layer to process."	)
severity1	[ 0	locks=0 ]	(	"error"	)
enable1	[ 8	locks=0 ]	(	[ enable1	0 ] 	)
errormsg2	[ 0	locks=0 ]	(	"Selected COP Network volume does not exist."	)
severity2	[ 0	locks=0 ]	(	"error"	)
enable2	[ 8	locks=0 ]	(	[ enable2	0 ] 	)
}

