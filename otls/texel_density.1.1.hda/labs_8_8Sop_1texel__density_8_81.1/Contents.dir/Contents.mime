--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/visualize_texel_density1.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	`chs(\"../group\")`	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"primitive"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"int do_set = chi(\"set_td\"); // 1 if Set Texel Density toggle is on
float asset_td = f@_ted_asset_td;
float target_td = f@_ted_target_td;

// Ratio: 1.0 means perfect match
float ratio = asset_td / max(target_td, 1e-8);

// Normalize into 0–1 for ramp sampling
float max_scale_factor = 2.0; // detail(0, \"_ted_max_scale_factor\", 0);
float t = fit(ratio, 0, max_scale_factor, 0.0, 1.0);
t = clamp(t, 0, 1);

if (do_set)
    t = 0.5;
    
// Apply to color
v@Cd = chramp(\"color_ramp\", t);"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
color_ramp	[ 0	locks=0 ]	(	[ color_ramp	5 ] 	)
color_ramp1pos	[ 0	locks=0 ]	(	[ color_ramp1pos	0 ] 	)
color_ramp1c	[ 0	locks=0 ]	(	[ color_ramp1cr	0 ] 	[ color_ramp1cg	0 ] 	[ color_ramp1cb	0 ] 	)
color_ramp1interp	[ 0	locks=0 ]	(	[ color_ramp1interp	1 ] 	)
set_td	[ 8	locks=0 ]	(	[ set_td	0 ] 	)
color_ramp2pos	[ 0	locks=0 ]	(	[ color_ramp2pos	0 ] 	)
color_ramp2c	[ 0	locks=0 ]	(	[ color_ramp2cr	0 ] 	[ color_ramp2cg	0 ] 	[ color_ramp2cb	0 ] 	)
