    group {
        name    "g1_16"
        label   "OGL"

        parm {
            name    "ogl_amb"
            label   "OGL Ambient"
            type    color
            size    3
            default { "1" "1" "1" }
            range   { 0 1 }
            parmtag { "spare_category" "OGL" }
        }
        parm {
            name    "ogl_diff"
            label   "OGL Diffuse"
            type    color
            size    3
            default { "1" "1" "1" }
            range   { 0 1 }
            parmtag { "spare_category" "OGL" }
        }
        parm {
            name    "ogl_spec"
            label   "OGL Specular"
            type    color
            size    3
            default { "1" "1" "1" }
            range   { 0 1 }
            parmtag { "spare_category" "OGL" }
        }
        parm {
            name    "ogl_rough"
            label   "OGL Roughness"
            type    float
            default { "0.05" }
            range   { 0 1 }
            parmtag { "spare_category" "OGL" }
        }
        parm {
            name    "ogl_alpha"
            label   "OGL Alpha"
            type    float
            default { "1" }
            range   { 0 1 }
            parmtag { "spare_category" "OGL" }
        }
        multiparm {
            name    "ogl_numtex"
            label    "Texture Layers"
            parmtag { "spare_category" "OGL" }

            parm {
                name    "ogl_tex#"
                label   "Texture #"
                type    image
                default { "" }
                range   { 0 1 }
            }
            parm {
                name    "ogl_tex_min_filter#"
                label   "Minification Filter"
                type    string
                default { "GL_LINEAR_MIPMAP_LINEAR" }
                menu {
                    "GL_NEAREST"                "Poor: Nearest"
                    "GL_LINEAR"                 "Poor: Linear"
                    "GL_NEAREST_MIPMAP_NEAREST" "Fastest (Nearest/Nearest)"
                    "GL_LINEAR_MIPMAP_NEAREST"  "Better (Linear/Nearest)"
                    "GL_NEAREST_MIPMAP_LINEAR"  "Good (Nearest/Linear)"
                    "GL_LINEAR_MIPMAP_LINEAR"   "Best (Linear/Linear)"
                }
                range   { 0 1 }
            }
            parm {
                name    "ogl_tex_mag_filter#"
                label   "Magnification Filter"
                type    string
                default { "GL_LINEAR" }
                menu {
                    "GL_NEAREST"    "Nearest"
                    "GL_LINEAR"     "Linear"
                }
                range   { 0 1 }
            }
            parm {
                name    "ogl_clamping_mode#"
                label   "Clamp Texture"
                type    toggle
                default { "0" }
                range   { 0 1 }
            }
        }

    }


--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/enable_uv_grid/shop_definition/texture_material/v_layered1.chn"
Content-Type: text/plain

{
    channel ogl_diffr {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch('Cdr') }
    }
    channel ogl_diffg {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch('Cdg') }
    }
    channel ogl_diffb {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch('Cdb') }
    }
    channel ogl_specr {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch('Csr') }
    }
    channel ogl_specg {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch('Csg') }
    }
    channel ogl_specb {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch('Csb') }
    }
    channel ogl_ambr {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch('Car') }
    }
    channel ogl_ambg {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch('Cag') }
    }
    channel ogl_ambb {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch('Cab') }
    }
    channel ogl_rough {
      lefttype = extend
      righttype = extend
      default = 0.050000000000000003
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch('rough') }
    }
    channel ogl_alpha {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch('aperp') }
    }
  }

