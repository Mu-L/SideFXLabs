Content-Type: text/plain

    parm {
        name    "orient"
        baseparm
        label   "Orientation"
        export  none
    }
    parm {
        name    "sampling"
        baseparm
        label   "Sampling"
        export  none
    }
    parm {
        name    "initialheight"
        baseparm
        label   "Initial Height"
        export  none
    }
    parm {
        name    "initialmask"
        baseparm
        label   "Initial Mask"
        export  none
    }
    parm {
        name    "divisionmode"
        baseparm
        label   "Division Mode"
        export  none
    }
    parm {
        name    "gridspacing"
        baseparm
        label   "Grid Spacing"
        export  none
    }
    parm {
        name    "gridsamples"
        baseparm
        label   "Grid Samples"
        export  none
    }
    parm {
        name    "scale"
        baseparm
        label   "Uniform Scale"
        export  none
    }
    parm {
        name    "size"
        baseparm
        label   "Size"
        export  none
    }
    parm {
        name    "t"
        baseparm
        label   "Center"
        export  none
    }
    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/biome_layer.chn"
Content-Type: text/plain

{
    channel sizex {
      lefttype = extend
      righttype = extend
      default = 1000
      flags = 0
      segment { length = 0 value = 1000 1000 expr = "if(strlen(opinput(\"..\", 1))==0, ch(\"../outputsizex\"), bbox(-1, D_XSIZE))" }
    }
    channel sizey {
      lefttype = extend
      righttype = extend
      default = 1000
      flags = 0
      segment { length = 0 value = 1000 1000 expr = "if(strlen(opinput(\"..\", 1))==0, ch(\"../outputsizey\"), bbox(-1, D_ZSIZE))" }
    }
    channel gridspacing {
      lefttype = extend
      righttype = extend
      default = 2
      flags = 0
      segment { length = 0 value = 2 2 expr = ch(\"../gridspacing\") }
    }
    channel divisionmode {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../divisionmode\") }
    }
  }

