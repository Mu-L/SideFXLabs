--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/create_uv.chn"
Content-Type: text/plain

{
    channel uv_scalex {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "(ch(\"map_resx\") - 1.0) /  ch(\"map_resx\")" }
    }
    channel uv_scaley {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "(ch(\"map_resy\") - 1.0) /  ch(\"map_resy\")" }
    }
    channel map_resx {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "prim(1, 0, \"intrinsic:voxelresolution\", 0)" }
    }
    channel map_resy {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "prim(1, 0, \"intrinsic:voxelresolution\", 1)" }
    }
    channel grid_resx {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "if(ch(\"../switch_sample_res/expr1\"), ch(\"../sample_grid/cols\"), ch(\"../sample_grid_auto/cols\"))" }
    }
    channel grid_resy {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = "if(ch(\"../switch_sample_res/expr1\"), ch(\"../sample_grid/rows\"), ch(\"../sample_grid_auto/rows\"))" }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/create_uv.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"int x = chi(\"grid_resx\");
int y = chi(\"grid_resy\");
int col_idx = @ptnum % x;
int row_idx = @ptnum / x;
@uv.x = col_idx / (x - 1.0);
@uv.y = 1.0 - row_idx / (y - 1.0);
@uv.z = 0;

// Keeps a copy of the normalized UVs for transferring 
// attributes to heightfields later
@uv2 = @uv;

// Uniformly shrinks UVs towards to center to ensure border 
// points will sample the centers of border pixels. This 
// is necessary for seamless tiling, but it should be 
// applied even if seamless tiling is disabled so as to 
// unify the geometry output. Its impact on stand-alone 
// tiles are negligible.

// In theory, when seamless tiling is enabled, to sample 
// point colors, the resolution should be the output texture 
// resolution plus 1; to do material texture mapping, the 
// resolution should just be the output texture resoluion.

// In practice, the computed UV differences between the two 
// are always less than half the width of a texel (as long 
// as the texture width is greater than 2).

// When using Point filter to sample point colors, this 
// leads to no actual differences. With other filters, 
// the differences are imperceptible. Therefore, the plus 1 
// part can always be skipped so that the computed UVs 
// can be used for both point color sampling and 
// material texture mapping.

@uv -= 0.5;
@uv.x *= chf(\"uv_scalex\");
@uv.y *= chf(\"uv_scaley\");
@uv += 0.5;"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
grid_res	[ 8	locks=0 ]	(	[ grid_resx	0 ] 	[ grid_resy	0 ] 	)
map_res	[ 8	locks=0 ]	(	[ map_resx	0 ] 	[ map_resy	0 ] 	)
uv_scale	[ 8	locks=0 ]	(	[ uv_scalex	0 ] 	[ uv_scaley	0 ] 	)
}

