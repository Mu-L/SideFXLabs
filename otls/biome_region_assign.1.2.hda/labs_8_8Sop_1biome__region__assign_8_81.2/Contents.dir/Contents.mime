--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/set_visualization_color_custom.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
bindeach	[ 0	locks=0 ]	(	"off"	)
snippet	[ 0	locks=0 ]	(	"vector color = prim(1, \"Cd\", 0);
int stable_index = prim(1, \"_brga_stable_idx\", 0);
int prim;
vector uv;
float volume_sum = 0;

for(int i = 0; i < nprimitives(1); i++)
{
    float volume_sample = volumesample(1, i, @P);
    if(volume_sample > 0.01)
    {
        v@Cd += chv(\"../img_bcolor\" + itoa(stable_index)) * volume_sample;
        volume_sum += volume_sample;
    }
}
//v@Cd = v@Cd / volume_sum;
f@volume_value = volume_sum;
"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
vex_geometrygenerator	[ 0	locks=0 ]	(	"off"	)
vdb_signedflood	[ 0	locks=0 ]	(	"on"	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
}

