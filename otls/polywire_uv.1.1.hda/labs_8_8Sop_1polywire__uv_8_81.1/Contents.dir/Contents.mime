Content-Disposition: attachment; filename="hdaroot/create_cap_group.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"primitive"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"int vtxs[] = primvertices(0, @primnum);
int c_vtx = vertex(0, \"_pwu_lookup\", vtxs[0]);
int isCap = 1;
int next_c_vtx;

foreach (int vtx; vtxs) {
    next_c_vtx = vertex(0, \"_pwu_lookup\", vtx);
    
    if (next_c_vtx != c_vtx) {
        isCap = 0;
        break;
        }
}

setprimgroup(0, \"_pwu_cap\", @primnum, isCap);"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
