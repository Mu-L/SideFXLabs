      default = 2
      flags = 0
      segment { length = 0 value = 2 2 expr = ch(\"../captureweightbias\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/bind_w.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"float u = vertex(0, \"_pwu_curve_u\", @vtxnum);
int seg_id = prim(0, \"_pwu_id_seg\", @primnum);
int for_pt, back_pt , idx;
float for_weight, back_weight;

int n_vtx = primvertexcount(1, seg_id) - 1;
float f_w = ch(\"bias\");
float u_w = frac(u * float(n_vtx));
float weight = f_w / ( ((1/u_w) - 2) * (1 - f_w) + 1);
float test_w = u * float(n_vtx) %1;
int ns[];
float ws[];

if (test_w == 0.0) {
    idx = int(rint(u * n_vtx));
    for_pt = vertexpoint(1, vertexindex(1, seg_id, idx));
    for_weight = 1-weight;  
    ns = array(for_pt);
    ws = array(1);
}
else {
    idx = int(ceil( u * n_vtx));
    for_pt = vertexpoint(1, vertexindex(1, seg_id, idx));
    for_weight = weight;
    idx = int(floor( u * n_vtx));
    back_pt = vertexpoint(1, vertexindex(1, seg_id, idx));
    back_weight = 1-weight;
    ns = array(back_pt, for_pt);
    ws = array(back_weight, for_weight);
}

i[]@boneCapture_index = ns;
f[]@boneCapture_data = ws;"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
bias	[ 8	locks=0 ]	(	[ bias	0 ] 	)
}

