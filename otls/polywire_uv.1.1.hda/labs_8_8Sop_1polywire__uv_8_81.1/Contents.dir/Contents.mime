vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"int vtxs[] = primvertices(0, @primnum);
int end_vtx = vtxs[-1];
int end_pt = vertexpoint(0, end_vtx);

vtxs = pointvertices(0, end_pt);

foreach (int vtx; vtxs) {
    if (vtx == end_vtx) {
        continue;
    }
    if (vtx < end_vtx) {
        setvertexattrib(0, \"_pwu_split\", end_vtx , -1, end_vtx + 1);
        break;
    }    
}



"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
