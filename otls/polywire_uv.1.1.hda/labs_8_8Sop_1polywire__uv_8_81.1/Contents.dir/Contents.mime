--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/vget_step.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	_pwu_borders	)
grouptype	[ 0	locks=0 ]	(	"vertices"	)
class	[ 0	locks=0 ]	(	"vertex"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"int ave_vtxs[];
float cur_u = f@_pwu_u;
float cur_v = f@_pwu_v;
float test_u, test_v;
int vtxs[];
int test_seg;
int cur_seg = prim(0, \"_pwu_id_seg\", @primnum);

// get all fused vtxs for current vtx.
int vtxs_con[] = pointvertices(0, @ptnum);
int vtxs_fuse[];
foreach (int vtx; vtxs_con) {
    test_v = vertex(0, \"_pwu_v\", vtx);
    test_seg = prim(0, \"_pwu_id_seg\", vertexprim(0, vtx));
    if (test_v == cur_v && cur_seg == test_seg) {
        append(vtxs_fuse, vtx);
    }
}
int hedge = 0;
int v_nxt;
int siblings[] = array(@vtxnum);
int found = 0;
foreach (int vtx; vtxs_fuse) {
    hedge = vertexhedge(0, vtx);
    v_nxt = hedge_dstvertex(0, hedge);
    test_v = vertex(0, \"_pwu_v\", v_nxt);
    if (test_v == cur_v) {
        append(siblings, v_nxt);
        continue;
    }
    hedge = hedge_prev(0, hedge);
    v_nxt = hedge_srcvertex(0, hedge);    
    test_v = vertex(0, \"_pwu_v\", v_nxt);
    if (test_v == cur_v) {
        append(siblings, v_nxt);
    }    
}

i[]@_pwu_siblings = siblings;"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
}

