--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/uv_caps.chn"
Content-Type: text/plain

{
    channel mode {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../uvmode\") }
    }
    channel weld {
      lefttype = extend
      righttype = extend
      default = 0.107
      flags = 0
      segment { length = 0 value = 0.107 0.107 expr = ch(\"../weld\") }
    }
    channel texelScale {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../texelscale\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/uv_caps.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	_pwu_cap	)
grouptype	[ 0	locks=0 ]	(	"prims"	)
class	[ 0	locks=0 ]	(	"vertex"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"float perim, scale;

if (ch(\"mode\") == 2) {
    perim = $PI * 2 * point(0, \"_pwu_width\", @ptnum) * ch(\"texelScale\");
    scale = 0.5 / $PI;
}

else {
    perim = 1;
    scale = 0.5 / $PI;
}

float u = (@uv.x - 0.5) / perim;
float drive_u = (u - 0.5) * $PI * 2;
float xCirc = sin(drive_u) *- scale;
float yCirc = cos(drive_u) * scale;
int dir = (@uv.y == 0) * 2 - 1;
float new_x = ( xCirc * perim)+ 0.5;
float new_y = @uv.y + ((yCirc * perim) + (scale * perim)) * -dir; 
vector new_uv = set(new_x, new_y, @uv.z);

float weld = ch(\"weld\") / i@_pwu_borders;
if (distance(new_uv, @uv) >= weld * perim) {
@uv = new_uv;
}"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
code	[ 0	locks=0 ]	(	0	0	)
weld	[ 8	locks=0 ]	(	[ weld	0 ] 	)
mode	[ 8	locks=0 ]	(	[ mode	0 ] 	)
texelScale	[ 8	locks=0 ]	(	[ texelScale	0 ] 	)
}

