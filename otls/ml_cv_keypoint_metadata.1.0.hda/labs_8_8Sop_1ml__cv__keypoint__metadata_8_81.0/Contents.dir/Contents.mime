snippet	[ 0	locks=0 ]	(	"int count = chi('count');

vector skel_color[];
float skel_weight[];

for(int i=0; i<count; i++){
    vector color = chv('../skelcolor'+itoa(i+1));
    string connection = chs('../connection'+itoa(i+1));
    float weight = chf('../skelweight'+itoa(i+1));
    append(skel_color, color);
    append(skel_weight, weight);
}


v[]@skel_color = skel_color;
f[]@skel_weight = skel_weight;"	)
